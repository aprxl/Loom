(* ============================================================================
   Loom grammar sketch, v0.1
   ----------------------------------------------------------------------------
   Notation: EBNF.  { x } = zero or more, [ x ] = optional, ( a | b ) = choice.
   Terminals are quoted.  UPPER_CASE names are tokens from the lexer.
   The prose in 01-syntax.md wins whenever the two disagree.
   ============================================================================ *)


(* ---------------------------------------------------------------- lexical *)

IDENT        = lower_or_underscore , { letter | digit | "_" } ;   (* values, fns, fields, modules *)
TYPE_IDENT   = upper , { letter | digit | "_" } ;                  (* types, wefts, cases: must contain a
                                                                     lowercase letter, or be one letter (T) *)
CONST_IDENT  = upper , upper_or_digit_or_underscore ,
               { upper_or_digit_or_underscore } ;                  (* MAX_LEN, PI, CRC_TABLE *)
PRIM         = "bool" | "char" | "str" | "never" | "isize" | "usize"
             | ( "i" | "u" ) , DECIMAL        (* i1..i128, u1..u128 *)
             | "f16" | "f32" | "f64" ;

INT          = DECIMAL | "0x" hex_digits | "0o" oct_digits | "0b" bin_digits , [ int_suffix ] ;
FLOAT        = DECIMAL "." DECIMAL [ exponent ] [ "f16" | "f32" | "f64" ] ;
TWILL        = ( "0x" | "0o" | "0b" ) , { digit_of_base | lower | "?" | "_" } ;
               (* A radix literal containing a lowercase non-digit letter or "?" is
                  lexed as TWILL. Only valid in pattern position. In hex twill,
                  lowercase letters are always captures, even a-f. *)
CHAR         = "'" , ( char_escape | any_char_but_quote ) , "'" ;
STRING       = [ "r" | "b" ] , '"' , { str_char | interpolation } , '"'
             | '"""' , { any } , '"""' ;
interpolation= "{" , expr , [ ":" , format_spec ] , "}" ;

NL           = newline that ends a statement ;   (* see "continuation rule" in 01-syntax.md *)
SEP          = NL | ";" | "," ;

(* multi-char tokens worth calling out *)
(*   ~>  <~  =>  ->  ..  ..=  +%  -%  *%  +|  -|  *|  +?  -?  *?  as%  as|  as?  <<  >>  *)


(* ------------------------------------------------------------------ items *)

file         = { item SEP } ;

item         = { attribute } , [ "pub" ] ,
               ( use_decl | const_decl | type_decl | warp_decl | weft_decl
               | weave_decl | fn_decl | extern_block | card_stmt ) ;

attribute    = "#" , IDENT , [ "(" , [ attr_arg , { "," , attr_arg } ] , ")" ] ;
attr_arg     = IDENT | STRING | INT | IDENT , "=" , expr ;

use_decl     = "use" , path , [ "." , "{" , use_name , { "," , use_name } , "}" ] , [ "as" , IDENT ] ;
use_name     = ( IDENT | TYPE_IDENT ) , [ "as" , ( IDENT | TYPE_IDENT ) ] ;
path         = IDENT , { "." , IDENT } ;

const_decl   = "const" , CONST_IDENT , [ ":" , type ] , "=" , expr ;
type_decl    = "type" , TYPE_IDENT , [ generics ] , [ "=" , type , [ gauge ] ] ;
gauge        = "where" , expr ;          (* a range expression, or a boolean hole lambda *)

(* warps *)
warp_decl    = [ "loose" | "ref" ] , "warp" , TYPE_IDENT , [ generics ] , [ ":" , weft_list ] , [ where_clause ] ,
               ( warp_body | "(" , [ field_list ] , ")" ) ;
warp_body    = "{" , { warp_member , SEP } , "}" ;
warp_member  = { attribute } , ( field | through | case_decl | const_decl | type_decl | fn_decl | card_stmt ) ;
field        = [ visibility ] , IDENT , ":" , type , [ "=" , expr ] ;
field_list   = field , { "," , field } ;
through      = "through" , IDENT , ":" , type ;
visibility   = "pub" , [ "(" , "get" , ")" ] ;
case_decl    = "case" , case_item , { "," , case_item } ;
case_item    = TYPE_IDENT , [ "(" , case_field , { "," , case_field } , ")" ] ;
case_field   = [ IDENT , ":" ] , [ "from" ] , type ;

(* wefts & weaves *)
weft_decl    = "weft" , TYPE_IDENT , [ generics ] , [ ":" , weft_list ] , "{" , { weft_member , SEP } , "}" ;
weft_member  = "type" , TYPE_IDENT , [ ":" , weft_list ]
             | fn_sig , [ fn_body ] ;
weave_decl   = "weave" , [ generics ] , type , "into" , type , [ where_clause ] ,
               "{" , { fn_decl , SEP } , "}" ;
weft_list    = type , { ( "," | "+" ) , type } ;

(* functions *)
fn_decl      = fn_sig , fn_body ;
fn_sig       = [ "card" | "selvage" ] , "fn" , IDENT , [ generics ] ,
               "(" , [ param , { "," , param } ] , ")" ,
               [ returns ] , [ givens ] , [ where_clause ] ;
param        = [ "mut" | "take" | "card" ] , ( "self" | IDENT , ":" , type , [ "=" , expr ] ) ;
returns      = "->" , type , [ "!" , error_type ]
             | "!" , error_type
             | "~>" , [ "mut" | "ref" ] , type , [ "<~" , type ]      (* shuttles & projections *)
             | "<~" , type ;
givens       = "given" , IDENT , ":" , type , { "," , IDENT , ":" , type } ;
fn_body      = block | "=" , expr ;

generics     = "[" , gparam , { "," , gparam } , "]" ;
gparam       = TYPE_IDENT , [ ":" , weft_list ]
             | "card" , IDENT , ":" , type
             | "@" , IDENT ;                                         (* explicit region param *)
where_clause = "where" , bound , { "," , bound } ;
bound        = type , ":" , weft_list ;

extern_block = "extern" , STRING , "{" , { fn_sig , SEP } , "}" ;


(* ------------------------------------------------------------------ types *)

type         = union_type ;
union_type   = result_type , { "|" , result_type } ;
result_type  = region_type , [ "!" , error_type ] ;
error_type   = region_type | "(" , type , { "|" , type } , ")" | "_" ;
region_type  = prefix_type , [ "@" , ( IDENT | "heap" | "static" ) ] ;
prefix_type  = "?" , prefix_type
             | "^" , prefix_type
             | "*" , prefix_type
             | "any" , ( type_path | "(" , weft_list , ")" )
             | fn_type
             | atom_type ;
fn_type      = ( atom_type | "(" , [ type , { "," , type } ] , ")" ) , "=>" , type ;
atom_type    = PRIM
             | type_path , [ "[" , type_arg , { "," , type_arg } , "]" ]
             | "(" , [ type , { "," , type } ] , ")"                      (* tuple, unit *)
             | "[" , type , [ ";" , expr ] , "]"                          (* slice, array *)
             | "Self"
             | card_call ;                                                (* uint(12) *)
type_path    = [ path , "." ] , TYPE_IDENT , { "." , TYPE_IDENT } ;
type_arg     = type | expr ;                                              (* card values: Ring[u8, 64] *)


(* ------------------------------------------------------------- statements *)

block        = "{" , { stmt , SEP } , [ expr ] , "}" ;

stmt         = let_stmt | given_stmt | spool_stmt | hem_stmt | assign_stmt
             | card_stmt | item | expr ;
let_stmt     = ( "let" | "var" ) , pattern , [ ":" , type ] , "=" , expr ;
given_stmt   = "given" , ( IDENT , "=" , expr | expr ) ;
spool_stmt   = "spool" , IDENT , "=" , expr ;
hem_stmt     = "hem" , [ IDENT , "=>" ] , expr ;
assign_stmt  = place , assign_op , expr ;
assign_op    = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "~=" | "<<=" | ">>="
             | "+%=" | "-%=" | "*%=" | "+|=" | "-|=" | "*|=" ;
card_stmt    = "card" , ( "assert" , "(" , expr , [ "," , expr ] , ")" | card_if | card_for | block ) ;


(* ------------------------------------------------------------ expressions *)
(* Precedence, loosest first. Each level is left-associative unless noted.   *)

expr         = lambda ;
lambda       = lambda_params , "=>" , ( assign_stmt | expr ) | mend_expr ;  (* right-assoc *)
lambda_params= IDENT | "(" , [ lparam , { "," , lparam } ] , ")" ;
lparam       = [ "take" ] , IDENT , [ ":" , type ] ;

mend_expr    = or_expr , [ "mend" , ( IDENT , "=>" , expr | expr ) ] ;
or_expr      = and_expr , { "or" , and_expr } ;
and_expr     = not_expr , { "and" , not_expr } ;
not_expr     = "not" , not_expr | cmp_expr ;
cmp_expr     = range_expr , { cmp_op , range_expr }                       (* chained *)
             | range_expr , "is" , pattern ;
cmp_op       = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
range_expr   = [ bor_expr ] , ( ".." | "..=" ) , [ bor_expr ] | bor_expr ;
bor_expr     = xor_expr , { "|" , xor_expr } ;
xor_expr     = band_expr , { "~" , band_expr } ;
band_expr    = shift_expr , { "&" , shift_expr } ;
shift_expr   = add_expr , { ( "<<" | ">>" ) , add_expr } ;
add_expr     = mul_expr , { add_op , mul_expr } ;
add_op       = "+" | "-" | "+%" | "-%" | "+|" | "-|" | "+?" | "-?" ;
mul_expr     = cast_expr , { mul_op , cast_expr } ;
mul_op       = "*" | "/" | "%" | "*%" | "*|" | "*?" ;
cast_expr    = prefix_expr , { ( "as" | "as%" | "as|" | "as?" ) , type } ;
prefix_expr  = ( "-" | "~" | "^" ) , prefix_expr | postfix_expr ;

postfix_expr = primary , { postfix } ;
postfix      = "(" , [ args ] , ")"
             | "[" , [ type_arg , { "," , type_arg } ] , "]"             (* index or type args: resolved by name *)
             | "." , ( IDENT | TYPE_IDENT | INT | "(" , expr , ")" )     (* field, method, tuple .0, card field .(f) *)
             | "?"
             | "^"
             | "." , "{" , { stmt , SEP } , "}" ;                        (* dot-block *)
args         = arg , { "," , arg } ;
arg          = [ IDENT , ":" ] , [ "mut" ] , expr
             | "given" , ":" , expr ;

primary      = literal | IDENT | CONST_IDENT | type_path | "self" | "_"
             | "." , ( IDENT | TYPE_IDENT )                               (* leading dot *)
             | "(" , expr , { "," , expr } , ")"
             | "[" , [ expr , { "," , expr } | expr , ";" , expr | map_entries ] , "]"
             | block | if_expr | match_expr | loop_expr
             | "loom" , [ "(" , args , ")" ] , ( block | for_expr )
             | "thread" , expr
             | "pass" , [ "mut" | "ref" ] , expr
             | "pull"
             | "card" , ( block | postfix_expr )
             | "selvage" , STRING , block
             | "return" , [ expr ] | "fail" , expr
             | "break" , [ IDENT ] , [ expr ] | "continue" , [ IDENT ] ;
map_entries  = expr , ":" , expr , { "," , expr , ":" , expr } ;

if_expr      = "if" , expr , block , [ "else" , ( if_expr | block ) ] ;
card_if      = "if" , expr , block , [ "else" , ( card_if | block ) ] ;  (* whole chain is card *)
match_expr   = "match" , expr , "{" , { arm , SEP } , "}" ;
arm          = pattern , [ "if" , expr ] , "=>" , ( assign_stmt | expr ) ;
loop_expr    = [ IDENT , ":" ] , ( for_expr | "while" , expr , block | "loop" , block ) ;
for_expr     = "for" , pattern , "in" , expr , block ;
card_for     = for_expr ;


(* --------------------------------------------------------------- patterns *)

pattern      = alt_pattern ;
alt_pattern  = single_pattern , { "|" , single_pattern } ;
single_pattern
             = "_"
             | [ "mut" ] , IDENT
             | IDENT , ":" , type                                        (* type test *)
             | literal | TWILL
             | literal , ( ".." | "..=" ) , literal
             | "(" , pattern , { "," , pattern } , ")"
             | "[" , [ pattern , { "," , pattern } ] , [ "," , ".." , [ IDENT ] ] , "]"
             | ( "." , TYPE_IDENT | type_path ) , [ "(" , field_pats , ")" ]
             | "." , "(" , expr , ")"                                    (* card case: .(c) *)
             | ( "some" | "ok" | "err" ) , "(" , pattern , ")"
             | "none" ;
field_pats   = field_pat , { "," , field_pat } , [ "," , ".." ] ;
field_pat    = [ IDENT , ":" ] , pattern ;
