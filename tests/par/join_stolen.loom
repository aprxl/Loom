// A parent starts threads, keeps its worker busy, and then joins them: by then
// other workers have taken some (and finished or begun them), and the join of
// one nobody took runs it itself.

use std.io.print

fun work(n: u64) -> u64 {
    var x = n
    for i in 0..n {
        x = (x ~ i).rotate_left(5) +% 0x9e3779b97f4a7c15
    }
    x % 1000
}

fun main() {
    var total: u64 = 0
    loom {
        let hs = (0..16).map(i => thread work(100000 + (i as u64) * 1000)).collect()
        let busy = work(3000000)
        total += busy
        for h in hs {
            total += h.join()
        }
    }
    print("total {total}")
}
