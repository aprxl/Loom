// Eight tasks read one constant that takes a while to compute: one computes
// it, the others wait for it (parked, not spinning), and all see it.

use std.io.print
use std.sync.Atomic

warp Shape {
    case Round(u64)
    case Square(u64)
}

const SLOW: Shape = slow_shape()

fun slow_shape() -> Shape {
    var n = 0u64
    for i in 0..400000u64 {
        n += i % 7
    }
    Shape.Round(n)
}

fun size(s: Shape) -> u64 = match s {
    .Round(r) => r
    .Square(r) => r * r
}

fun main() {
    let total = Atomic[u64](0)
    loom for i in 0..8u64 {
        total.add(size(SLOW) + i)
    }
    print("total {total.load()}")
}
