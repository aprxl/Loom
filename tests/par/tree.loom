// Spawn and join, many levels: each thread starts two more.

use std.io.print
use std.sync.Atomic

fun grow(depth: i32, leaves: Atomic[u64]) {
    if depth == 0 {
        leaves.add(1)
        return
    }
    loom {
        thread { grow(depth - 1, leaves) }
        thread { grow(depth - 1, leaves) }
        ()
    }
}

fun main() {
    let leaves = Atomic[u64](0)
    grow(8, leaves)
    print("leaves {leaves.load()}")
}
