// Eight tasks print 10,000 lines each, built from templates (a padded number
// among them): every line comes out whole, none is lost, and each task's own
// lines are in order. `par_output_stays_whole` (crates/loom/tests/fixtures.rs)
// checks the output, which depends on the order the tasks run in.

use std.io.print

fn main() {
    loom for i in 0..8 {
        for j in 0..10000u64 {
            print("task {i} line {j:06} sum {i * 100000 + j} end")
        }
    }
}
