// passes: inline, gvn
// fns: main
//
// `apply` is inlined, and the function value it calls is then a known
// lambda: GVN makes the call through it a call of the lambda.
use std.io.print

fun apply(f: i64 => i64, x: i64) -> i64 = f(x)

fun main() {
    let k = 3
    print(apply(x => x * k, 14))
}
