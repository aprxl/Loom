// passes: cleanup
// fns: scale, bump
//
// An element's address comes before the value stored at it is worked
// out: the store gets it just before it, which codegen fuses with it
// (`stelf`). The multiplication between can't trap. `+=` loads and stores
// at one address, which stays one (a copy for each would check again what's
// already checked).
use std.io.print

fn scale(mut xs: List[f64], i: usize, a: f64, b: f64) {
    xs[i] = a * b
}

fn bump(mut xs: List[i64], i: usize) {
    xs[i] += 1
}

fn main() {
    var xs: List[f64] = [1.0, 2.0]
    scale(mut xs, 1, 3.0, 4.0)
    var ys: List[i64] = [1, 2]
    bump(mut ys, 0)
    print("{xs} {ys}")
}
