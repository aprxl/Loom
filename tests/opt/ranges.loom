// passes: inline, sccp, gvn, sccp, ranges, sccp
// fns: fib, total, clamp_index, small
//
// `n - 1` and `n - 2` under `n >= 2` can't overflow; nor can `i + 1` under
// `i < n` (whatever `n` is), nor the cast of a `u8` to `u16`. The bounds
// check of `xs[i]` under `i < xs.len()` can't fire, and a `u8` loaded from
// memory is below 300.
use std.io.print

fun fib(n: i32) -> i32 = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fun total(xs: [u32]) -> u64 {
    var sum = 0u64
    var i = 0
    while i < xs.len() {
        sum = sum +% xs[i] as u64
        i += 1
    }
    sum
}

fun clamp_index(i: u8) -> u16 = if i < 255 { i as u16 + 1 } else { 0 }

fun small(xs: [u8]) -> bool = xs[0] as u32 < 300

fun main() {
    print(fib(10))
    print(total([1, 2, 3]))
    print(clamp_index(4))
    print(small([9]))
}
