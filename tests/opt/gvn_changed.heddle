fn square_sum(v0: f64, v1: f64) -> (f64) {
b0(v0: f64, v1: f64):
    v2 = fmul.f64 v0, v0
    v3 = fmul.f64 v1, v1
    v4 = fadd.f64 v2, v3
    v6 = fadd.f64 v4, v2
    ret v6
}
fn fields(v0: ptr, v1: ptr) -> (int) {
b0(v0: ptr, v1: ptr):
    v2 = load.64 v0
    v4 = add.i64 v2, v2
    v5 = iconst 7
    store.64 v0+8, v5
    v8 = add.i64 v5, v2
    v9 = iconst 1
    store.64 v1, v9
    v10 = add.i64 v4, v8
    v11 = load.64 v0
    v12 = add.i64 v10, v11
    ret v12
}
