// passes: licm
// fns: scale, walk
//
// `k * 2.0` doesn't change in the loop: computed once, before it. So is
// the length of a list in a slot nothing in the loop writes. A loop entered
// from a branch gets a block of its own to put that in.
use std.io.print

fun scale(xs: List[f64], k: f64) -> f64 {
    var total = 0.0
    var i = 0usize
    while i < xs.len() {
        total += xs[i] * (k * 2.0)
        i += 1
    }
    total
}

fun walk(n: u32, flag: bool) -> u32 {
    var sum = 0u32
    if flag {
        var i = 0u32
        while i < n {
            sum +%= (n *% 3) ~ i
            i += 1
        }
    }
    sum
}

fun main() {
    print(scale([1.0, 2.0], 3.0))
    print(walk(10, true))
}
