fn scale(v0: ptr, v1: int, v2: f64, v3: f64) -> () {
b0(v0: ptr, v1: int, v2: f64, v3: f64):
    v4 = fmul.f64 v2, v3
    v5 = elem v0+0[v1] * 8
    store.64 v5, v4
    ret
}
fn bump(v0: ptr, v1: int) -> () {
b0(v0: ptr, v1: int):
    v2 = iconst 1
    v3 = elem v0+0[v1] * 8
    v4 = load.64 v3
    v5 = add.i64 v4, v2
    v6 = elem v0+0[v1] * 8
    store.64 v6, v5
    ret
}
