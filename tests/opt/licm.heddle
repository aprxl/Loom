fn scale(v0: ptr, v1: f64) -> (f64) {
b0(v0: ptr, v1: f64):
    v2 = fconst.f64 0.0
    v3 = iconst 0
    v6 = load.64 v0+8
    v11 = fconst.f64 2.0
    v12 = fmul.f64 v1, v11
    v16 = iconst 1
    jump b1(v3, v2)
b1(v4: int, v14: f64):
    v7 = icmp.lt.u v4, v6
    br v7, b2, b3
b2:
    v8 = elem v0+0[v4] * 8
    v9 = load.64 v8
    v13 = fmul.f64 v9, v12
    v15 = fadd.f64 v14, v13
    v17 = add.usize v4, v16
    jump b1(v17, v15)
b3:
    ret v14
}
fn walk(v0: int, v1: int) -> (int) {
b0(v0: int, v1: int):
    v2 = iconst 0
    br v1, b1, b2(v2)
b1:
    v3 = iconst 0
    v7 = iconst 3
    v8 = mul%.u32 v0, v7
    v12 = iconst 1
    jump b3(v3, v2)
b2(v14: int):
    ret v14
b3(v4: int, v10: int):
    v6 = icmp.lt.u v4, v0
    br v6, b4, b2(v10)
b4:
    v9 = xor v8, v4
    v11 = add%.u32 v10, v9
    v13 = add.u32 v4, v12
    jump b3(v13, v11)
}
