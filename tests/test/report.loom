// `loom test` runs every test, even after one fails, and shows what a failing
// test printed. A file of tests needs no `main`.

use std.io.print

warp Oops: Error {
    case Bad(n: i32)
}

fun half(n: i32) -> i32 ! Oops {
    if n % 2 != 0 { fail .Bad(n) }
    n / 2
}

test adds() = assert(1 + 1 == 2)

test halves() ! Oops {
    assert(half(8)? == 4)
}

test fails_with_an_error() ! Oops {
    print("about to halve 3")
    let h = half(3)?
    print("never {h}")
}

test unravels() {
    let xs = [1, 2, 3]
    assert(xs.len() == 4, "three is not four")
}
