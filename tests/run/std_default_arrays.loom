use std.io.print
use std.mem.take
use std.default.of

fn main() {
    var a = [1, 2, 3]
    let b = take(mut a)
    print("{b}")
    print("{a}")
    let s: [String; 2] = std.default.of()
    print("{s:?}")
    let g: [[u8; 2]; 2] = std.default.of()
    print("{g:?}")
    let x = of[[String; 2]]()
    print("{x:?}")
    let y = of[[[u8; 2]; 2]]()
    print("{y:?}")
}
