// `any W`: a value of some type that weaves `W`, with its methods found at
// run time, and type tests to get the concrete type back.

use std.io.print
use std.fmt.{Show, Fmt}

weft Shape: Show {
    fun area(self) -> f64
    fun name(self) -> str = "shape"
    fun grow(mut self, by: f64)
}

warp Circle: Shape, Show {
    r: f64
    fun area(self) -> f64 = 3.0 * .r * .r
    fun name(self) -> str = "circle"
    fun grow(mut self, by: f64) { .r += by }
}

warp Square: Shape, Show {
    side: f64
    fun area(self) -> f64 = .side * .side
    fun grow(mut self, by: f64) { .side += by }
}

fun describe(s: any Shape) -> String = "{s.name()} of area {s.area()}"

fun biggest(take a: any Shape, take b: any Shape) -> any Shape = if a.area() >= b.area() { a } else { b }

fun kind(s: any Shape) -> str = match s {
    c: Circle => if c.r > 1.0 { "big circle" } else { "small circle" }
    sq: Square => if sq.side > 2.0 { "big square" } else { "square" }
    _ => "something else"
}

fun main() {
    var s: any Shape = Circle(r: 1.0)
    print(describe(s))
    s.grow(1.0)                                  // `mut self` through `any`
    print(describe(s))
    print(s)                                     // `any Shape` is `Show`: it shows the value
    s = Square(side: 2.0)
    print("{describe(s)}; {s}")

    let big = biggest(Circle(r: 0.5), Square(side: 3.0))
    print("{big.name()} {kind(big)} {kind(Circle(r: 2.0))} {kind(Circle(r: 0.1))}")

    if big is sq: Square {
        print("a square with side {sq.side}")
    }

    // An `any` of more wefts passes as an `any` of fewer.
    let shown: any Show = s
    print("shown: {shown}")
    let n: any Show = 42
    print("{n} {(n, shown)}")
}
