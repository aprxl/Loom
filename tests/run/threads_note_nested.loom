// A thread whose own thread unravels: the note is at the thread the parent
// can see, the outer one, not at the one that unravelled.

use std.io.print

fun inner() -> i32 {
    unravel("deep")
}

fun outer() -> i32 {
    loom {
        let t = thread inner()
        t.join()
    }
}

fun main() {
    loom {
        let a = thread outer()
        print(a.join())
    }
}
