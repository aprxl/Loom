use std.io.print

fun word(o: Ordering) -> str {
    match o {
        .Less => "less"
        .Equal => "equal"
        .Greater => "greater"
    }
}

fun main() {
    let one: f64 = 1.0
    print(one.to_bits())
    let neg_zero: f64 = -0.0
    print(neg_zero.to_bits())
    let one32: f32 = 1.0
    print(one32.to_bits())
    print(word((-0.0).total_cmp(0.0)))
    print(word((-1.0).total_cmp(1.0)))
    print(word(2.5.total_cmp(2.5)))
    print(word(1.0.total_cmp(-1.0)))
    print(f64.from_bits(one.to_bits()) == one)
    print(f32.from_bits(one32.to_bits()) == one32)
    let x: f64 = -2.5
    print(f64.from_bits(x.to_bits()).to_bits() == x.to_bits())
    print(f64.from_bits(4607182418800017408) == 1.0)
}
