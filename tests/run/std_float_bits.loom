use std.io.print

fn word(o: Ordering) -> str {
    match o {
        .Less => "less"
        .Equal => "equal"
        .Greater => "greater"
    }
}

fn main() {
    let one: f64 = 1.0
    print(one.to_bits())
    let neg_zero: f64 = -0.0
    print(neg_zero.to_bits())
    let one32: f32 = 1.0
    print(one32.to_bits())
    print(word((-0.0).total_cmp(0.0)))
    print(word((-1.0).total_cmp(1.0)))
    print(word(2.5.total_cmp(2.5)))
    print(word(1.0.total_cmp(-1.0)))
}
