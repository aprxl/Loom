// Pointers: `^e` allocates a box, `p^` reads it, fields and patterns see through.

use std.io.print

warp Point {
    x: i32
    y: i32
}

warp Tree {
    case Leaf
    case Node(left: ^Tree, value: i32, right: ^Tree)
}

fun insert(take t: ^Tree, v: i32) -> ^Tree = match t {
    .Leaf => ^Tree.Node(^Tree.Leaf, v, ^Tree.Leaf)
    .Node(l, x, r) => if v < x {
        ^Tree.Node(l.insert(v), x, r)
    } else {
        ^Tree.Node(l, x, r.insert(v))
    }
}

fun sum(t: ^Tree) -> i32 = match t {
    .Leaf => 0
    .Node(l, x, r) => l.sum() + x + r.sum()
}

fun main() {
    let n = ^41
    print("{n^ + 1}")
    print("{n}")

    var p = ^Point(1, 2)
    p.x = 10
    p.y += 5
    print("{p.x} {p.y}")
    print("{p:?}")
    let q = p^
    print("{q.x + q.y}")

    var t: ^Tree = ^Tree.Leaf
    for v in [5, 2, 8, 1, 9, 3] {
        t = t.insert(v)
    }
    print("sum {t.sum()}")
}
