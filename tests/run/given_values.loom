// `given` is not only for spools: any weft can be given, from the block it is
// stated in, or by a call. A weft with a `#given_default` has one when nothing
// is given.

use std.io.print

#given_default(Plain)
weft Greeter {
    fun greet(self) -> String
}

warp Plain: Greeter, Default {
    pub fun greet(self) -> String = "hello"
}

warp Loud: Greeter {
    name: String

    pub fun greet(self) -> String = "HELLO, {.name}!"
}

fun welcome(who: str) -> String given g: Greeter = "{g.greet()} {who}"

fun twice(who: str) -> String given g: Greeter = "{welcome(who)} / {welcome(who)}"

fun main() {
    print(welcome("ann"))
    print(twice("bob"))

    given g = Loud("ci")
    print(welcome("dee"))
    {
        given h = Plain()
        print(welcome("eve"))
    }
    print(welcome("fay"))
    print(welcome("gus", given: Plain()))
}
