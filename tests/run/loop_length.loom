// The length of a list after a counted loop of pushes: known to the
// optimizer when each trip pushes once, and exact (what the run does) in the
// shapes where it isn't.
use std.io.print

fun counted(n: usize) -> List[i32] {
    var xs: List[i32] = List()
    for i in 0..n { xs.push(i as i32) }
    xs
}

fun leave_early() -> List[i32] {
    var xs: List[i32] = List()
    for i in 0..10 {
        if i == 4 { break }
        xs.push(i as i32)
    }
    xs
}

fun sometimes() -> List[i32] {
    var xs: List[i32] = List()
    for i in 0..10 {
        if i % 2 == 0 { xs.push(i as i32) }
    }
    xs
}

fun twice(n: usize) -> List[i32] {
    var xs: List[i32] = List()
    for i in 0..n {
        xs.push(i as i32)
        xs.push(-(i as i32))
    }
    xs
}

fun after_some() -> List[i32] {
    var xs: List[i32] = [100, 200]
    for i in 0..3 { xs.push(i as i32) }
    xs
}

fun add_nine(mut xs: List[i32]) {
    xs.push(9)
}

fun through_a_call() -> List[i32] {
    var xs: List[i32] = List()
    for i in 0..3 {
        xs.push(i as i32)
        add_nine(mut xs)
    }
    xs
}

fun nested() -> List[i32] {
    var xs: List[i32] = List()
    for i in 0..3 {
        for j in 0..4 { xs.push((i * 4 + j) as i32) }
    }
    xs
}

fun sum_to_len(n: usize) -> i32 {
    let xs = counted(n)
    var total = 0
    for i in 0..xs.len() { total += xs[i] }
    total
}

fun main() {
    let a = counted(0)
    let b = counted(5)
    print("{a.len()} {b.len()} {b[4]}")
    let c = leave_early()
    print("{c.len()} {c[3]}")
    let d = sometimes()
    print("{d.len()} {d[4]}")
    let e = twice(3)
    print("{e.len()} {e[5]}")
    let f = after_some()
    print("{f.len()} {f[4]}")
    let g = through_a_call()
    print("{g.len()} {g[5]}")
    let h = nested()
    print("{h.len()} {h[11]}")
    print("{sum_to_len(0)} {sum_to_len(1)} {sum_to_len(10)}")
}
