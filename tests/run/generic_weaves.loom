// Weaves of generic warps: derived and hand-written in the header, and
// generic weave items, each instantiated per type.

use std.io.print
use std.fmt.{Show, Fmt}

warp Pt[T]: Eq, Ord, Show { x: T, y: T }

warp Tagged[T]: Show {
    tag: str
    value: T
    fun show(self, mut f: Fmt) {
        f.put(.tag)
        f.put("=")
        f.put(.value)
    }
}

weft Area { fun area(self) -> f64 }
warp Sq[T] { side: f64, extra: T }
weave[T] Area into Sq[T] { fun area(self) -> f64 = .side * .side }

fun total(a: Area, b: Area) -> f64 = a.area() + b.area()

fun main() {
    print(Pt(1, 2) == Pt(1, 2))
    print(Pt(1, 2) < Pt(1, 3))
    print(Pt(x: 1.5, y: 2.0))
    print(Tagged("n", 5))
    print("{Tagged("s", "str")} {Tagged("t", Tagged("u", true))}")
    print(total(Sq(2.0, 'c'), Sq(3.0, 7)))
    print(Area.area(Sq(1.5, ())))
}
