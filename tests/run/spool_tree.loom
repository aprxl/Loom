use std.io.print
use std.fmt.{Show, Fmt}
use std.mem.{Arena, kib}

warp Expr {
    case Num(i32)
    case Neg(^Expr)
    case Add(^Expr, ^Expr)
}

weave Show into Expr {
    fun show(self, mut f: Fmt) = match self {
        .Num(n) => f.put(n)
        .Neg(x) => f.put("-{x}")
        .Add(l, r) => f.put("({l} + {r})")
    }
}

fun eval(e: ^Expr) -> i32 = match e {
    .Num(n) => n
    .Neg(x) => -x.eval()
    .Add(l, r) => l.eval() + r.eval()
}

fun main() {
    let h: ^Expr = ^Expr.Add(^Expr.Num(1), ^Expr.Neg(^Expr.Num(2)))
    print("{h} = {h.eval()}")

    spool a = Arena(1.kib())
    let one: ^Expr@a = a.put(Expr.Num(1))
    let two: ^Expr@a = a.put(Expr.Num(2))
    let neg = a.put(Expr.Neg(two))
    let sum = a.put(Expr.Add(one, neg))
    print("{sum} = {sum.eval()}")
}
