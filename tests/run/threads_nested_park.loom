// A loom inside a thread: falling off the end waits for an unjoined child
// that parks, and a thread cancelled while its own loom has a parked child
// cancels and waits for that child on the way out.

use std.io.print
use std.sync.sched_yield

fun child(name: str) -> i32 {
    defer print("{name} cleanup")
    print("{name} start")
    sched_yield()
    print("{name} finished")
    1
}

fun falls_off() -> i32 {
    loom {
        thread child("fall")
        ()
    }
    print("falls_off done")
    5
}

fun cancelled() -> i32 {
    loom {
        thread child("held")
        sched_yield()
        print("cancelled: unreachable")
        ()
    }
    0
}

fun boom() {
    unravel("boom")
}

fun main() {
    loom {
        let a = thread falls_off()
        let b = thread cancelled()
        thread boom()
        a.join() + b.join()
    }
}
