use std.io.print

warp Vec2 {
    x: f64
    y: f64

    const ZERO = Vec2(0, 0)

    fun new(x: f64, y: f64) -> Self = Self(x, y)
    fun dot(self, o: Vec2) -> f64 = .x * o.x + .y * o.y
    fun scaled(self, k: f64) -> Vec2 = Vec2(.x * k, .y * k)
    fun flip(mut self) { (.x, .y) = (.y, .x) }
}

// UFCS: a free function is a method on its first parameter.
fun kib(n: usize) -> usize = n * 1024
fun describe(v: Vec2) -> String = "({v.x}, {v.y})"

warp Stack {
    top: i32 = 0
    size: u8 = 0

    fun push(mut self, n: i32) {
        .top = n
        .size += 1
    }
}

fun main() {
    let v = Vec2.new(3, 4)
    print("{v.dot(v)} {v.scaled(2).describe()} {Vec2.ZERO:?}")
    print("{64.kib()} {u8.MAX} {i8.MIN} {Vec2.dot(v, Vec2(1, 0))}")

    var w = v
    w.flip()
    print("{w:?} {v:?}")

    // Inside a dot-block, a leading dot means the subject.
    var s = Stack()
    s.{
        .push(10)
        .push(20)
    }
    print("top {s.top} size {s.size}")

    let built = Stack().{ .push(5) }
    print("{built:?}")
}
