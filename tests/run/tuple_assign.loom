// A tuple assignment gives each of its targets a new value: a `mut`
// parameter is written into, so the caller sees it; a moved-out local is
// usable again; and a fallback `defer` has a new value to clean up.
use std.io.print

warp P: Copy, Show { x: i32, y: i32 }

fun swap(mut a: P, mut b: P) { (a, b) = (b, a) }
fun set_both(mut a: P, mut b: P) { (a, b) = (P(0, 0), P(9, 9)) }
fun mixed(mut a: P) -> P {
    var x = P(7, 7)
    (x, a) = (a, x)
    x
}

warp W: Show {
    p: P
    fun swap_in(mut self, mut o: P) { (self, o) = (W(o), self.p) }
}

fun keep(take s: String) -> usize = s.len()

once warp Tx {
    name: String
    pub fun commit(take self) { let Tx(n) = self; print("commit {n}") }
    pub fun rollback(take self) { let Tx(n) = self; print("rollback {n}") }
}

fun tx() {
    var t = Tx("first".to_string())
    var n = 0
    defer t => t.rollback()
    t.commit()
    (t, n) = (Tx("second".to_string()), 1)
}

fun main() {
    var a = P(1, 1)
    var b = P(2, 2)
    swap(mut a, mut b)
    print("{a} {b}")
    set_both(mut a, mut b)
    print("{a} {b}")
    let old = mixed(mut a)
    print("{old} {a}")
    var w = W(P(5, 5))
    var o = P(6, 6)
    w.swap_in(mut o)
    print("{w} {o}")
    var s: String = "x"
    var t: String = "y"
    (s, t) = (t, s)
    print("{s} {t}")
    keep(s)
    var n = 0
    (s, n) = ("z", 1)
    print("{s} {n}")
    tx()
}