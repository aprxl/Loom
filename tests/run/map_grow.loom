// A map grown to 200,000 entries, every other one removed, grown again: the
// index is built again at each doubling and at each compaction, and the
// order, the contents, `first` and `last` hold through them.

use std.io.print

fn check(m: Map[u64, u64], label: String) {
    var order = 0u64
    var sum = 0u64
    var last = 0u64
    var ascending = true
    for (k, v) in m {
        order += 1
        sum += k + v * 2
        if order > 1 and k <= last { ascending = false }
        last = k
    }
    print("{label}: len {m.len()} seen {order} sum {sum} ascending {ascending} first {m.first()} last {m.last()}")
}

fn main() {
    var m: Map[u64, u64] = Map()
    for i in 0..200_000u64 { m.insert(i, i * 3) }
    check(m, "grown")
    for i in 0..200_000u64 {
        if i % 2 == 0 { m.remove(i) }
    }
    check(m, "halved")
    for i in 200_000..300_000u64 { m.insert(i, i * 3) }
    check(m, "grown again")
    var found = 0u64
    var wrong = 0u64
    for i in 0..300_000u64 {
        match m.get(i) {
            some(v) => {
                found += 1
                if v != i * 3 { wrong += 1 }
            }
            none => {}
        }
    }
    print("found {found} wrong {wrong} has0 {m.has(0)} has1 {m.has(1)} has299999 {m.has(299_999)}")
    for i in 0..300_000u64 {
        if i % 3 != 0 { m.remove(i) }
    }
    check(m, "thirds")
    m.insert(7, 70)
    print("{m.first()} {m.last()} {m.len()}")

    // Owning keys and values move as bytes.
    var s: Map[String, String] = Map()
    for i in 0..50_000u32 { s.insert("k{i}", "v{i}") }
    for i in 0..50_000u32 {
        if i % 4 != 0 { s.remove("k{i}") }
    }
    for i in 50_000..60_000u32 { s.insert("k{i}", "v{i}") }
    var good = 0u32
    for i in 0..60_000u32 {
        match s.get("k{i}") {
            some(v) => if v == "v{i}" { good += 1 }
            none => {}
        }
    }
    print("{s.len()} {good} {s.first()} {s.last()}")

    var set: Set[u32] = Set()
    for i in 0..100_000u32 { set.insert(i) }
    for i in 0..100_000u32 {
        if i % 2 == 1 { set.remove(i) }
    }
    for i in 100_000..120_000u32 { set.insert(i) }
    var n = 0u32
    var total = 0u64
    for x in set {
        n += 1
        total += x as u64
    }
    print("{set.len()} {n} {total} {set.pop()} {set.has(0)} {set.has(1)}")
}
