// Compile-time code is real work: millions of steps are fine (the budget is
// a hundred million), and the results are the ones the program gets.

use std.io.print

/// The sum of the first `n` squares, the long way round.
fun squares(n: u64) -> u64 {
    var total: u64 = 0
    var i: u64 = 1
    while i <= n {
        total += i * i
        i += 1
    }
    total
}

/// How many numbers below `n` the Collatz walk takes more than 100 steps for.
fun long_walks(n: u64) -> u32 {
    var count: u32 = 0
    var k: u64 = 1
    while k < n {
        var x = k
        var steps = 0
        while x != 1 {
            x = if x % 2 == 0 { x / 2 } else { 3 * x + 1 }
            steps += 1
        }
        if steps > 100 { count += 1 }
        k += 1
    }
    count
}

const SQUARES: u64 = squares(1_500_000)
const WALKS: u32 = long_walks(15_000)

fun main() {
    print("squares = {SQUARES}")
    print("long walks = {WALKS}")
}
