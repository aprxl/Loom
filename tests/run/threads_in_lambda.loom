// A thread started in a lambda, to make a list of handles: each borrows
// `names`, which outlives the loom, and its result is joined in order.

use std.io.print

fn weigh(name: str) -> u32 {
    var w = 0u32
    for c in name.chars() {
        w += c as u32 % 7
    }
    w
}

fn main() {
    let names = ["ada", "grace", "edsger", "barbara"]
    let total = loom {
        let jobs = names.map(n => thread weigh(n))
        var sum = 0u32
        for job in jobs {
            sum += job.join()
        }
        sum
    }
    print("{total}")
}
