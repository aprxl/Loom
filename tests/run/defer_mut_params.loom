// A `defer` that changes a `mut` parameter runs before the caller gets it
// back, whether it's written into (a table) or copied back (a number, a
// string, a unit case).
use std.io.print

warp W: Show { n: i32 }

warp Lv: Show {
    case A, B
    fun go(mut self) {
        defer self = .B
        self = .A
    }
}

fun f_scalar(mut n: i32) -> i32 {
    defer n += 1000
    n += 1
    n
}

fun f_scalar_unit(mut n: i32) {
    defer n += 1000
    n += 1
}

fun f_str(mut s: String) {
    defer s.push_str("!")
    s.push_str("?")
}

fun f_table(mut w: W) -> i32 {
    defer w.n += 1000
    w.n += 1
    w.n
}

fun main() {
    var a = 0
    print("{f_scalar(mut a)} {a}")
    var b = 0
    f_scalar_unit(mut b)
    print(b)
    var s: String = ""
    f_str(mut s)
    print(s)
    var w = W(0)
    print("{f_table(mut w)} {w}")
    var l = Lv.A
    l.go()
    print(l)
}
