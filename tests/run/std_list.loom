use std.io.print
fn show(xs: [String]) -> String = xs.join(",")
fn main() {
    var xs: List[i32] = [1, 1, 2, 3, 3, 3, 4, 5, 6]
    xs.dedup()
    print(xs.join(","))
    xs.retain(_ % 2 == 0)
    print(xs.join(","))
    var ys: List[i32] = [10, 20, 30, 40, 50]
    print(ys.swap_remove(1))
    print(ys.join(","))
    ys.resize(7, 0)
    print(ys.join(","))
    ys.resize(2, 0)
    print(ys.join(","))
    var zs: List[i32] = [1, 2, 3, 4, 5, 6]
    let tail = zs.split_off(4)
    print("{zs.join(",")} | {tail.join(",")}")
    var ws: List[i32] = [1, 2, 3, 4, 5, 6]
    let mid = ws.drain(1, 4)
    print("{ws.join(",")} | {mid.join(",")}")
    var names: List[String] = ["a", "b", "b", "c"]
    names.dedup()
    names.retain(_ != "a")
    print(names.join(","))
    var more: List[String] = ["x", "y"]
    names.append(mut more)
    print("{names.join(",")} {more.len()}")
    var ps: List[(i32, i32)] = [(1, 1), (1, 2), (2, 3)]
    ps.dedup_by_key(_.0)
    print(ps.len())
}
