// An unravel after a block, in the same statement, is reported at the
// statement: the program generator (crates/loom/tests/gen.rs) found both
// backends reporting it at the block's last line.
use std.io.print

fun main() {
    let a: i5 = 15
    let b: i5 = (if a > 3 {
        a - 1
    } else {
        a
    }) + (a + 1)
    print(b)
}
