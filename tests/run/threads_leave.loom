// Leaving a loom early (here by `fail`) cancels the threads that are left,
// waits for them, and only then carries on with the exit.

use std.io.print
use std.sync.sched_yield

fn slow(name: str) -> i32 {
    defer print("{name} cleanup")
    print("{name} start")
    sched_yield()
    print("{name} finished")
    7
}

fn find(x: i32) -> i32 ! str {
    let r = loom {
        let a = thread slow("a")
        if x > 0 { fail "too big" }
        a.join()
    }
    r
}

fn main() {
    let a = find(0) mend e => -1
    print("find(0) = {a}")
    let b = find(1) mend e => -2
    print("find(1) = {b}")
}
