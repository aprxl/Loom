use std.hash
use std.io.print
use std.math

fn main() {
    print((-7).rem_euclid(3))
    print((-7).div_euclid(3))
    print(7.div_euclid(-3))
    print((-7).div_floor(2))
    print((-7).div_ceil(2))
    print(7u32.div_ceil(2))
    print(12.gcd(18))
    print((-12).gcd(18))
    print(0.gcd(0))
    print(4.lcm(6))
    print(18446744073709551615u64.gcd(15))
    print(10u64.isqrt())
    print(18446744073709551615u64.isqrt())
    print(99u8.isqrt())
    print(999.ilog10())
    print(18446744073709551615u64.ilog10())
    print(5.next_power_of_two())
    print(64u8.next_power_of_two())
    print(0u8.next_power_of_two())
    print(5u8.count_zeros())
    print((-3).signum())
    print(0i8.signum())
    print(9223372036854775807i64.signum())
    let x = 0.5
    print(x.sin().to_string() == 0.479425538604203.to_string())
    print(1.0.exp().ln())
    print(8.0.log2())
    print(1000.0.log10())
    print(3.0.hypot(4.0))
    print(8.0.exp2())
    print(2.0.log(8.0) > 0.33)
    print(2.5.fract())
    print((-2.5).signum())
    print(3.0.copysign(-1.0))
    print(180.0.to_radians() > 3.14)
    print(1.0.atan2(1.0) > 0.78)
    print(0.0.cosh())
    print(0.0.sinh())
    print(0.0.tanh())
    print((1.0 / 0.0).is_infinite())
    print(1.5.is_finite())
    print((-0.0).is_sign_negative())
    let f: f32 = 2.0
    print(f.sin() > 0.909)
    print(math.TAU == math.PI * 2.0)
    print(hash.fnv1a("hello".bytes().collect()))
    print(hash.combine(1, 2) != hash.combine(2, 1))
}
