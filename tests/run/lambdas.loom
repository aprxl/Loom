// Lambdas, hole lambdas, function values, and calling them.

use std.io.print

warp Point { x: i32, y: i32 }

fun apply(f: i32 => i32, x: i32) -> i32 = f(x)
fun twice[T](f: T => T, x: T) -> T = f(f(x))
fun compose(f: i32 => i32, g: i32 => i32, x: i32) -> i32 = g(f(x))
fun is_even(n: i32) -> bool = n % 2 == 0
fun clamp(x: i32, lo: i32, hi: i32) -> i32 = x.max(lo).min(hi)
fun norm1(p: Point) -> i32 = p.x.abs() + p.y.abs()

// A lambda's `return` leaves the lambda, not the function around it.
fun first_negative(xs: [i32]) -> i32 {
    var found = 0
    xs.each(x => {
        if x >= 0 { return }
        if found == 0 { found = x }
    })
    found
}

fun main() {
    let offset = 10
    print(apply(x => x * 2, 21))
    print(apply(_ + offset, 5))                   // a hole lambda sees `offset`
    print(apply((x: i32) => x - 1, 0))
    print(twice(x => x + 1, 5))                   // the other argument says what `T` is
    print(twice[String](s => "<{s}>", "hi"))
    print(compose(_ * 3, _ + 1, 2))
    print(compose(clamp(_, 0, 5), _ * 2, 9))      // clamp(_, 0, 5): the call is the lambda

    // A lambda changes the variables it sees.
    var total = 0
    [1, 2, 3].each(x => total += x)
    print(total)
    var log: List[String] = List()
    for i in 0..3 { [i].each(x => log.push("{x * i}")) }
    print(log)

    // Function values.
    let f = is_even
    print("{f(3)} {f(4)} {[1, 2, 3, 4].filter(is_even)}")
    let g: i32 => i32 = x => x * x
    print("{g(7)} {apply(g, 3)}")
    let pts = [Point(3, -4), Point(-1, 1)]
    print(pts.map(norm1))
    print(pts.map(_.x))
    print(String.of(['o', 'k']))
    let of = String.of
    print(of(['f', 'n']))

    print(first_negative([3, -2, 5, -7]))
}
