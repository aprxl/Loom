// Operations with a constant operand, which Treadle folds into the
// instruction: masks, shifts, division and remainder, comparisons that give
// a `bool`, bounds checks with a constant length, and branches on `not`.
use std.io.print

fun masks(x: u16) -> (u16, u16, u16) {
    (x & 0xF000, x | 0x00FF, x ~ 0xFFFF)
}

fun signed_masks(x: i32) -> (i32, i32) {
    (x & 0x7FFF, x | 0x100)
}

fun shifts8(x: u8, y: i8) -> (u8, u8, i8, i8) {
    (x << 3, x >> 7, y << 1, y >> 2)
}

fun shifts64(x: u64, y: i64) -> (u64, u64, i64, i64) {
    (x << 63, x >> 40, y << 62, y >> 63)
}

fun shifts_odd(x: u12, y: i24) -> (u12, i24) {
    (x >> 5, y >> 3)
}

fun divisions(x: i32, y: u32) -> (i32, i32, u32, u32) {
    (x / 7, x % 7, y / 10, y % 10)
}

fun comparisons(x: i16, y: u8) -> [bool; 8] {
    [x == 5, x != 5, x < -3, x <= -3, x > 100, x >= 100, y < 200, 200 < y]
}

fun pick(a: [u8; 4]) -> u8 {
    a[0] + a[3]
}

fun main() {
    print(masks(0xABCD))
    print(signed_masks(-1))
    print(shifts8(0b1011_0101, -100))
    print(shifts64(0xFFFF_FFFF_FFFF_FFFF, -5))
    print(shifts_odd(4095, -1000))
    print(divisions(-100, 12345))
    print(divisions(100, 9))
    for x in [-10i16, -3, 5, 100, 1000] {
        print(comparisons(x, 201))
    }
    print(pick([1, 2, 3, 4]))
    var flags = [true, false, true]
    var n = 0
    for f in flags {
        if not f { n += 10 } else { n += 1 }
    }
    print(n)
    // A constant index past a constant length still unravels.
    let i = 4
    var a = [1, 2, 3]
    if n > 100 { a[i] = 0 }
    print(a)
}
