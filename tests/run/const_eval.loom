// Compile-time code: constants computed by ordinary code, `const`
// expressions, and `const assert` wherever it's written.

use std.io.print

/// The CRC-32 lookup table, computed while compiling.
const CRC_TABLE: [u32; 256] = {
    var table = [0u32; 256]
    for i in 0u32..256 {
        var c = i
        for _ in 0..8 {
            c = if c & 1 == 1 { 0xEDB8_8320 ~ (c >> 1) } else { c >> 1 }
        }
        table[i] = c
    }
    table
}

fun crc32(data: [u8]) -> u32 {
    var crc = 0xFFFF_FFFFu32
    for b in data {
        crc = CRC_TABLE[(crc ~ b) as% u8] ~ (crc >> 8)
    }
    crc ~ 0xFFFF_FFFF
}

// The same function runs at compile time.
const assert(crc32(b"123456789") == 0xCBF4_3926, "CRC-32 check value")

fun fib(n: u64) -> u64 = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

const PRIMES: List[u32] = {
    var found = List()
    var n = 2u32
    while found.len() < 10 {
        if found.all(p => n % p != 0) { found.push(n) }
        n += 1
    }
    found
}

const GREETING: String = ["hello", "world"].join(", ")

warp Frame {
    tag: u8
    len: u16
    const assert(PRIMES.len() == 10, "ten primes")
}

// Constants are values like any other: a copy is its own.
const FONT: [u8; 3] = [1, 2, 3]

warp P: Copy { x: i32 }
const ORIGIN: P = P(x: 0)

// Whether or not its type is `Copy`: every use of a constant gets its own.
warp Config { names: List[str], limit: u8 }
const CONFIG: Config = Config(names: ["a", "b"], limit: 3)
const DIGITS: [u8] = [1, 2, 3, 4][1..3]

// `const` expressions anywhere an expression goes.
fun counter(n: i32) ~> i32 {
    let base = const 10 * 10
    for i in 0..n { yield base + i }
}

fun pad(x: i32, by: i32 = const 2 * 3) -> i32 = x + by

warp Pair { items: [u8; 2] = const [7, 8] }

fun id[T](x: T) -> T {
    const assert(fib(6) == 8)
    x
}

fun nth_fib(i: usize) -> u64 {
    // Computed once while compiling; every call reads the table.
    let table = const {
        var t = [0u64; 25]
        for k in 0..25 { t[k] = fib(k as u64) }
        t
    }
    table[i]
}

fun main() {
    print("crc32 = {crc32(b"The quick brown fox jumps over the lazy dog"):08x}")
    print("{CRC_TABLE[1]:08x} {CRC_TABLE[255]:08x}")
    print(PRIMES)
    print(GREETING)
    const assert(fib(20) == 6765, "fib(20) is {fib(20)}")
    for i in [10, 20, 24] { print("fib({i}) = {nth_fib(i)}") }
    print(const fib(25) + 1)

    var f = FONT
    f[0] = 9
    var g = FONT
    g.fill(7)
    var o = ORIGIN
    o.x = 5
    print("{f} {g} {FONT} {o.x} {ORIGIN.x}")
    let frame = Frame(tag: 1, len: 2)
    print(frame.tag + frame.len as u8)

    var primes = PRIMES
    primes.push(31)
    var names = CONFIG.names
    names.push("c")
    var digits = DIGITS
    print("{primes.len()} {PRIMES.len()} {CONFIG.names} {digits}")
    for x in counter(2) { print(x) }
    var pair = Pair()
    pair.items[0] = 1
    print("{pad(1)} {pair.items} {Pair().items} {id(3)} {id("s")}")
}
