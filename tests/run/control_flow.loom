use std.io.print

fn classify(n: i32) -> str = if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" }

fn collatz(start: u64) -> u32 {
    var n = start
    var steps: u32 = 0
    while n != 1 {
        n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
        steps += 1
    }
    steps
}

fn first_square_over(limit: i32) -> i32 {
    var i = 0
    loop {
        i += 1
        if i * i > limit { break i * i }
    }
}

fn main() {
    print("{classify(-5)} {classify(0)} {classify(9)}")
    print("collatz(27) = {collatz(27)}")
    print("first square over 50: {first_square_over(50)}")

    var found = (0, 0)
    outer: for a in 1..10 {
        for b in 1..10 {
            if a * b == 42 {
                found = (a, b)
                break outer
            }
            if b > a { continue outer }
        }
    }
    print("{found.0} * {found.1} = 42")

    var total = 0
    for i in 0..10 {
        if i % 2 == 1 { continue }
        total += i
    }
    print("even total {total}")

    let temp = 21
    if 18 <= temp < 25 { print("comfy") }
    let (q, r) = (17 / 5, 17 % 5)
    print("17 = 5 * {q} + {r}")
}
