use std.io.print
fn main() {
    var order: Map[str, i32] = Map.of([("a", 1), ("b", 2), ("c", 3)])
    order.update("a", _ + 1)
    order.merge(Map.of([("b", 10), ("a", 10)]), _ + _)
    print(order.keys().join(","))
    print(order.values().join(","))
    var m: Map[str, i32] = Map.of([("a", 1), ("b", 2), ("c", 3)])
    print(m.get_or("z", 9))
    m.update("a", _ + 10)
    print(m.get("a"))
    m.retain((k, v) => v > 2)
    print(m.len())
    var o: Map[str, i32] = Map.of([("c", 100), ("d", 4)])
    m.merge(o, _ + _)
    print(m.get("c"))
    print(m.get("d"))
    let more: List[(str, i32)] = [("e", 5)]
    m.extend(more)
    print(m.len())
    print(m.first().map(_.1))
    print(m.last().map(_.1))
    print(m.remove_entry("d").map(_.1))
    let a: Set[i32] = Set.of([1, 2, 3, 4])
    let b: Set[i32] = Set.of([3, 4, 5])
    print(a.union(b).sorted().join(","))
    print(a.intersection(b).sorted().join(","))
    print(a.difference(b).sorted().join(","))
    print(a.symmetric_difference(b).sorted().join(","))
    print(a.is_subset(b))
    print(a.union(b).is_superset(a))
    print(a.is_disjoint(b))
    var c = a.copy()
    c.retain(_ % 2 == 0)
    print(c.sorted().join(","))
    let more2: List[i32] = [8, 9]
    c.extend(more2)
    print(c.pop())
    print(c.len())
    var q: Map[i32, i32] = Map()
    var qs: Set[i32] = Set()
    for i in 0..40 {
        q.insert(i, i * 10)
        qs.insert(i)
    }
    var popped = 0
    for _ in 0..30 {
        match q.first() {
            some(p) => {
                popped += p.1
                let _ = q.remove(p.0)
            }
            none => {}
        }
        let _ = qs.pop()
    }
    print("{popped} {q.len()} {qs.len()}")
    print(q.keys().join(","))
    print(qs.sorted().join(","))
    q.insert(5, 7)
    print(q.first())
    print(q.last())
    var drained = 0
    while qs.pop().is_some() { drained += 1 }
    print(drained)
}
