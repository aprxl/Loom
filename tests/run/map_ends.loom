// The oldest and the newest entry of a map, and the oldest of a set, after
// every kind of removal; a queue and a stack of 100,000.

use std.io.print

fun word(i: u32) -> String {
    "w{i}"
}

fun ends(m: Map[u32, String]) {
    print("{m.len()} {m.first()} {m.last()}")
}

fun full() -> Map[u32, String] {
    var m: Map[u32, String] = Map()
    for i in 0..6u32 {
        m.insert(i, word(i))
    }
    m
}

fun queue(n: u64) -> u64 {
    var m: Map[u64, u64] = Map()
    for i in 0..n {
        m.insert(i, i * 2)
    }
    var total = 0u64
    while true {
        match m.first() {
            some(p) => {
                total += p.1
                m.remove(p.0)
            }
            none => break
        }
    }
    total
}

fun stack(n: u64) -> u64 {
    var m: Map[u64, u64] = Map()
    for i in 0..n {
        m.insert(i, i * 3)
    }
    var total = 0u64
    while true {
        match m.last() {
            some(p) => {
                total += p.1
                m.remove(p.0)
            }
            none => break
        }
    }
    total
}

fun churn(n: u64) -> u64 {
    // A deep stack with pushes and pops in turn, then a queue over what's
    // left, with new entries behind it.
    var m: Map[u64, u64] = Map()
    for i in 0..1000u64 {
        m.insert(i, i)
    }
    var total = 0u64
    for i in 1000..n + 1000 {
        m.insert(i, i)
        match m.last() {
            some(p) => {
                m.remove(p.0)
                total += p.0
            }
            none => total += 1
        }
    }
    var seen = 0u64
    for i in 0..n {
        match m.first() {
            some(p) => {
                m.remove(p.0)
                m.insert(10_000_000 + i, 0)
                total += p.0 * 2
                seen += 1
            }
            none => break
        }
        if seen == 3000 { break }
    }
    total + m.len() as u64
}

fun mixed(steps: u64) -> u64 {
    // Inserts and removals at both ends and in the middle, in a fixed
    // pseudo-random order; the ends are summed after every step.
    var m: Map[u64, u64] = Map()
    var seed = 12345u64
    var next = 0u64
    var total = 0u64
    for _ in 0..steps {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let r = seed >> 4
        let depth = m.len() as u64
        match r % 7 {
            0 | 1 | 2 => {
                m.insert(next, r)
                next += 1
            }
            3 => {
                match m.first() {
                    some(p) => {
                        m.remove(p.0)
                        total += 5
                    }
                    none => {}
                }
            }
            4 | 5 => {
                match m.last() {
                    some(p) => {
                        m.remove(p.0)
                        total += 5
                    }
                    none => {}
                }
            }
            _ => {
                if next > 0 { m.remove((r >> 8) % next) }
            }
        }
        total += depth
        match m.first() {
            some(p) => total += p.0
            none => total += 1
        }
        match m.last() {
            some(p) => total += p.0 * 3
            none => total += 2
        }
    }
    total + m.len() as u64
}

fun main() {
    var m: Map[u32, String] = Map()
    ends(m)

    m = full()
    ends(m)
    m.remove(0)
    ends(m)
    m.remove(5)
    ends(m)
    m.remove(3)
    ends(m)
    m.remove(1)
    m.remove(4)
    ends(m)
    m.remove(2)
    ends(m)

    // Add again after emptying it, and after a clear.
    m.insert(7, word(7))
    ends(m)
    m.insert(8, word(8))
    ends(m)
    m.clear()
    ends(m)
    m.insert(9, word(9))
    m.insert(10, word(10))
    ends(m)

    // A replaced value keeps the entry where it was.
    m.insert(9, "again")
    ends(m)

    // Enough removals to compact, from both ends.
    m.clear()
    for i in 0..40u32 {
        m.insert(i, word(i))
    }
    for i in 0..15u32 {
        m.remove(i)
        m.remove(39 - i)
    }
    ends(m)
    for i in 15..24u32 {
        m.remove(i)
    }
    ends(m)
    let copied = m.copy()
    ends(copied)
    m.remove(25)
    ends(m)
    ends(copied)

    // The middle goes, the ends stay.
    var mid = full()
    mid.remove(2)
    mid.remove(3)
    ends(mid)
    mid.remove(0)
    ends(mid)
    mid.remove(5)
    ends(mid)

    // A set pops the oldest.
    var s: Set[String] = Set()
    print("{s.pop()}")
    s.insert("a")
    s.insert("b")
    s.insert("c")
    s.remove("a")
    print("{s.pop()} {s.len()}")
    s.insert("a")
    print("{s.pop()} {s.pop()} {s.pop()} {s.len()}")
    for i in 0..30u32 {
        s.insert(word(i))
    }
    for _ in 0..22 {
        s.pop()
    }
    print("{s.pop()} {s.len()}")
    let sc = s.copy()
    s.clear()
    print("{s.pop()} {sc.len()}")

    print("{queue(100_000)}")
    print("{stack(100_000)}")
    print("{churn(20_000)}")
    print("{mixed(30_000)}")
}
