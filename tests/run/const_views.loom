// Constants that are views (`[T]`, `str`) keep what they view, even when
// it's a temporary of the expression that computed them.

use std.io.print

const DIGITS: [u8] = [1, 2, 3, 4][1..3]
const EMPTY: [u32] = [5, 6][2..]
const WORD: str = "hello world"[0..5]
const ARR: [u8; 4] = [9, 8, 7, 6]
const SUB: [u8] = ARR[1..3]

fun main() {
    print(DIGITS)
    var d = DIGITS
    print("{d} {EMPTY} {WORD} {DIGITS.len()} {WORD.len()} {SUB}")
}
