use std.io.print

warp P { name: String, age: i32 }

fun main() {
    var xs: List[i32] = [5, 3, 9, 1, 3, 7, 2, 8, 6, 4, 0, 11, 15, 12, 10, 14, 13]
    xs.sort_by(_ > _)
    print("{xs[0]} {xs[16]} {xs.is_sorted()}")
    xs.sort_by_key(-_)
    print("{xs[0]} {xs[16]}")

    var ps: List[P] = [P(name: "a", age: 2), P(name: "b", age: 1), P(name: "c", age: 2), P(name: "d", age: 1)]
    ps.sort_by_key(_.age)
    for p in ps { print("{p.name}{p.age}") }

    xs.sort()
    print(xs.binary_search(7))
    print(xs.binary_search(100))
    print(xs.lower_bound(100))
    print(xs.upper_bound(3))
    print(xs.lower_bound(3))
    print(xs.partition_point(_ < 6))

    // enough items for several merge passes, with many equal keys
    var big: List[(i32, i32)] = []
    for i in 0..1000 { big.push(((i * 7919) % 13, i)) }
    big.sort_by(_.0 < _.0)
    var stable = true
    for i in 1..big.len() {
        if big[i - 1].0 > big[i].0 or (big[i - 1].0 == big[i].0 and big[i - 1].1 > big[i].1) {
            stable = false
        }
    }
    print(stable)

    let ys: List[i32] = [3, 1, 2, 5, 4]
    print(ys.sorted_by(_ > _).join(","))
    print(ys.sorted().join(","))
    print(ys.sorted_by_key(-_).join(","))
}
