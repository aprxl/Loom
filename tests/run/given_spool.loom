use std.io.print
use std.mem.{Arena, Spool, kib}

warp Node {
    case Leaf(i32)
    case Pair(^Node, ^Node)
}

fun leaf(n: i32) -> ^Node@sp given sp: Spool = ^Node.Leaf(n)

fun tree(depth: i32) -> ^Node@sp given sp: Spool {
    if depth == 0 { return leaf(1) }
    ^Node.Pair(tree(depth - 1), tree(depth - 1))
}

fun count(n: ^Node) -> i32 = match n {
    .Leaf(k) => k
    .Pair(a, b) => count(a) + count(b)
}

fun main() {
    spool a = Arena(1.kib())
    let t = tree(4, given: a)
    print("{count(t)}")
    a.reset()
    let u = tree(3, given: a)
    print("{count(u)}")

    let h = tree(5)
    print("{count(h)}")
}
