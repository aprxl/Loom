use std.io.print
fun main() {
    let xs: List[i32] = [3, 1, 4, 1, 5, 9, 2, 6]
    print(xs.flat_map(x => (0..x)).count())
    var p = xs.peekable()
    print(p.peek())
    print(p.next())
    print(p.next_if(_ == 1))
    print(p.next_if(_ == 1))
    print(xs.cycle().take(10).join(","))
    print(xs.chunks(3).map(_.len()).join(","))
    print(xs.nth(4))
    print(xs.is_empty())
    print((0..3).eq(0..3))
    print(xs.min_by_key(-_))
    print(xs.max_by_key(_ % 5))
    print(xs.min_by(_ < _))
    print(xs.max_by(_ < _))
    let parts = xs.partition(_ > 3)
    print("{parts.0.len()} {parts.1.len()}")
    let c = xs.counts()
    print(c.get(1))
    let g = xs.group_by(_ % 2)
    print(g.get(1).map(_.len()))
    print(xs.filter_map(x => if x % 2 == 0 { some(x * 10) } else { none }).sum())
    print((0..20).step_by(5).join(","))
    print(xs.step_by(3).sum())
    print(xs.rev().join(","))
    print((0..4).rev().join(","))
    print(xs.inspect(x => print("saw {x}")).take(2).sum())
    let names: List[String] = ["a", "bb", "ccc"]
    print(names.filter_map(s => if s.len() > 1 { some(s.len()) } else { none }).join(","))
    let nested: List[?i32] = [some(1), none]
    print(nested.filter_map(x => some(x)).count())
}
