use std.io.print

fn main() {
    print("héllo wörld".to_upper())
    print("ÀÉÎ Straße".to_lower())
    print("Straße".to_upper())
    print('é'.is_alphabetic())
    print('é'.is_ascii_alphabetic())
    print('٣'.is_numeric())
    print('½'.is_numeric())
    print('É'.is_upper())
    print('é'.is_lower())
    print('é'.to_upper())
    print('ß'.to_upper())
    print('Σ'.to_lower())
    print('a'.is_ascii())
    print('é'.is_ascii())
    print("\u{a0}x\u{3000}".trim().len())
    print("\u{a0}x\u{3000}".trim_ascii().len())
    print("  a b  ".trim_start().len())
    print("  a b  ".trim_end().len())
    print("a\u{a0}b  c".words().count())
    print("héllo".to_ascii_upper())
    print("a=b=c".split_once("=").map(_.1))
    print("a=b=c".rsplit_once("=").map(_.0))
    print("a=b=c".rfind("="))
    print("prefix-rest".strip_prefix("prefix-"))
    print("rest.txt".strip_suffix(".txt"))
    print("rest.txt".strip_suffix(".md"))
    print("banana".count_of("an"))
    print("héy".char_indices().map(_.0).join(","))
    print("héy".char_at(1))
    print("xxhixx".trim_matches(c => c == 'x'))
    print("xxxx".trim_matches(c => c == 'x').len())
    print("Hello".eq_ignore_case("hELLO"))
    print("hello".capitalize())
    print("7".pad_left(3, '0'))
    print("ab".pad_right(4, '.'))
    print("héllo".is_ascii())
}
