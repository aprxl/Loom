// A spool: `Arena` hands out pointers that cost nothing to copy, and
// `reset` takes them all back at once.

use std.io.print
use std.mem.{Arena, kib}

warp Particle {
    x: i32
    y: i32
}

fun main() {
    spool frame = Arena(1.kib())
    let p: ^Particle@frame = frame.put(Particle(1, 2))
    let q = p
    print("{p.x} {q.y}")
    print("{p:?}")

    var total = 0
    for i in 0..1000 {
        let r = frame.put(Particle(i, i * 2))
        total += r.x + r.y
    }
    print("{total}")
    frame.reset()
    let s = frame.put(Particle(5, 6))
    print("{s.x}")
}
