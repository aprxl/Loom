// `const` parameters take values known at compile time, of the right type.

use std.io.print

fn sum[const N: usize](xs: [i32; N]) -> i32 = 0
fn both[const N: usize](a: [i32; N], b: [i32; N]) -> i32 = 0
fn pick(const first: bool) -> i32 = 0
fn label(const s: str) -> str = s                        //~ T0101
fn sized(k: usize) -> [u8; k] = [0; k]                   //~ K0105

warp Grid[const W: u8, const H: u8] {
    const assert(W > 0 and H > 0, "an empty grid")      //~ K0101
}

fn main() {
    var k = 3
    print(sum[k]([1, 2, 3]))                             //~ K0109
    print(pick(k > 2))                                   //~ K0109
    print(both([1, 2], [3, 4, 5]))                       //~ T0101
    let a = Grid[u8, 3]()                                //~ T0104
    let b = Grid[300, 1]()                               //~ T0102
    let c: Grid[2, 3] = Grid[3, 2]()                     //~ T0101
    let d = Grid[0, 1]()
    let e: uint(0) = 0                                   //~ T0102
    let f: uint(k) = 1                                   //~ K0109
    let g: int(8) = 128                                  //~ T0102
    print(label("x"))
}
