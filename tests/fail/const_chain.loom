// A constant that fails is reported once. What needs it stops quietly,
// however many things do, rather than reporting the same failure again.

const BAD: u8 = {                                //~ K0103
    var x: u8 = 250
    for _ in 0..10 { x += 1 }
    x
}

const NEEDS: u8 = BAD + 1
const AND_THIS: u8 = NEEDS + BAD
const assert(AND_THIS > 0)

fun uses() -> u8 = const NEEDS

use std.io.print

// Its own, unrelated failure is still reported.
fun two() -> i32 = 2

const assert(two() + 1 == 4, "arithmetic")       //~ K0101

fun main() {
    print(uses())
}
