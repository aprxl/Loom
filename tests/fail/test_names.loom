// Tests aren't in scope: nothing calls one, and two can't share a name.

test twice() {}
test twice() {}                             //~ N0104

// A function may share a test's name.
fun plain() -> i32 = 1
test plain() = assert(plain() == 1)

fun calls() = twice()                        //~ N0101

fun nests() {
    test inner() {}                         //~ S0212
}

fun main() {}
