// A thread holds what it captures by reference until it's joined: nobody
// else may change what it reads, or touch what it changes.

use std.io.print
use std.sync.Spun

fun two_writers() {
    var hits = 0
    loom {
        thread { hits += 1 }
        thread { hits += 1 }                //~ C0401
        ()
    }
    print(hits)
}

fun parent_reads_what_a_thread_writes() {
    var total = 0
    loom {
        let t = thread { total += 1 }
        print(total)                        //~ C0402
        t.join()
    }
}

fun parent_writes_what_a_thread_reads() {
    var n = 5
    loom {
        let t = thread { n + 1 }
        n += 1                              //~ C0402
        t.join()
    }
}

fun a_reader_beside_a_writer() {
    var n = 5
    loom {
        thread { n += 1 }
        thread { print(n) }                 //~ C0402
        ()
    }
}

fun joined_first_is_fine() {
    var total = 0
    loom {
        let t = thread { total += 1 }
        t.join()
        print(total)
    }
}

fun readers_share() {
    let n = 5
    loom {
        let a = thread { n + 1 }
        let b = thread { n + 2 }
        print(a.join() + b.join())
        print(n)
    }
}

fun a_loop_variable_is_copied() {
    loom {
        for i in 0..3 {
            thread { print(i) }
        }
    }
}

fun outside_a_loom() {
    let t = thread 1                        //~ C0403
}

fun handle_as_the_value() {
    let h = loom {
        thread 1                            //~ C0404
    }
}

fun handle_kept_outside() {
    var kept: ?Spun[i32] = none
    loom {
        kept = some(thread 1)               //~ C0404
    }
}

fun a_thread_changes_its_copy() {
    loom {
        for i in 0..2 {
            var n = i
            thread { n += 1 }               //~ C0405
            ()
        }
    }
}

fun a_thread_cant_keep_an_owned_local() {
    loom {
        for i in 0..2 {
            let xs: List[i32] = [i, i]
            let t = thread { xs.len() }     // moved in: it's the thread's
            t.join()
        }
    }
}

fun a_loom_level_owned_local() {
    loom {
        let xs: List[i32] = [1, 2]
        let t = thread { xs.len() }         // moved in: it's the thread's
        t.join()
    }
}

fun a_loom_level_copy_is_fine() {
    loom {
        let k = 3
        let t = thread { k + 1 }
        print(t.join())
    }
}

fun a_borrow_of_a_loom_local() {
    loom {
        let names: List[str] = ["a", "b"]
        for n in names {
            let t = thread { n.len() }      //~ C0405
            t.join()
        }
    }
}

fun a_borrow_of_what_outlives_the_loom_is_fine(names: List[str]) {
    loom {
        for n in names {
            let t = thread { n.len() }
            print(t.join())
        }
    }
}

fun a_lambda_parameter_borrows_a_loom_local() {
    loom {
        let names: List[String] = ["a".to_string(), "bb".to_string()]
        let jobs = names.map(n => thread n.len())       //~ C0405
        for job in jobs {
            print(job.join())
        }
    }
}

fun through_a_stream_over_a_loom_local() {
    loom {
        let text = "a bb ccc".to_string()
        let jobs = text.words().map(w => thread w.len()).collect()      //~ C0405
        for job in jobs {
            print(job.join())
        }
    }
}

fun a_lambda_over_a_slice_of_a_loom_local() {
    loom {
        let names: List[str] = ["a", "bb", "ccc"]
        let rest = names[1..]
        let jobs = rest.map(n => thread n.len())        //~ C0405
        for job in jobs {
            print(job.join())
        }
    }
}

fun a_lambda_over_what_outlives_the_loom_is_fine(names: List[String]) {
    loom {
        let jobs = names.map(n => thread n.len())
        for job in jobs {
            print(job.join())
        }
    }
}

fun numbers_are_copies_of_their_items() {
    loom {
        let xs: List[i32] = [1, 2]
        let jobs = xs.map(x => thread x + 1)
        for job in jobs {
            print(job.join())
        }
    }
}
