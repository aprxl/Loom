use std.io.print

warp AgeError: Error { case Negative }
warp IoError: Error { case Closed }

fun age(n: i32) -> u8 ! AgeError = if n < 0 { fail .Negative } else { 1 }
fun maybe(n: i32) -> ?u8 = none

fun plain(n: i32) -> u8 {
    maybe(n)?                               //~ T0101
}

fun opt(n: i32) -> ?u8 {
    age(n)?                                 //~ T0101
}

fun io(n: i32) -> u8 ! IoError {
    age(n)?                                 //~ T0108
}

fun nothing(n: i32) -> u8 {
    fail .Negative                          //~ T0101
}

fun main() {
    let a = 5?                              //~ T0101
    let b = 5 mend 6                        //~ T0101
    let c = ok(5)                           //~ T0110
    let d = maybe(1) mend "none"            //~ T0101
    let e = match maybe(2) {                //~ P0101
        some(x) => x
    }
    let f = match 5 {
        some(x) => x                        //~ T0101
        _ => 0
    }
    let g: AgeError | IoError = AgeError.Negative
    let h = match g {                       //~ P0101
        x: AgeError => 1
    }
    let i = g is y: u8                      //~ T0101
    print("{g is z: AgeError}")             //~ T0117
}
