// A value that isn't `Copy` has one owner.

warp Named { name: String, tags: List[str] }

fn keep(take s: String) -> String = s

fn give_back(s: String) -> String = s             //~ M0102

fn stash(xs: List[i32]) {
    var mine = xs                                  //~ M0102
    mine.push(1)
}

fn used_after(take s: String) -> String {
    let t = keep(s)
    s.len()                                        //~ M0101
    t
}

fn in_branch(take s: String, b: bool) -> usize {
    if b { keep(s) }
    s.len()                                        //~ M0101
}

fn in_loop(take s: String) {
    for i in 0..3 {
        keep(s)                                    //~ M0101
    }
}

fn from_list(xs: List[String]) -> String {
    var copy: List[String] = List()
    copy.push(xs[0])                               //~ M0103
    copy.pop() mend ""
}

fn loop_item(xs: List[String]) {
    var out: List[String] = List()
    for x in xs { out.push(x) }                    //~ M0102
}

fn pushed(take s: String) -> usize {
    var xs: List[String] = List()
    xs.push(s)
    s.len()                                        //~ M0101
}

fn same[T](take x: T) -> T = x

fn inferred(take s: String) -> usize {
    let t = same(s)
    s.len()                                        //~ M0101
}

fn part(take n: Named) -> List[str] {
    let s = n.name
    let again = n.name                             //~ M0101
    n.tags
}

fn captured(take s: String) {
    [1].map(x => keep(s))                          //~ M0102
}

fn swap(mut a: i32, mut b: i32) {
    let t = a
    a = b
    b = t
}

fn add_to(mut xs: List[i32], ys: [i32]) = xs.extend(ys)

fn with_cb(mut xs: List[i32], cb: () => ()) = cb()

fn guard(take o: ?String) {
    match o {
        some(s) if keep(s).len() > 3 => {}          //~ M0102
        some(s) => { keep(s) }
        none => {}
    }
}

fn main() {
    var n = 1
    var m = 2
    swap(mut n, mut m)
    swap(mut n, mut n)                             //~ M0104
    var xs: List[i32] = [1]
    add_to(mut xs, xs)                             //~ M0104
    var pair = (1, 2)
    swap(mut pair.0, mut pair.1)
    with_cb(mut xs, () => xs.push(2))              //~ M0104
    with_cb(mut xs, () => { let k = n })
}
