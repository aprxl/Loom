// A function needs a body, unless it's in a weft or an `extern` block.

weft Named {
    fun name(self) -> str
}

warp Thing {
    fun size(self) -> i32                    //~ S0213
}

weave Named into Thing {
    fun name(self) -> str                    //~ S0213
}

fun helper(x: i32) -> i32                    //~ S0213

fun main()                                   //~ S0213
