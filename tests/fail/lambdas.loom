// Lambdas and function values used wrongly.

fn apply(f: i32 => i32, x: i32) -> i32 = f(x)

warp Holder { f: i32 => i32 }

// A lambda borrows the variables it uses, so it can't outlive them: it's
// passed as an argument or kept in a local, and that's all.
fn adder(k: i32) -> i32 => i32 {
    x => x + k                               //~ M0106
}

fn kept(k: i32) -> i32 => i32 {
    let f: i32 => i32 = x => x + k
    f                                        //~ M0106
}

fn streamed(xs: List[i32], k: i32) -> Stream[i32] {
    xs.indexed().map(p => p.1 + k)           //~ M0106
}

fn view() -> [i32] {
    let xs: List[i32] = [1, 2, 3]
    xs[0..2]                                 //~ M0106
}

// A view of what the caller owns is fine, and so is a lambda that uses
// nothing of the function's.
fn view_param(xs: [i32]) -> [i32] = xs[0..1]
fn inc() -> i32 => i32 = x => x + 1

fn stored() {
    let k = 5
    let h = Holder(f: x => x + k)            //~ M0106
    var fs: List[i32 => i32] = List()
    for i in 1..=3 { fs.push(x => x * i) }   //~ M0106
    let pair = ((x: i32) => x * k, 1)        //~ M0106
    var g: i32 => i32 = x => x
    for i in 0..3 {
        let j = i * 2
        g = x => x + j                       //~ M0106
    }
    var same: i32 => i32 = x => x
    same = x => x + k
}

fn main() {
    let f = x => x                           //~ T0110
    let g: i32 => i32 = (a, b) => a + b      //~ T0104
    let h = (x: i32) => x * 2
    h(1, 2)                                  //~ T0104
    h(x: 1)                                  //~ T0105
    let n = 5
    n(1)                                     //~ T0106
    apply((x: str) => 1, 2)                  //~ T0101
    apply(x => "no", 2)                      //~ T0101
    [1, 2].each(x => x + 1)                  //~ T0101
}
