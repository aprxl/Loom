// Compile-time code runs before the program does: it can't read the
// program's locals, and control flow can't leave it.

fn twice(n: i32) -> i32 = n * 2

fn f(n: i32) -> i32 {
    let a = const twice(4)
    let b = const twice(n)                               //~ K0105
    for i in 0..3 {
        let c = const {
            if a > 1 { return 0 }                        //~ K0105 K0106
            twice(2)
        }
        let d = const { let k = 5; k + i }               //~ K0105
    }
    let e = const {
        var s = 0
        for i in 0..4 { if i == 2 { break }; s += i }
        s
    }
    a + e
}

fn g() -> ?i32 {
    let x = const { let o: ?i32 = none; o? }             //~ K0106
    x
}

fn numbers(n: i32) ~> i32 {
    for i in 0..n { yield i }
}

const NUMBERS: Shuttle[i32, ()] = numbers(3)             //~ K0108

fn main() {
    let s = const numbers(2)                             //~ K0108
}
