use std.io.print
use std.mem.{Arena, kib}

warp Tag {
    name: String
}

fun label() -> String {
    spool a = Arena(1.kib())
    let t = "nails".to_string().copy(given: a)
    t                                        //~ R0101
}

fun too_early() {
    spool raw = Arena(1.kib())
    let t = "nails".to_string().copy(given: raw)
    raw.reset()
    print("{t}")                             //~ R0102
}

fun tagged() {
    spool a = Arena(1.kib())
    let t = "nails".to_string().copy(given: a)
    let tag = Tag(t)                         //~ R0101
}

fun listed() {
    spool a = Arena(1.kib())
    let t = "nails".to_string().copy(given: a)
    var xs: List[String] = []
    xs.push(t)                               //~ R0101
}

fun main() {
    label()
    too_early()
    tagged()
    listed()
}
