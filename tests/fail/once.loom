// `once` values must be used up exactly once.

pub once warp Tx {
    moves: List[i32] = List()
    pub fun begin() -> Tx = Tx()
    pub fun credit(mut self, amount: i32) = .moves.push(amount)
    pub fun commit(take self, note: str) {
        let Tx(moves) = self
    }
    pub fun rollback(take self) {
        let Tx(_) = self
    }
}

fun forgetful() {
    var tx = Tx.begin()                     //~ L0301
    tx.credit(5_00)
}

fun one_branch(b: bool) {
    let tx = Tx.begin()                     //~ L0301
    if b { tx.rollback() }
}

fun early(b: bool) -> ?i32 {
    let tx = Tx.begin()                     //~ L0301
    if b { return none }
    tx.commit("done")
    some(1)
}

fun thrown_away() {
    Tx.begin()                              //~ L0301
    let _ = Tx.begin()                      //~ L0301
}

fun overwritten() {
    var tx = Tx.begin()                     //~ L0301
    tx = Tx.begin()
    tx.rollback()
}

fun in_loop() {
    for i in 0..3 {
        let tx = Tx.begin()                 //~ L0301
        if i == 1 { continue }
        tx.rollback()
    }
}

// These are fine.
fun tied(b: bool) {
    let tx = Tx.begin()
    if b { tx.rollback() } else { tx.commit("ok") }
    var again = Tx.begin()
    defer again => again.rollback()
    if b { return }
    again.commit("later")
}

fun pass_on(take tx: Tx) = tx.rollback()

fun main() {}
