// Run with loom test projects/lua/tests.loom. Each chunk starts with no
// libraries, and communicates its result using return.

use machine.run
use syntax.LuaError

fun rendered_args(source: str, args: [String]) -> String ! LuaError {
    let bytes = source.bytes().collect()
    let execution = run(bytes, args)?
    var text = String()
    for value in execution.values {
        if not text.is_empty() { text.push('|') }
        text.push_str(execution.render(value))
    }
    text
}

fun rendered(source: str) -> String ! LuaError = rendered_args(source, [])

fun expect_syntax(source: str, fragment: str) {
    match rendered(source) {
        err(error) => {
            assert(error is .Syntax(..), error.message())
            assert(error.message().contains(fragment), error.message())
        }
        ok(value) => unravel("expected syntax error, got {value}")
    }
}

fun expect_runtime(source: str, fragment: str) {
    match rendered(source) {
        err(error) => {
            assert(error is .Runtime(..), error.message())
            assert(error.message().contains(fragment), error.message())
        }
        ok(value) => unravel("expected runtime error, got {value}")
    }
}

test starts_with_an_empty_environment() ! LuaError {
    let source = """
        local initial = _ENV
        answer = 42
        return initial.answer, nil, print, assert, _G, pairs, os, math, string, package, coroutine
        """
    assert(rendered(source)? == "42|nil|nil|nil|nil|nil|nil|nil|nil|nil|nil")
}

test accepts_a_bom_a_shebang_and_mixed_line_endings() ! LuaError {
    let source = "\u{FEFF}#!/usr/bin/lua\r\n--[==[skip\r [=[ nested-looking ]=] ]==]\n\rreturn [=[\r\none\r\ntwo\n\rthree]=]"
    assert(rendered(source)? == "\"one\\ntwo\\nthree\"")
}

test reads_binary_strings_and_escapes() ! LuaError {
    let source = """
        return # 'é', '\\255\\0\\x80', '\\u{{1f9f6}}', '\\z
          x', [==[a]=]b]==], '\\u{{7fffffff}}'
        """
    assert(rendered(source)? ==
        "2|\"\\xff\\x00\\x80\"|\"\\xf0\\x9f\\xa7\\xb6\"|\"x\"|\"a]=]b\"|\"\\xfd\\xbf\\xbf\\xbf\\xbf\\xbf\"")
}

test parses_numerals_and_operator_precedence() ! LuaError {
    let source = """
        return -2^2, 2^3^2, 2^-2, 3 << 1 + 1, .5, 12., 1e2,
               0x1.8p+2, 0xffffffffffffffff, 1 + 2 .. 'ab' .. 4
        """
    assert(rendered(source)? == "-4.0|512.0|0.25|12|0.5|12.0|100.0|6.0|-1|\"3ab4\"")
}

test rounds_hexadecimal_floats() ! LuaError {
    let source = """
        return 0x1p-1074 == 5e-324, 0x1p-1075 == 0, 0x1.0000000000001p-1075 > 0,
               0x1.00000000000008p0 == 1, 0x1.0000000000000801p0 > 1,
               0x1.fffffffffffffp1023 < 0x1p1024
        """
    assert(rendered(source)? == "true|true|true|true|true|true")
}

test integer_arithmetic_wraps_and_divides_towards_negative_infinity() ! LuaError {
    let source = """
        local min = 0x8000000000000000
        return -min == min, min // -1 == min, min % -1, 0x7fffffffffffffff + 1 == min,
               -7 // 3, -7 % 3, 7 // -3, 7 % -3, -7.0 % 3.0, -7.0 // 3
        """
    assert(rendered(source)? == "true|true|0|true|-3|2|-3|-2|2.0|-3.0")
}

test shifts_are_logical_and_allow_negative_counts() ! LuaError {
    let source = "return -1 >> 63, 1 << 63 == 0x8000000000000000, 8 << -2, 2 >> -3, 3 >> 64, 1 << 0x8000000000000000, ~1.0, (7 & 3) ~ (2 | 4)"
    assert(rendered(source)? == "1|true|2|16|0|0|-2|5")
}

test compares_mixed_numbers_without_rounding_the_integer() ! LuaError {
    let source = """
        local nan = 0/0
        return 9007199254740993 > 9007199254740992.0,
            9007199254740993 == 9007199254740992.0,
            0x7fffffffffffffff < 9223372036854775808.0,
            0x8000000000000000 == -9223372036854775808.0,
            -1.5 < -1, -2 < -1.5, nan == nan, nan <= 0, nan >= nan, nan ~= nan
        """
    assert(rendered(source)? == "true|false|true|true|true|true|false|false|false|true")
}

test logical_operators_short_circuit_and_preserve_values() ! LuaError {
    let source = "return nil and missing(), false and missing(), 0 or missing(), '' and 8, not 0, not nil"
    assert(rendered(source)? == "nil|false|0|8|false|true")
}

test table_identity_key_coercion_and_deletion() ! LuaError {
    let source = """
        local key, alias = {{}}
        alias = key
        local function f() end
        local t = {{[1.0] = 'first', [false] = 7, [key] = 8, [f] = 9, [1.5] = 10, [0] = 11}}
        t[1] = nil
        return key == alias, key == {{}}, t[1.0], t[false], t[alias], t[f], t[1.5], t[-0.0], t[nil], t[0/0]
        """
    assert(rendered(source)? == "true|false|nil|7|8|9|10|11|nil|nil")
}

test table_length_returns_a_border() ! LuaError {
    let source = """
        local seq, holes = {{'first', 'second'}}, {{[1]=1,[3]=3,[5]=5}}
        local n = #holes
        return #seq, #{{}}, n == 1 or n == 3 or n == 5, #{{[-1]=1, a=2}}
        """
    assert(rendered(source)? == "2|0|true|0")
}

test closures_keep_the_binding_visible_at_definition() ! LuaError {
    let source = """
        local x = 1
        local function get() return x end
        local function bump() x = x + 1 end
        local x = x + 10
        bump()
        return get(), x
        """
    assert(rendered(source)? == "2|11")
}

test global_references_use_the_lexically_enclosing_environment() ! LuaError {
    let source = """
        x = 1
        local function get() return x end
        local outer = _ENV
        local _ENV = {{x = 2}}
        local function get_inner() return x end
        _ENV = {{x = 3}}
        return get(), get_inner(), outer.x, x
        """
    assert(rendered(source)? == "1|3|1|3")
}

test evaluates_assignment_targets_before_stores() ! LuaError {
    let source = """
        local i, t = 1, {{10, 20}}
        i, t[i] = 2, 30
        local alias = t
        t, t[i] = {{}}, 40
        i, i = 5, 6
        return i, alias[1], alias[2], t[2]
        """
    assert(rendered(source)? == "5|30|40|nil")
}

test call_adjustment_varargs_and_parentheses() ! LuaError {
    let source = """
        local function many(...) return ... end
        local function none() end
        local function pack(a, b, ...) return a, b, ... end
        local a, b, c = many(1, 2, 3)
        local t = {{(many(4, 5)), none(), many(6, 7)}}
        return a, b, c, t[1], t[2], t[3], t[4], pack(many(8,9), (none()), ...)
        """
    let args: List[String] = ["a", "b"]
    assert(rendered_args(source, args)? == "1|2|3|4|nil|6|7|8|nil|\"a\"|\"b\"")
}

test supplies_call_shorthand_and_evaluates_method_receiver_once() ! LuaError {
    let source = """
        local state = {{hits = 0}}
        function state:read(value) return self.hits, value end
        local function receiver()
          state.hits = state.hits + 1
          return state
        end
        local function get(t) return t.value end
        return get {{value = 5}}, receiver():read 'ok'
        """
    assert(rendered(source)? == "5|1|\"ok\"")
}

test loops_handle_break_and_capture_per_iteration_locals() ! LuaError {
    let source = """
        local functions, sum = {{}}, 0
        for i=4,1,-1 do functions[i] = function() return i end end
        while true do
          local previous = sum
          sum = previous + 3
          if sum > 8 then break elseif false then return -1 end
        end
        repeat local done = sum == 7; sum = sum - 1 until done
        return functions[1](), functions[4](), sum
        """
    assert(rendered(source)? == "1|4|6")
}

test numeric_for_uses_lua_conversion_and_does_not_wrap() ! LuaError {
    let source = """
        local count, sum = 0, 0
        for i=0x7ffffffffffffffe, 0x7fffffffffffffff do count = count+1 end
        for i=' 1 ', '0x3', '1' do sum = sum+i end
        for i=1, 2.5 do count = count+i end
        return count, sum
        """
    assert(rendered(source)? == "5|6.0")
}

test generic_for_calls_the_iterator_with_state_and_control() ! LuaError {
    let source = """
        local function next_item(state, i)
          i = i + 1
          if i <= #state then return i, state[i] end
        end
        local function init() return next_item, {{5, 7, 9}}, 0, false end
        local sum = 0
        for i, value in init() do
          sum = sum + i * value
          if i == 2 then break end
        end
        return sum
        """
    assert(rendered(source)? == "19")
}

test goto_unwinds_scopes_and_preserves_captured_cells() ! LuaError {
    let source = """
        local n, old = 0
        ::again::
        local x = n
        n = n + 1
        do
          local scratch = 3
          if n < 3 then
            old = function() return x + scratch end
            goto again
          end
        end
        do
          goto done
          local skipped = true
          ::done::
        end
        return n, x, old()
        """
    assert(rendered(source)? == "3|2|4")
}

test supports_read_only_and_inert_close_attributes() ! LuaError {
    let source = "local x <const> = 7; local y <close> = false; do local z <close>; end; return x, y"
    assert(rendered(source)? == "7|false")
}

test rejects_invalid_source_before_running_any_statement() {
    expect_syntax("missing()\nlocal n <const> = 1\nn = 2", "3:1: syntax error: cannot assign")
    expect_syntax("goto target; local x; ::target:: x = 1", "enters the scope")
    expect_syntax("::x:: do ::x:: end", "duplicate label")
    expect_syntax("do ::target:: end; goto target", "no visible label")
    expect_syntax("::target:: local function f() goto target end", "no visible label")
    expect_syntax("while true do local function f() break end end", "break outside a loop")
    expect_syntax("local function f() return ... end", "outside a variadic function")
    expect_syntax("return 1; local unreachable", "return must end its block")
    expect_syntax("return 1..2", "malformed decimal numeral")
    expect_syntax(r"return '\x0z'", "hexadecimal escape")
    expect_syntax("--[=[ missing", "unfinished long comment")
}

test reports_lua_runtime_errors() {
    expect_runtime("return print('x')", "attempt to call a nil value")
    expect_runtime("local a; return a.x", "attempt to index a nil value")
    expect_runtime("local t = {{}}; t[0/0] = 1", "table index is nil or NaN")
    expect_runtime("return 1 // 0", "integer division by zero")
    expect_runtime("return 3.25 & 7", "no integer representation")
    expect_runtime("return '4' + 2", "expected a number")
    expect_runtime("local x <close> = {{}}", "no '__close' metamethod")
    expect_runtime("for i=1,3,0 do end", "step is zero")
}

test tail_calls_reuse_the_interpreter_stack() ! LuaError {
    let source = """
        local function down(n, sum)
          if n == 0 then return sum, 'done' end
          return down(n - 1, sum + 1)
        end
        return down(6000, 0)
        """
    assert(rendered(source)? == "6000|\"done\"")
}

test collection_keeps_temporaries_table_keys_and_closures_alive() ! LuaError {
    let source = """
        local function churn()
          for i = 1, 500 do
            local t = {{'discard' .. i}}
            t.self = t
            t.f = function() return t end
          end
          return 9
        end
        local function create()
          local x = 5
          return function() return x end
        end
        local key, f, text = {{}}, create(), 'key' .. 8
        local t = {{[key] = 2, [f] = 3, [text] = 4}}
        local function temporary() return {{7}} end
        do
          local dynamic_key = 'reachable only as a key:' .. 123
          t[dynamic_key] = 17
        end
        local shuffled = {{temporary(), churn()}}
        local function retain(a, n) return a[1] + n end
        return shuffled[1][1], t[key], t[f], t['key' .. 8], f(), retain(temporary(), churn()),
               t['reachable only as a key:' .. 123]
        """
    assert(rendered(source)? == "7|2|3|4|5|16|17")
}

test repeat_condition_can_call_after_allocating_its_body_locals() ! LuaError {
    let source = """
        local function check(t)
          for i=1,400 do local unused = {{ i }} end
          return t.value == 3
        end
        local n = 0
        repeat
          n = n + 1
          local t = {{ value = n }}
        until check(t)
        return n
        """
    assert(rendered(source)? == "3")
}
