// Tokens: the words of a text.
//
// A word is a run of ASCII letters, digits and apostrophes, lowercased, with
// the apostrophes at its ends taken off. Every other character separates words.

/// Appends the words of `text` to `out`, in order.
pub fn tokens(text: str, mut out: List[String]) {
    var word: String = ""
    for c in text.chars() {
        if c.is_ascii_alphanumeric() or c == '\'' {
            word.push(c.to_ascii_lower())
        } else if word.len() > 0 {
            keep(word.trim_matches(c => c == '\''), mut out)
            word = ""
        }
    }
    keep(word.trim_matches(c => c == '\''), mut out)
}

/// Pushes `word` onto `out`, unless nothing is left of it.
fn keep(word: str, mut out: List[String]) {
    if word.len() > 0 { out.push(word.to_string()) }
}
