// wordfreq: the words, the runs of words and the totals of some text.
//
//   loom run main.loom -- [--top N] [--ngram N] FILE...
//   loom run main.loom -- [--top N] [--ngram N] < text
//
// With no FILE it reads standard input. --top (default 10) is how many entries
// each list shows, and --ngram (default 2) how many words make a run.

use std.env
use std.fs.read_text
use std.io
use std.io.print
use std.process.exit
use tokens.tokens
use count.{count, ngrams, stats}
use report.top

fun main() {
    let args = env.args()
    var top_n: usize = 10
    var gram: usize = 2
    var files: List[String] = List()
    var i = 1
    while i < args.len() {
        if args[i] == "--top" {
            top_n = flag_number(args, i)
            i += 1
        } else if args[i] == "--ngram" {
            gram = flag_number(args, i)
            i += 1
        } else if args[i].starts_with("--") {
            die("unknown flag {args[i]}")
        } else {
            files.push(args[i].copy())
        }
        i += 1
    }

    var all: List[String] = List()
    var line_count = 0
    var byte_count = 0
    if files.len() == 0 {
        for line in io.lines() {
            line_count += 1
            byte_count += line.len() + 1
            tokens(line, mut all)
        }
    } else {
        for path in files {
            let text = read_text(path) mend e => die("cannot read {path}")
            line_count += text.lines().count()
            byte_count += text.len()
            tokens(text, mut all)
        }
    }

    let counts = count(all)
    let totals = stats(all, counts.len(), line_count, byte_count)
    print("words: {totals.words}")
    print("unique: {totals.unique}")
    print("lines: {totals.lines}")
    print("bytes: {totals.bytes}")
    print("longest: {totals.longest} ({totals.longest.len()})")
    section("top {top_n} words:", top(counts, top_n))
    section("top {top_n} {gram}-grams:", top(ngrams(all, gram), top_n))
}

/// Prints `heading`, then each entry's count right-aligned to the widest
/// count, and its key.
fun section(heading: str, entries: List[(String, u32)]) {
    print(heading)
    if entries.len() == 0 { return }
    let width = "{entries[0].1}".len()
    for entry in entries {
        let shown = "{entry.1}".pad_left(width)
        print("  {shown} {entry.0}")
    }
}

/// The number after the flag at `args[i]`, which must be at least 1.
fun flag_number(args: List[String], i: usize) -> usize {
    let flag = args[i].copy()
    if i + 1 == args.len() { die("{flag} needs a number of at least 1") }
    match args[i + 1].parse[usize]() {
        ok(n) => if n == 0 { die("{flag} needs a number of at least 1") } else { n }
        err(e) => die("{flag} needs a number of at least 1")
    }
}

/// Prints `msg` to standard error as one line, and exits with status 1.
fun die(msg: str) -> never {
    io.eprint("wordfreq: {msg}")
    exit(1)
}
