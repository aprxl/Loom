// Tests for the whole pipeline: text in, text out.
//
// Each test runs a snippet on a fresh heap and compares what it renders to.
// `loom test tests.loom` runs them.

use heap.Heap
use eval.{boot, eval_text}
use printer.render
use errors.LispError

/// Runs `src` on a fresh heap and renders its last value in the `write` form.
fun run(src: str) -> String ! LispError {
    var h = Heap.new(1)
    let global = boot(mut h)?
    let v = eval_text(mut h, global, src)?
    render(h, v, true)
}

test reads_numbers_and_lists() ! LispError {
    assert(run("'(1 2 (3 4) #t #f)")? == "(1 2 (3 4) #t #f)", "round trip")
}

test comments_are_skipped() ! LispError {
    assert(run("; a comment\n(+ 1 ; inline\n 2)")? == "3", "comments")
}

test arithmetic_is_variadic() ! LispError {
    assert(run("(+ 1 2 3 4)")? == "10", "sum")
    assert(run("(- 10 1 2)")? == "7", "difference")
    assert(run("(* 2 3 4)")? == "24", "product")
    assert(run("(- 5)")? == "-5", "negation")
}

test comparisons_chain() ! LispError {
    assert(run("(< 1 2 3)")? == "#t", "increasing")
    assert(run("(< 1 3 2)")? == "#f", "not increasing")
    assert(run("(= 4 4 4)")? == "#t", "equal")
}

test definitions_and_lambdas() ! LispError {
    assert(run("(define (sq x) (* x x)) (sq 12)")? == "144", "define a procedure")
    assert(run("((lambda (a b) (- a b)) 9 4)")? == "5", "anonymous procedure")
}

test closures_keep_their_state() ! LispError {
    let src = """
(define (counter)
  (define n 0)
  (lambda () (set! n (+ n 1)) n))
(define c (counter))
(c)
(c)
(c)
"""
    assert(run(src)? == "3", "a closure remembers its frame")
}

test let_and_letrec() ! LispError {
    assert(run("(let ((a 2) (b 3)) (* a b))")? == "6", "let")
    let mutual = """
(letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1)))))
         (od? (lambda (n) (if (= n 0) #f (ev? (- n 1))))))
  (ev? 10))
"""
    assert(run(mutual)? == "#t", "letrec sees its siblings")
}

test cond_and_or() ! LispError {
    assert(run("(cond ((> 1 2) 'a) ((> 2 1) 'b) (else 'c))")? == "b", "cond")
    assert(run("(cond ((> 1 2) 'a) (else 'c))")? == "c", "else")
    assert(run("(and 1 2 3)")? == "3", "and gives its last value")
    assert(run("(or #f #f 7)")? == "7", "or gives its first true value")
}

test while_runs_to_completion() ! LispError {
    let src = """
(define i 0)
(define total 0)
(while (< i 100) (set! total (+ total i)) (set! i (+ i 1)))
total
"""
    assert(run(src)? == "4950", "sum below 100")
}

test vectors_are_mutable() ! LispError {
    let src = """
(define v (make-vector 3 0))
(vector-set! v 1 42)
(vector-ref v 1)
"""
    assert(run(src)? == "42", "set then read")
    assert(run("(make-vector 2 'x)")? == "#(x x)", "rendering")
}

test strings_join_and_measure() ! LispError {
    assert(run("(string-append \"ab\" \"cd\")")? == "\"abcd\"", "append")
    assert(run("(string-length \"lisp\")")? == "4", "length")
    assert(run("(substring \"spindle\" 2 5)")? == "\"ind\"", "substring")
}

test equal_compares_contents() ! LispError {
    assert(run("(equal? '(1 (2)) (list 1 (list 2)))")? == "#t", "structural")
    assert(run("(eq? '(1) '(1))")? == "#f", "identity")
    assert(run("(eq? 'a 'a)")? == "#t", "symbols are interned")
}

test try_catches_a_failure() ! LispError {
    let src = "(try (lambda () (/ 1 0)) (lambda (msg) msg))"
    assert(run(src)? == "\"division by zero\"", "the handler gets the message")
}

test unbound_names_fail() {
    match run("(nope 1)") {
        ok(_) => assert(false, "an unbound name should fail")
        err(e) => assert(e.message() == "unbound symbol `nope`", "the message names it")
    }
}

test overflow_fails_instead_of_wrapping() {
    match run("(* 4611686018427387904 4)") {
        ok(_) => assert(false, "overflow should fail")
        err(e) => assert(e.message() == "integer overflow", "the message says so")
    }
}

test arity_is_checked() {
    match run("((lambda (x) x) 1 2)") {
        ok(_) => assert(false, "two arguments for one parameter should fail")
        err(e) => assert(e.message() == "a procedure takes 1 argument(s), but got 2", "the message")
    }
}

test random_is_seeded() ! LispError {
    // Two heaps seeded alike roll the same dice.
    assert(run("(random 1000)")? == run("(random 1000)")?, "same seed, same roll")
}

test tail_calls_do_not_grow_the_stack() ! LispError {
    // Far deeper than the non-tail recursion in `deep_recursion_works`, and it still finishes.
    assert(run("(define (up i n) (if (= i n) i (up (+ i 1) n))) (up 0 30000)")? == "30000", "a tail loop")
    let mutual = """
(define (ev? n) (if (= n 0) #t (od? (- n 1))))
(define (od? n) (if (= n 0) #f (ev? (- n 1))))
(ev? 20001)
"""
    assert(run(mutual)? == "#f", "mutual tail calls")
}

test deep_recursion_works() ! LispError {
    let src = """
(define (sum-to n) (if (= n 0) 0 (+ n (sum-to (- n 1)))))
(sum-to 5000)
"""
    assert(run(src)? == "12502500", "non-tail recursion")
}

test tables_store_and_count() ! LispError {
    let src = """
(define t (make-table))
(table-set! t 'a 1)
(table-set! t "a" 2)
(table-set! t 'a 3)
(list (table-ref t 'a 0) (table-ref t "a" 0) (table-ref t 'zz 'none) (table-count t))
"""
    assert(run(src)? == "(3 2 none 2)", "keys are told apart by how they print")
}

test table_entries_are_sorted_by_key() ! LispError {
    let src = """
(define t (make-table))
(table-set! t 'pear 1)
(table-set! t 'apple 2)
(table-entries t)
"""
    assert(run(src)? == "((apple 2) (pear 1))", "entries come out in key order")
}

test read_errors_name_their_line() {
    match run("(+ 1\n  2") {
        ok(_) => assert(false, "a missing paren should fail")
        err(e) => assert(e.message() == "read error: line 2: a list is missing its `)`", "the line is named")
    }
}

test string_and_symbol_primitives() ! LispError {
    assert(run("(string-ref \"lisp\" 1)")? == "\"i\"", "one character")
    assert(run("(string=? \"a\" \"a\")")? == "#t", "string equality")
    assert(run("(symbol->string 'pear)")? == "\"pear\"", "symbol to string")
    assert(run("(string->symbol \"pear\")")? == "pear", "string to symbol")
    assert(run("(list-ref '(x y z) 2)")? == "z", "list-ref")
    assert(run("(code->string 65)")? == "\"A\"", "character from a code")
}

test assert_equal_fails_with_both_sides() {
    match run("(assert-equal 4 (+ 2 3))") {
        ok(_) => assert(false, "4 is not 5")
        err(e) => assert(e.message() == "assert-equal: expected 4, got 5", "both values are named")
    }
}

test queens_counts_solutions() ! LispError {
    assert(run("(queens 4)")? == "2", "four queens have two solutions")
    assert(run("(queens 6)")? == "4", "six queens have four")
}

test macros_get_unevaluated_operands() ! LispError {
    assert(run("(defmacro twice (x) `(+ ,x ,x)) (twice (+ 1 3))")? == "8", "the expansion runs")
    assert(run("(defmacro quoted (f) (list 'quote f)) (quoted (+ 1 2))")? == "(+ 1 2)", "the operand is data")
}

test quasiquote_unquotes_and_splices() ! LispError {
    assert(run("(define n 2) `(1 ,n ,@(list 3 4))")? == "(1 2 3 4)", "unquote and splice")
}

test let_star_is_sequential() ! LispError {
    assert(run("(let* ((a 2) (b (* a 3)) (a (+ a b))) (list a b))")? == "(8 6)", "each binding sees the ones before")
}

test named_let_loops() ! LispError {
    assert(run("(let loop ((i 0) (acc 1)) (if (= i 5) acc (loop (+ i 1) (* acc 2))))")? == "32", "a named let loops")
    assert(run("(let loop ((n 3)) (if (= n 0) 'done (loop (- n 1))))")? == "done", "and ends")
}

test case_picks_by_value() ! LispError {
    assert(run("(case 3 ((1 2) 'low) ((3 4) 'mid) (else 'high))")? == "mid", "a datum matches")
    assert(run("(case 9 ((1 2) 'low) (else 'high))")? == "high", "else catches the rest")
    assert(run("(case \"x\" ((\"x\") 'text) (else 'none))")? == "none", "case uses eqv?: strings differ")
    assert(run("(cond ((equal? \"x\" \"x\") 'text) (else 'none))")? == "text", "cond with equal? compares contents")
}

test when_runs_on_true_only() ! LispError {
    assert(run("(when (> 2 1) 'yes)")? == "yes", "true runs the body")
    assert(run("(when #f 'yes)")? == "()", "false gives ()")
}

test list_helpers_work() ! LispError {
    assert(run("(take 2 (drop 1 '(a b c d)))")? == "(b c)", "take and drop")
    assert(run("(zip '(1 2) '(x y))")? == "((1 x) (2 y))", "zip")
    assert(run("(flatten '(1 (2 (3))))")? == "(1 2 3)", "flatten")
    assert(run("(member 2 '(1 2 3))")? == "(2 3)", "member")
}
