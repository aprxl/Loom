use std.io.print

fun sum(xs: [i32]) -> i32 {
    var total = 0
    for x in xs {
        total += x
    }
    total
}

fun main() {
    let data = [3, 1, 4, 1, 5, 9, 2, 6]

    // `thread` starts a thread; `join` waits for its result. Both threads
    // read `data` where it is: nothing is copied, and nothing is shared
    // by reference counting.
    let total = loom {
        let left = thread sum(data[..4])
        let right = thread sum(data[4..])
        left.join() + right.join()
    }
    print("total {total}")
}
//@ run
