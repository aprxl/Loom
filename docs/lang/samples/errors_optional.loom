use std.io.print

fun find(xs: [i32], target: i32) -> ?usize {
    for (i, x) in xs.indexed() {
        if x == target { return some(i) }
    }
    none
}

// A plain value converts to `?i32` by itself.
fun halve(n: i32) -> ?i32 {
    if n % 2 == 0 { n / 2 } else { none }
}

fun main() {
    let xs = [3, 5, 8, 9]
    print("{find(xs, 8):?} {find(xs, 4):?}")
    print("{halve(10):?} {halve(7):?}")

    // `?T` has methods of its own.
    print("{halve(10).map(_ + 1):?} {halve(10).filter(_ > 9):?}")
    print("{halve(7).is_none()} {halve(10).ok_or("odd"):?}")

    // `match` takes it apart; `is` binds, and `and` sees the binding.
    match find(xs, 5) {
        some(i) => print("5 is at {i}")
        none => print("no 5")
    }
    if find(xs, 9) is some(k) and k > 2 {
        print("9 is late, at {k}")
    }
}
//@ run
