use std.io.print

// A weft's function with no `self` is called on the type.
weft From[T] {
    fun from(take x: T) -> Self
}

warp Meters { v: u32 }

weave From[u32] into Meters { fun from(take x: u32) -> Meters = Meters(v: x) }
weave From[str] into Meters { fun from(take x: str) -> Meters = Meters(v: x.len() as u32) }

// A bound picks the weaving in generic code.
fun make[T: From[U], U](x: U) -> T = T.from(x)

fun main() {
    // The argument's type says which one.
    print(Meters.from(3_u32).v)
    print(Meters.from("seven").v)
    print(make[Meters, str]("abcd").v)
    // With the type the result goes to, the weft can be named.
    let m: Meters = From[u32].from(9_u32)
    print(m.v)
}
//@ run
