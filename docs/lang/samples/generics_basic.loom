use std.io.print

// `T` is a type parameter. `Ord + Copy` are bounds: T must be orderable and copyable.
fun largest[T: Ord + Copy](xs: [T]) -> ?T {
    var best: ?T = none
    for x in xs {
        if best is some(b) and b >= x { continue }
        best = x
    }
    best
}

// Two parameters, no bounds: the body only moves values around.
fun swap[A, B](pair: (A, B)) -> (B, A) = (pair.1, pair.0)

// A `where` clause says the same as a bound, after the signature.
fun twice[T](x: T) -> String where T: Show = "{x}{x}"

fun main() {
    // The compiler infers T from the arguments...
    print(largest([3, 9, 4]))
    print(largest(["pear", "apple"]))
    print(largest([2.5, 0.5]))
    print(swap((1, "one")))
    print(twice(42))

    // ...or you give it in brackets.
    print(largest[i32]([]))
    print("{"300".parse[u16]():?}")
    let empty = List[str]()
    print(empty.len())
}
//@ run
