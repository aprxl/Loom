pub once warp Tx {
    moves: List[i32] = List()

    pub fun begin() -> Tx = Tx()
    pub fun commit(take self) {
        let Tx(moves) = self
    }
    pub fun rollback(take self) {
        let Tx(_) = self
    }
}

fun forgetful(early: bool) {
    let tx = Tx.begin()
    if early { tx.commit() }
}

fun main() {}
