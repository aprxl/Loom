use std.io.print

fun main() {
    // `List[T]` grows. A literal becomes a list where a list is expected.
    var xs: List[i32] = [5, 3, 8]
    xs.push(1)                               // add at the end
    xs.insert(0, 9)                          // add at a position
    print("{xs} len {xs.len()} first {xs.first():?} last {xs.last():?}")

    print("{xs.pop():?} {xs.remove(0)} {xs}")

    xs.extend([4, 4, 7, 7, 7])               // add many at once
    xs.dedup()                               // collapse runs of equal items
    xs.sort()
    print(xs)

    xs.retain(_ != 4)                        // keep what the lambda likes
    xs.truncate(3)
    print(xs)

    // Searching and getting.
    print("{xs.contains(8)} {xs.index_of(8):?} {xs.get(99):?}")

    // A list of a given size, and a copy that is independent.
    var row = List.filled(0, 4)
    let backup = row.copy()
    row[2] = 7
    print("{row} {backup}")

    // Not every list is full of numbers.
    var names: List[String] = List()
    names.push("ada")
    names.push("grace")
    print("{names} {names.len()}")
}
//@ run
