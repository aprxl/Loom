use std.io.print

// Every field is `Copy`, so a `Point` is too.
warp Point: Show {
    x: i32
    y: i32
}

// A `String` owns its text, so a `Person` moves.
warp Person: Show {
    name: String
    age: u8
}

fun main() {
    let a = Point(1, 2)
    var b = a                       // a copy: two separate points
    b.x = 10
    print("{a} {b}")

    let p = Person("ann", 30)
    let q = p                       // a move: `q` owns it now
    print(q)
}
//@ run
