use std.io.print

fun main() {
    // `if` is an expression, so it can be a value.
    let n = 27
    let parity = if n % 2 == 0 { "even" } else { "odd" }
    print("{n} is {parity}")

    // `for` goes over a range, an array, a list, a stream...
    var total = 0
    for i in 1..=4 { total += i }              // 1..=4 includes the 4
    for i in 0..3 { total += i }               // 0..3 stops before the 3
    print(total)

    for (i, name) in ["a", "b", "c"].indexed() {
        print("{i}={name}")
    }

    // `while` checks first; `loop` runs until it is told to `break`.
    var x = n
    var steps = 0
    while x != 1 {
        x = if x % 2 == 0 { x / 2 } else { 3 * x + 1 }
        steps += 1
    }
    print("collatz: {steps}")

    // `break` can carry the loop's value.
    let found = loop {
        steps += 1
        if steps % 7 == 0 { break steps }
    }
    print(found)

    // A label names a loop, so `break` and `continue` can reach past the inner one.
    outer: for row in 0..3 {
        for col in 0..3 {
            if col == 2 { continue outer }
            if row == 2 { break outer }
            print("{row},{col}")
        }
    }

    // Comparisons chain: `0 <= x < width` means `0 <= x and x < width`.
    let width = 10
    let px = 4
    if 0 <= px < width { print("in range") }
}
//@ run
