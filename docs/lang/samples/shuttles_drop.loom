use std.io.print

fun naturals(name: str) ~> u32 {
    defer print("{name}: closed")
    var i = 1
    loop {
        yield i
        i += 1
    }
}

fun main() {
    // `take(3)` stops after three; dropping the rest runs the defer.
    let firsts = naturals("a").take(3).collect()
    print(firsts)

    // So does a `break` out of a loop.
    for n in naturals("b") {
        if n > 2 { break }
        print(n)
    }
    print("end of main")
}
//@ run
