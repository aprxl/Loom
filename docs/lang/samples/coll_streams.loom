use std.io.print

fun main() {
    let xs = [4, 8, 15, 16, 23, 42]

    // Adapters give another stream: nothing happens yet.
    print((1..=20).filter(_ % 2 == 0).map(n => n * n).take(4).collect())
    print(xs.skip(2).step_by(2).collect())
    print(xs.take_while(_ < 16).collect())
    print((1..=3).chain(7..=9).collect())
    print((1..=3).flat_map(n => (1..=n)).collect())
    print(xs.zip(xs.skip(1)).map(p => p.1 - p.0).collect())
    print(xs.windows(2).map(w => w[1] - w[0]).collect())
    for (i, line) in "a\nb\nc".lines().indexed() {
        print("{i}: {line}")
    }

    // Consumers run the stream and give back one answer.
    print("{xs.fold(0, (acc, x) => acc + x)} {xs.sum()} {xs.reduce(_ + _):?}")
    print("{xs.max():?} {xs.min():?} {xs.count()} {xs.last():?}")
    print("{xs.all(_ > 3)} {xs.exists(_ > 40)} {xs.find(_ > 10):?} {xs.position(_ == 15):?}")
    print("{["a", "b", "c"].join("-")}")
    xs.each(x => print("item {x}"))
}
//@ run
