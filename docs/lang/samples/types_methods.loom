use std.io.print

warp Point: Show {
    x: f64 = 0
    y: f64 = 0

    const UNIT = Point(1, 0)                 // an associated constant

    // A method takes `self`. `.x` is `self.x`.
    fun len(self) -> f64 = (.x * .x + .y * .y).sqrt()

    // `mut self` may change the value it is called on.
    fun shift(mut self, dx: f64) { .x += dx }

    // No `self`: an associated function, called on the type.
    fun origin() -> Point = Point()
    fun polar(r: f64, angle: f64) -> Point = Point(r * angle.cos(), r * angle.sin())
}

fun main() {
    let p = Point(3, 4)
    print("{p.len()} {Point.origin()} {Point.UNIT} {Point.polar(2, 0)}")

    var moving = Point()
    moving.shift(2.5)                        // `moving` is a var, so it may change
    print(moving)

    // A dot-block opens a scope where `.x` means the block's subject.
    // On a `let` it gives back an edited copy...
    let moved = p.{ .x += 10 }
    print("{moved} {p}")

    // ...and on a `var` it edits in place and yields `()`.
    moving.{ .x = 1; .y = 1 }
    print(moving)

    // Where a type is expected, a leading dot names one of its members.
    let start: Point = .UNIT
    print(start)
}
//@ run
