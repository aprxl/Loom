use std.io.print

weft Widget {
    fun name(self) -> String
    fun width(self) -> u16 = 1
}

warp Label: Widget {
    text: String
    fun name(self) -> String = "label '{.text}'"
    fun width(self) -> u16 = .text.len() as u16
}

warp Spacer: Widget {
    fun name(self) -> String = "spacer"
}

fun main() {
    // `any Widget` holds a value of some type that weaves Widget.
    // The list mixes types, and calls go through a table at run time.
    let ui: List[any Widget] = [Label("hi"), Spacer(), Label("there")]

    var total: u16 = 0
    for w in ui {
        print(w.name())
        total += w.width()
    }
    print("total width {total}")
}
//@ run
