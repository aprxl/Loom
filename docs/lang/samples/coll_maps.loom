use std.io.print

fun main() {
    // A map literal has `key: value` pairs. `[:]` is the empty one.
    var ages: Map[str, u8] = ["ada": 36, "alan": 41]
    ages["grace"] = 85                       // adds a key
    ages["ada"] = 37                         // replaces a value
    print("{ages} {ages.len()}")

    // `m[k]` unravels when the key is missing; `get` gives an optional.
    print("{ages["alan"]} {ages.get("nobody"):?} {ages.has("ada")}")
    print("{ages.get_or("nobody", 0)}")

    // Going through a map follows the order keys were first added.
    for (name, age) in ages {
        print("{name} is {age}")
    }
    print("{ages.keys().collect()} {ages.values().sum()}")

    // `remove` gives back what was there.
    print("{ages.remove("alan"):?} {ages.remove("alan"):?} {ages}")

    // Sorting is explicit.
    ages["bob"] = 20
    print(ages.sorted())

    // An empty map needs its type from somewhere.
    var seen: Map[i32, bool] = [:]
    seen[7] = true
    print(seen)

    print(ages["zed"])
}
//@ unravel
