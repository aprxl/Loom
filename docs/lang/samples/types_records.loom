use std.io.print

warp Point: Show {                           // `Show` is derived: nothing to write
    x: f64 = 0                               // fields can have defaults
    y: f64 = 0
}

warp Window: Show {
    title: String
    width: u32 = 800
    height: u32 = 600
}

// A tuple warp: positional fields, no names. Handy for newtypes.
warp Meters(f64)

fun main() {
    let p = Point(3, 4)                      // construction is a call
    let q = Point(y: 2)                      // named; x takes its default
    let origin = Point()                     // everything defaults
    print("{p} {q} {origin}")

    let w = Window("notes", height: 480)     // positional, then named
    print(w)

    // A named argument with nothing after the colon passes the variable of that name.
    let x = 10.0
    let y = 20.0
    let moved = Point(x:, y:)
    print(moved)

    // A pattern takes a record apart. (`Point(x:, y:)` would bind `x` and `y`.)
    let Point(x: px, y: py) = p
    let Point(x: a, y: b) = moved
    print("{px} {py} {a} {b}")

    // Fields are read with a dot.
    print("{w.title} is {w.width}x{w.height}")

    // A tuple warp's fields are numbered. `{m:?}` is the debug form.
    let m = Meters(5.5)
    print("{m:?} {m.0}")
}
//@ run
