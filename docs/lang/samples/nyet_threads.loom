fn slow_sum(xs: [i32]) -> i32 {
    var total = 0
    for x in xs { total += x }
    total
}

fn main() {
    let left = [1, 2, 3]
    let right = [4, 5, 6]
    let (a, b) = loom {
        let x = thread slow_sum(left)
        let y = thread slow_sum(right)
        (x.join(), y.join())
    }
}
