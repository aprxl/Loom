use std.io.print

fun main() {
    // Any width from 1 to 64 bits: `u12` and `i24` are ordinary types.
    let a: u12 = 4095
    let b: u4 = 15
    let c: i24 = -8_000_000
    print("{a} {b} {c}")

    // Literals: separators, other bases, a suffix to pick the type.
    print("{1_000_000} {0xFF} {0o755} {0b1010_0110} {255u8} {2.5f32} {1e3}")

    // The only implicit conversion is lossless widening.
    let small: u8 = 200
    let wide: u16 = small
    let signed: i32 = small
    print("{wide} {signed}")

    // Integer division truncates toward zero; floats are separate.
    print("{7 / 2} {-7 / 2} {-7 % 3} {7.0 / 2.0}")
    print("{(2.0).sqrt():.4} {10.pow(3)} {(-5).abs()} {3.7 as i32} {7 as f64 / 2.0}")

    // Methods live on the numbers themselves.
    let flags: u8 = 0b1010_0110
    print("{flags & 0x0F} {flags | 1} {flags ~ 0xFF} {flags >> 4} {flags.count_ones()}")
}
//@ run
