// Iterator chains: `filter`, `map`, `take_while`, `sum`.
use std.io.print

const SIZE = 3_000_000

fn main() {
    var total = 0u64
    for round in 0..5u64 {
        total += (0..SIZE as u64)
            .filter(_ % 3 != 0)
            .map(x => x * 2 + round)
            .take_while(_ < 5_000_000)
            .sum()
    }
    print(total)
}
