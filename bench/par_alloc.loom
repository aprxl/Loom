// Allocating and freeing in parallel: each row builds and drops trees of
// small lists, and strings (the allocator benchmark of design/vm.md §11.4;
// LOOM_THREADS=n picks the workers).

use std.io.print
use std.sync.Atomic

warp Tree { kids: List[Tree] }

fun make(depth: u32) -> Tree {
    if depth == 0 { return Tree(kids: List()) }
    Tree(kids: [make(depth - 1), make(depth - 1)])
}

fun count(t: Tree) -> u64 {
    var n = 1u64
    for k in t.kids { n += count(k) }
    n
}

fun row(y: i32) -> u64 {
    var total: u64 = 0
    for k in 0..40 {
        total += count(make(8))
        let s = "row {y} item {k}"
        total += s.len() as u64
    }
    total
}

fun main() {
    let total = Atomic[u64](0)
    loom for y in 0..256 {
        total.add(row(y))
    }
    print("total {total.load()}")
}
