// A slot taken from a pool and given back, over and over.
use std.io.print
use std.mem.Pool

const SIZE = 1_000_000

fun main() {
    spool slots = Pool[u64](4)
    var total = 0u64
    for i in 0..SIZE as u64 {
        let p = slots.put(i)
        total += p^
        slots.free(p)
    }
    print("{total}")
}
