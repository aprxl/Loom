// Arrays, bounds checks and integer loops: the sieve of Eratosthenes.
use std.io.print

const SIZE = 10_000_000

fun main() {
    var composite = List.filled(false, SIZE + 1)
    var count = 0
    for i in 2..=SIZE {
        if not composite[i] {
            count += 1
            var j = i * i
            while j <= SIZE {
                composite[j] = true
                j += i
            }
        }
    }
    print(count)
}
