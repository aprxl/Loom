// Allocating and freeing: binary trees, built and checked, many times.
use std.io.print

const SIZE = 16

// A node with no children, or with two.
warp Tree { kids: List[Tree] }

fun make(depth: u32) -> Tree {
    if depth == 0 { return Tree(kids: List()) }
    Tree(kids: [make(depth - 1), make(depth - 1)])
}

fun check(t: Tree) -> u32 {
    var n = 1u32
    for k in t.kids { n += check(k) }
    n
}

fun main() {
    let max_depth = SIZE
    let stretch = make(max_depth + 1)
    print("stretch tree of depth {max_depth + 1}\t check: {check(stretch)}")
    let long_lived = make(max_depth)
    var depth = 4u32
    while depth <= max_depth {
        let iterations = 1u32 << (max_depth - depth + 4)
        var total = 0u32
        for _ in 0..iterations { total += check(make(depth)) }
        print("{iterations}\t trees of depth {depth}\t check: {total}")
        depth += 2
    }
    print("long lived tree of depth {max_depth}\t check: {check(long_lived)}")
}
