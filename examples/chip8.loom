// chip8.loom: a CHIP-8 interpreter core.
//
// CHIP-8 is a 1970s virtual machine with 4 KiB of memory, sixteen 8-bit
// registers, and 35 two-byte opcodes. It's a good fit for Loom's
// "the machine stays visible" features:
//
//   - twill patterns decode instructions (0x8xy4 binds x: u4 and y: u4)
//   - bit-precise ints: 12-bit addresses (u12) and 4-bit register indices (u4)
//   - indexing [u8; 16] with a u4 needs no bounds check, and the compiler knows it
//   - the overflow policy is in the operator: +% wraps, -| saturates, +? checks

use std.io.print
use std.{env, fs, term, time}
use std.rand.Rng

const FONT_AT: u12 = 0x050
const PROGRAM_AT: u12 = 0x200

/// The built-in hex digit sprites, 0 to F, 5 bytes each.
const FONT: [u8; 80] = [
    0xF0, 0x90, 0x90, 0x90, 0xF0,  0x20, 0x60, 0x20, 0x20, 0x70,   // 0 1
    0xF0, 0x10, 0xF0, 0x80, 0xF0,  0xF0, 0x10, 0xF0, 0x10, 0xF0,   // 2 3
    0x90, 0x90, 0xF0, 0x10, 0x10,  0xF0, 0x80, 0xF0, 0x10, 0xF0,   // 4 5
    0xF0, 0x80, 0xF0, 0x90, 0xF0,  0xF0, 0x10, 0x20, 0x40, 0x40,   // 6 7
    0xF0, 0x90, 0xF0, 0x90, 0xF0,  0xF0, 0x90, 0xF0, 0x10, 0xF0,   // 8 9
    0xF0, 0x90, 0xF0, 0x90, 0x90,  0xE0, 0x90, 0xE0, 0x90, 0xE0,   // A B
    0xF0, 0x80, 0x80, 0x80, 0xF0,  0xE0, 0x90, 0x90, 0x90, 0xE0,   // C D
    0xF0, 0x80, 0xF0, 0x80, 0xF0,  0xF0, 0x80, 0xF0, 0x80, 0x80,   // E F
]

/// Keyboard layout: chip key k is typed as KEYMAP[k].
///   1 2 3 C        1 2 3 4
///   4 5 6 D   ←    q w e r
///   7 8 9 E        a s d f
///   A 0 B F        z x c v
const KEYMAP = "x123qweasdzc4rfv"

pub warp Fault: Error {
    case UnknownOpcode(op: u16, at: u12)
    case StackOverflow(at: u12)
    case StackUnderflow(at: u12)
}

pub warp LoadError: Error {
    case TooBig(bytes: usize)
}

pub warp Chip8 {
    mem:    [u8; 4096]   = [0; 4096]    // 4 KiB → every u12 is a valid address: no bounds checks
    pub(get) v: [u8; 16] = [0; 16]      // V0..VF, always indexed by a u4
    i:      u12          = 0
    pc:     u12          = PROGRAM_AT
    stack:  [u12; 16]    = [0; 16]
    sp:     u4           = 0            // 16 stack slots → a 4-bit stack pointer
    delay:  u8           = 0
    sound:  u8           = 0
    pub(get) screen: [u64; 32] = [0; 32]   // 64×32 pixels: one u64 per row, one bit per pixel
    pub keys: u16        = 0            // bit k set = key k held
    rng:    Rng          = Rng.seeded(0x10AD)

    pub fn load(rom: [u8]) -> Chip8 ! LoadError {
        if rom.len() > 4096 - PROGRAM_AT { fail .TooBig(rom.len()) }
        Chip8().{
            .mem[FONT_AT..][..FONT.len()].copy_from(FONT)
            .mem[PROGRAM_AT..][..rom.len()].copy_from(rom)
        }
    }

    /// Fetch, advance, execute.
    pub fn step(mut self) ! Fault {
        let op: u16 = .mem[.pc] << 8 | .mem[.pc +% 1]   // u8 operands widen to u16 *before* the shift
        .pc +%= 2
        .exec(op)
    }

    /// Execute one opcode. Each twill pattern captures exactly the bits it names.
    pub fn exec(mut self, op: u16) ! Fault {
        let here = .pc -% 2
        match op {
            0x00E0 => .screen = [0; 32]
            0x00EE => {
                .sp = .sp -? 1 mend fail .StackUnderflow(here)
                .pc = .stack[.sp]
            }
            0x0nnn => {}                                   // SYS addr: ignored by modern interpreters
            0x1nnn => .pc = n                              // n: u12, same type as pc
            0x2nnn => {
                .stack[.sp] = .pc
                .sp = .sp +? 1 mend fail .StackOverflow(here)
                .pc = n
            }
            0x3xkk => if .v[x] == k { .pc +%= 2 }         // x: u4, k: u8
            0x4xkk => if .v[x] != k { .pc +%= 2 }
            0x5xy0 => if .v[x] == .v[y] { .pc +%= 2 }
            0x6xkk => .v[x] = k
            0x7xkk => .v[x] +%= k                         // no carry flag for 7XKK
            0x8xy0 => .v[x] = .v[y]
            0x8xy1 => .v[x] |= .v[y]
            0x8xy2 => .v[x] &= .v[y]
            0x8xy3 => .v[x] ~= .v[y]                       // `~` is xor
            0x8xy4 => {
                // The pattern is 9 bits wide, so the addition happens in u9:
                // the carry lands in `c`, the low byte in `s`.
                let 0bc_ssss_ssss = .v[x] + .v[y]
                .v[x] = s
                .v[0xF] = c                                // set the flag last: x may be F
            }
            0x8xy5 => {
                // 0x100 + Vx - Vy never leaves 1..=511. Bit 8 survives exactly when there's no borrow.
                let 0bn_dddd_dddd = 0x100 + .v[x] - .v[y]
                .v[x] = d
                .v[0xF] = n
            }
            0x8xy7 => {
                let 0bn_dddd_dddd = 0x100 + .v[y] - .v[x]
                .v[x] = d
                .v[0xF] = n
            }
            0x8xy6 => {
                let 0brrrr_rrrl = .v[x]                    // split off the bit that falls out
                .v[x] = r                                  // r: u7 widens to u8
                .v[0xF] = l
            }
            0x8xyE => {
                let 0bmrrr_rrrr = .v[x]
                .v[x] = r << 1                             // r widens to u8 first, so nothing is lost
                .v[0xF] = m
            }
            0x9xy0 => if .v[x] != .v[y] { .pc +%= 2 }
            0xAnnn => .i = n
            0xBnnn => .pc = n +% .v[0]                     // u8 widens to u12 and the sum wraps at 4 KiB
            0xCxkk => .v[x] = .rng.byte() & k
            0xDxyn => .draw(.v[x], .v[y], rows: n)
            0xEx9E => if .held(.v[x]) { .pc +%= 2 }
            0xExA1 => if not .held(.v[x]) { .pc +%= 2 }
            0xFx07 => .v[x] = .delay
            0xFx0A => {                                    // wait for a key: re-run until one is held
                if .keys == 0 { .pc = here } else { .v[x] = .keys.trailing_zeros() as u8 }
            }
            0xFx15 => .delay = .v[x]
            0xFx18 => .sound = .v[x]
            0xFx1E => .i +%= .v[x]
            0xFx29 => .i = FONT_AT + (.v[x] as% u4) * 5    // sprite for the low hex digit of Vx
            0xFx33 => {                                    // binary-coded decimal
                let n = .v[x]
                .mem[.i] = n / 100
                .mem[.i +% 1] = n / 10 % 10
                .mem[.i +% 2] = n % 10
            }
            0xFx55 => for r in 0..=x { .mem[.i +% r] = .v[r] }
            0xFx65 => for r in 0..=x { .v[r] = .mem[.i +% r] }

            // Delete this arm and the compiler lists the bit patterns nobody handles.
            _ => fail .UnknownOpcode(op, at: here)
        }
    }

    /// XOR an 8-pixel-wide sprite onto the screen. VF = 1 if any lit pixel was switched off.
    fn draw(mut self, x: u8, y: u8, rows: u4) {
        .v[0xF] = 0
        for r in 0..rows {
            let row = (y +% r) as% u5                      // 32 rows → a u5 index, no bounds check
            let sprite: u64 = .mem[.i +% r] << 56          // widen, then move to the left edge
            let line = sprite.rotate_right(x as% u6)       // wrap around the 64 columns
            if .screen[row] & line != 0 { .v[0xF] = 1 }    // `&` binds tighter than `!=`
            .screen[row] ~= line
        }
    }

    fn held(self, key: u8) -> bool = .keys >> (key as% u4) & 1 == 1

    /// Call at 60 Hz.
    pub fn tick(mut self) {
        .delay -|= 1                                       // saturating: stops at 0 on its own
        .sound -|= 1
    }
}

const assert(FONT.len() == 16 * 5, "one 5-byte sprite per hex digit")

// ---------------------------------------------------------------- frontend

fn render(screen: [u64; 32]) {
    var out = String.with_capacity(32 * 65)
    for row in screen {
        for col in 0..64 {
            out.push(if row >> (63 - col) & 1 == 1 { '█' } else { ' ' })
        }
        out.push('\n')
    }
    print("\x1b[H{out}")                                   // cursor home, then the frame
}

fn main() ! any Error {
    let path = env.args().get(1) mend unravel("usage: chip8 <rom>")
    var cpu = Chip8.load(fs.read(path)?)?                  // IoError and LoadError both widen to `any Error`

    term.raw_mode(true)
    defer term.raw_mode(false)                             // restore the terminal however we leave

    loop {
        cpu.keys = term.poll_keys(KEYMAP)
        for _ in 0..11 { cpu.step()? }                     // ~660 instructions per second
        cpu.tick()
        render(cpu.screen)
        time.sleep(16.ms())
    }
}

// ---------------------------------------------------------------- tests

#test
fn add_sets_carry() ! Fault {
    var c = Chip8().{ .v[1] = 200; .v[2] = 100 }
    c.exec(0x8124)?                                        // V1 += V2
    assert(c.v[1] == 44 and c.v[0xF] == 1)                 // 300 = 0x12C → 0x2C, carry 1
}

#test
fn sub_sets_not_borrow() ! Fault {
    var c = Chip8().{ .v[3] = 5; .v[4] = 9 }
    c.exec(0x8345)?                                        // V3 -= V4
    assert(c.v[3] == 252 and c.v[0xF] == 0)                // borrowed → VF = 0
}

#test
fn call_and_return() ! Fault {
    var c = Chip8()
    c.exec(0x2ABC)?
    assert(c.pc == 0xABC and c.sp == 1)
    c.exec(0x00EE)?
    assert(c.pc == PROGRAM_AT and c.sp == 0)
}
