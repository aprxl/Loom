// calc.loom: an expression compiler whose trees live in arenas.
//
// Shows: spools and region-typed pointers (^T@s), `given` for the ambient
// allocator, a `ref warp` that holds a borrow, a Pratt parser, a tree-to-tree
// pass that copies between spools, and what the region checker rejects.
//
//   parsed: ((2 * (x + 3)) - (-(4 / 2) * 1.5))
//   folded: ((2 * (x + 3)) - -3)
//   value:  17

use std.io.print
use std.fmt.{Show, Fmt}
use std.mem.{Arena, Spool, kib}
use std.num.NumError

// ---------------------------------------------------------------- the tree

warp Op {
    case Add, Sub, Mul, Div

    fn prec(self) -> u8 = match self { .Add | .Sub => 1, .Mul | .Div => 2 }
    fn sym(self) -> char = match self { .Add => '+', .Sub => '-', .Mul => '*', .Div => '/' }
    fn apply(self, a: f64, b: f64) -> f64 = match self {
        .Add => a + b, .Sub => a - b, .Mul => a * b, .Div => a / b
    }
}

/// An expression tree. Inside a warp, `^Expr` means "a pointer into the
/// same spool as this Expr". So a whole tree lives in one region, and the
/// region is chosen by whoever allocates it.
warp Expr {
    case Num(f64)
    case Var(String)                           // the String lives in the tree's spool too
    case Neg(^Expr)
    case Bin(op: Op, lhs: ^Expr, rhs: ^Expr)
}

weave Show into Expr {
    fn show(self, f: mut Fmt) = match self {   // patterns see through `^` automatically
        .Num(n) => f.put(n)
        .Var(name) => f.put(name)
        .Neg(x) => f.put("-{x}")
        .Bin(op, l, r) => f.put("({l} {op.sym()} {r})")
    }
}

// ---------------------------------------------------------------- errors

warp ParseError: Error {
    case UnexpectedEnd
    case Unexpected(char, at: usize)
    case Expected(char, at: usize)
    case BadNumber(from NumError)              // `?` on a NumError lands here
}

warp EvalError: Error {
    case Unbound(String)
}

// ---------------------------------------------------------------- parser

/// A parser borrows its source text. Borrows can't be stored in ordinary
/// warps, but a `ref warp` may hold them, because it's second-class itself:
/// it lives in locals and parameters and can never be returned or stored.
ref warp Parser {
    src: str
    pos: usize = 0

    fn peek(self) -> ?char = .src.char_at(.pos)

    fn skip_space(mut self) {
        while .peek() is some(c) and c.is_whitespace() { .pos += 1 }
    }

    /// Pratt parsing: `min` is the weakest operator this call may consume.
    fn expr(mut self, min: u8) -> ^Expr@sp ! ParseError given sp: Spool {
        var lhs = .atom()?
        loop {
            .skip_space()
            let op: Op = match .peek() {
                some('+') => .Add, some('-') => .Sub
                some('*') => .Mul, some('/') => .Div
                _ => break
            }
            if op.prec() < min { break }
            .pos += 1
            let rhs = .expr(op.prec() + 1)?
            lhs = ^Expr.Bin(op, lhs, rhs)       // prefix `^` allocates in the ambient spool: `sp`
        }
        lhs
    }

    fn atom(mut self) -> ^Expr@sp ! ParseError given sp: Spool {
        .skip_space()
        let start = .pos
        match .peek() {
            none => fail .UnexpectedEnd
            some('(') => {
                .pos += 1
                let inner = .expr(0)?
                .skip_space()
                if .peek() != ')' { fail .Expected(')', at: .pos) }
                .pos += 1
                inner
            }
            some('-') => {
                .pos += 1
                ^Expr.Neg(.atom()?)
            }
            some('0'..='9') => {
                while .peek() is some(d) and (d.is_digit() or d == '.') { .pos += 1 }
                let end = .pos
                ^Expr.Num(.src[start..end].parse[f64]()?)
            }
            some('a'..='z' | 'A'..='Z' | '_') => {
                while .peek() is some(d) and (d.is_alphanumeric() or d == '_') { .pos += 1 }
                let end = .pos
                ^Expr.Var(.src[start..end].copy())    // copy the name out of the borrowed source
            }
            some(c) => fail .Unexpected(c, at: start)
        }
    }
}

/// Parse `src` into a tree allocated in whatever spool the caller provides.
/// `pub` functions spell out their `given`s. Private ones may leave them to inference.
pub fn parse(src: str) -> ^Expr@sp ! ParseError given sp: Spool {
    var p = Parser(src)
    let e = p.expr(0)?
    p.skip_space()
    if p.peek() is some(c) { fail .Unexpected(c, at: p.pos) }
    e
}

// ---------------------------------------------------------------- passes

/// Constant folding. It reads a tree from *any* spool (a borrowed parameter
/// with no `@` is region-polymorphic) and writes a new tree into `out`.
/// Afterwards the old spool can be reset in one go, which makes this a
/// tiny semispace collector.
fn fold(e: ^Expr) -> ^Expr@out given out: Spool = match e {
    .Num(n) => ^Expr.Num(n)
    .Var(name) => ^Expr.Var(name.copy())         // `.copy()` allocates in the ambient spool: `out`
    .Neg(x) => {
        let x = x.fold()                          // UFCS: fold(x), passing `out` along implicitly
        if x is .Num(n) { ^Expr.Num(-n) } else { ^Expr.Neg(x) }
    }
    .Bin(op, l, r) => {
        let (l, r) = (l.fold(), r.fold())
        if l is .Num(a) and r is .Num(b) { ^Expr.Num(op.apply(a, b)) } else { ^Expr.Bin(op, l, r) }
    }
}

fn eval(e: ^Expr, vars: Map[str, f64]) -> f64 ! EvalError = match e {
    .Num(n) => n
    .Var(name) => vars.get(name) mend fail .Unbound(name.copy())
    .Neg(x) => -x.eval(vars)?                    // postfix binds tighter: -(x.eval(vars)?)
    .Bin(op, l, r) => op.apply(l.eval(vars)?, r.eval(vars)?)
}

// ---------------------------------------------------------------- main

fn main() {
    let src = "2 * (x + 3) - -(4 / 2) * 1.5"
    let vars = ["x": 4.0]

    spool raw = Arena(4.kib())                    // `raw` is both a value and a region name
    let tree = parse(src, given: raw) mend e => unravel("parse error: {e}")
    print("parsed: {tree}")                       // tree: ^Expr@raw

    spool small = Arena(4.kib())
    let folded = tree.fold(given: small)          // folded: ^Expr@small
    raw.reset()                                   // fine: nothing reads `tree` after this line
    print("folded: {folded}")

    let value = folded.eval(vars) mend e => unravel("eval error: {e}")
    print("value:  {value}")

    // The same parser builds a heap tree when no spool is given. There, each
    // `^Expr` is an owning pointer, and nodes are freed one at a time on drop.
    let boxed: ^Expr = parse("1 + 2") mend unravel("unreachable")
    print("heap:   {boxed}")
}   // `small` is released here in one sweep, with no per-node frees.

