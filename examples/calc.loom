//     parse("1 + 1", given: tmp) mend unravel("")
// }
//   error[R0101]: returned value points into spool `tmp`, which ends here
//     = note: the return type `^Expr` means `^Expr@heap`
//     = help: take `given out: Spool` and return `^Expr@out`
//
// fn too_early() {
//     spool raw = Arena(1.kib())
//     let t = parse("x", given: raw) mend unravel("")
//     raw.reset()
//     print(t)
// }
//   error[R0102]: `t` points into `raw`, which was reset on the line above
//     = help: move the reset after the last use of `t`, or `.copy()` it into another spool first
