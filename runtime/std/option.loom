//! Optional values: `?T`.

/// The methods of every optional type, `?T`.
#builtin
pub warp Optional[T] {
    /// The value, leaving `none` in its place.
    pub fun take(mut self) -> ?T
    /// `f` of the value, if there is one.
    pub fun map[U](take self, f: T => U) -> ?U {
        match self {
            some(x) => some(f(x))
            none => none
        }
    }
    /// The value, if `f` says yes to it.
    pub fun filter(take self, f: T => bool) -> ?T {
        match self {
            some(x) => if f(x) { some(x) } else { none }
            none => none
        }
    }
    /// Whether there is a value.
    pub fun is_some(self) -> bool {
        match self {
            some(_) => true
            none => false
        }
    }
    /// Whether there is no value.
    pub fun is_none(self) -> bool {
        match self {
            some(_) => false
            none => true
        }
    }
    /// The two values together, if both are there.
    pub fun zip[U](take self, take other: ?U) -> ?(T, U) {
        match self {
            some(a) => match other {
                some(b) => some((a, b))
                none => none
            }
            none => none
        }
    }
    /// Puts `x` in, returning what was there.
    pub fun replace(mut self, take x: T) -> ?T {
        let old = self.take()
        self = some(x)
        old
    }
    /// Takes the value out, if `f` says yes to it.
    pub fun take_if(mut self, f: T => bool) -> ?T {
        match self.take() {
            some(x) => if f(x) {
                some(x)
            } else {
                self = some(x)
                none
            }
            none => none
        }
    }
    /// The value, or `e` as an error when there is none.
    pub fun ok_or[E](take self, take e: E) -> T ! E {
        match self {
            some(x) => ok(x)
            none => err(e)
        }
    }
}

/// `f()` when the condition holds: `(n > 0).then(() => 100 / n)`.
pub fun then[T](cond: bool, f: () => T) -> ?T = if cond { some(f()) } else { none }

/// `x` when the condition holds.
pub fun then_some[T](cond: bool, take x: T) -> ?T = if cond { some(x) } else { none }
