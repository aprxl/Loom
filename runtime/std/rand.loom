// Pseudo-random numbers.

use std.process
use std.time

/// A deterministic xoshiro256** generator: the same seed always gives the
/// same numbers, on every machine. Not for secrets.
pub warp Rng {
    s0: u64
    s1: u64
    s2: u64
    s3: u64

    /// A generator that always produces the same sequence for `seed`.
    pub fun seeded(seed: u64) -> Rng {
        // splitmix64 spreads the seed over the four words of state, so
        // nearby seeds give unrelated sequences (and none is all zeros).
        var x = seed
        var s: [u64; 4] = [0; 4]
        for i in 0..4 {
            x +%= 0x9E37_79B9_7F4A_7C15
            var z = x
            z = (z ~ (z >> 30)) *% 0xBF58_476D_1CE4_E5B9
            z = (z ~ (z >> 27)) *% 0x94D0_49BB_1331_11EB
            s[i] = z ~ (z >> 31)
        }
        Rng(s0: s[0], s1: s[1], s2: s[2], s3: s[3])
    }

    /// A generator seeded from the clock and the process, so each run gets
    /// its own numbers. Not for secrets.
    pub fun from_entropy() -> Rng {
        let mix = time.unix_nanos() ~ ((process.id() as u64) << 32) ~ time.monotonic_nanos()
        Rng.seeded(mix)
    }

    /// The next 64 random bits.
    pub fun next_u64(mut self) -> u64 {
        let result = (.s1 *% 5).rotate_left(7) *% 9
        let t = .s1 << 17
        .s2 ~= .s0
        .s3 ~= .s1
        .s1 ~= .s2
        .s0 ~= .s3
        .s2 ~= t
        .s3 = .s3.rotate_left(45)
        result
    }

    /// A random byte: the top 8 bits of `next_u64`.
    pub fun byte(mut self) -> u8 = (.next_u64() >> 56) as u8

    /// A number from `0` up to but not including `n`, every one equally
    /// likely. Unravels if `n` is 0.
    pub fun below(mut self, n: u64) -> u64 {
        assert(n > 0, "below: n is 0")
        // Redraws the few values below 2^64 mod n, which would make small
        // results likelier.
        let threshold = (0 -% n) % n
        while true {
            let x = .next_u64()
            if x >= threshold { return x % n }
        }
        0
    }

    /// A number from `lo` to `hi`, both included. Unravels if `hi < lo`.
    pub fun between(mut self, lo: i64, hi: i64) -> i64 {
        assert(lo <= hi, "between: hi is less than lo")
        let span = (hi as% u64) -% (lo as% u64)
        if span == 0xFFFF_FFFF_FFFF_FFFF { return .next_u64() as% i64 }
        ((lo as% u64) +% .below(span + 1)) as% i64
    }

    /// A number from 0 up to but not including 1, with 53 random bits.
    pub fun float(mut self) -> f64 = (.next_u64() >> 11) as f64 * (1.0 / 9007199254740992.0)

    /// `true` with probability `p`.
    pub fun chance(mut self, p: f64) -> bool = .float() < p

    /// Puts the items in a random order.
    pub fun shuffle[T](mut self, mut xs: [T]) {
        var i = xs.len()
        while i > 1 {
            let j = .below(i as u64) as usize
            i -= 1
            xs.swap(i, j)
        }
    }

    /// A copy of a random item, if there are any.
    pub fun choose[T](mut self, xs: [T]) -> ?T {
        if xs.is_empty() { return none }
        xs.get(.below(xs.len() as u64) as usize)
    }

    /// Fills `buf` with random bytes.
    pub fun fill(mut self, mut buf: [u8]) {
        for i in 0..buf.len() {
            buf[i] = .byte()
        }
    }

    /// A generator at the current state, which this one then leaves 2^128
    /// steps behind: each call gives a stream that overlaps no other, so
    /// every thread can have its own.
    pub fun jump(mut self) -> Rng {
        let child = Rng(s0: .s0, s1: .s1, s2: .s2, s3: .s3)
        var t0 = 0u64
        var t1 = 0u64
        var t2 = 0u64
        var t3 = 0u64
        let table: [u64; 4] = [0x180E_C6D3_3CFD_0ABA, 0xD5A6_1266_F0C9_392C, 0xA958_2618_E03F_C9AA, 0x39AB_DC45_29B1_661C]
        for word in table {
            for bit in 0..64u64 {
                if word & (1u64 << bit) != 0 {
                    t0 ~= .s0
                    t1 ~= .s1
                    t2 ~= .s2
                    t3 ~= .s3
                }
                .next_u64()
            }
        }
        .s0 = t0
        .s1 = t1
        .s2 = t2
        .s3 = t3
        child
    }
}
