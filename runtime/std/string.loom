// Text: `str` is a view of UTF-8 text, `String` owns its text and can grow.
// Lengths and positions count bytes, slicing (`s[0..5]`) cuts on bytes and
// unravels inside a character, and the case changes and tests follow Unicode. A
// string literal is a template: `"{x}"` formats `x` into it.
//
// ```loom
// use std.io.print
//
// fun main() {
//     let line = "  name = Ada Lovelace  "
//     if line.trim().split_once("=") is some((key, value)) {
//         print("[{key.trim()}] -> [{value.trim()}]")
//     }
//     var s = String()
//     for c in "loom".chars() { s.push(c.to_upper()) }
//     s.push_str("!")
//     print("{s} {s.len()} bytes, {"straße".to_upper()}")
//     print("42".parse[u8]() mend 0)
// }
// ```

use std.iter.{FromStream, Owned}
use std.mem.Spool

use std.num.{NumError, Parse}

/// Why bytes aren't text.
pub warp Utf8Error: Error {
    /// How many bytes at the start were fine.
    pub valid_up_to: usize
}

#region
/// Owned, growable UTF-8 text. `str` is a view of text; a string literal
/// converts to `String` wherever one is expected. A `String` has every
/// method of `str`, too.
#builtin
pub warp String {
    /// An empty string with room for `n` bytes.
    pub fun with_capacity(n: usize) -> String
    /// The text of `chars`, in order.
    pub fun of(chars: [char]) -> String
    /// Adds `c` at the end.
    pub fun push(mut self, c: char)
    /// Adds `s` at the end.
    pub fun push_str(mut self, s: str)
    /// Takes the last character off, if there is one.
    pub fun pop(mut self) -> ?char
    /// Removes all the text.
    pub fun clear(mut self)
    /// The text the bytes spell, or where they stop being UTF-8.
    pub fun from_utf8(bytes: [u8]) -> String ! Utf8Error {
        var chars: List[char] = []
        var i = 0
        while i < bytes.len() {
            let b = bytes[i] as u32
            var more = 0
            var cp = b
            var least = 0u32
            if b >= 0xC2 and b < 0xE0 {
                more = 1
                cp = b & 0x1F
                least = 0x80
            } else if b >= 0xE0 and b < 0xF0 {
                more = 2
                cp = b & 0x0F
                least = 0x800
            } else if b >= 0xF0 and b < 0xF5 {
                more = 3
                cp = b & 0x07
                least = 0x10000
            } else if b >= 0x80 {
                fail Utf8Error(valid_up_to: i)
            }
            if more > 0 and i + more >= bytes.len() {
                fail Utf8Error(valid_up_to: i)
            }
            for k in 1..=more {
                let c = bytes[i + k] as u32
                if c & 0xC0 != 0x80 { fail Utf8Error(valid_up_to: i) }
                cp = (cp << 6) | (c & 0x3F)
            }
            if more > 0 and (cp < least or cp > 0x10FFFF or (cp >= 0xD800 and cp < 0xE000)) {
                fail Utf8Error(valid_up_to: i)
            }
            chars.push(cp as char)
            i += more + 1
        }
        String.of(chars)
    }
    /// Keeps the first `n` bytes. Unravels if `n` is past the end or in the
    /// middle of a character.
    pub fun truncate(mut self, n: usize) {
        let head: String = self[..n].to_string()
        self.clear()
        self.push_str(head)
    }
    /// Puts `s` at byte `i`. Unravels if `i` is past the end or in the middle
    /// of a character.
    pub fun insert_str(mut self, i: usize, s: str) {
        let tail: String = self[i..].to_string()
        self.truncate(i)
        self.push_str(s)
        self.push_str(tail)
    }
    /// Puts `c` at byte `i`.
    pub fun insert(mut self, i: usize, c: char) {
        let one: String = String.of([c])
        self.insert_str(i, one)
    }
    /// Takes out the character at byte `i`. Unravels if there isn't one.
    pub fun remove(mut self, i: usize) -> char {
        let c = match self[i..].chars().next() {
            some(c) => c
            none => unravel("remove: no character at byte {i}")
        }
        let tail: String = self[i + c.len_utf8()..].to_string()
        self.truncate(i)
        self.push_str(tail)
        c
    }
    /// Keeps the characters `keep` says yes to.
    pub fun retain(mut self, keep: char => bool) {
        var out: String = ""
        for c in self.chars() {
            if keep(c) { out.push(c) }
        }
        self.clear()
        self.push_str(out)
    }
}

/// The methods of `str`: a view of UTF-8 text. Lengths and positions count
/// bytes.
#builtin
pub warp Str {
    /// How many bytes it takes.
    pub fun len(self) -> usize
    /// Whether it has no text.
    pub fun is_empty(self) -> bool
    /// How many characters it has.
    pub fun char_count(self) -> usize
    /// Whether `part` is in it somewhere.
    pub fun contains(self, part: str) -> bool
    /// Whether it starts with `prefix`.
    pub fun starts_with(self, prefix: str) -> bool
    /// Whether it ends with `suffix`.
    pub fun ends_with(self, suffix: str) -> bool
    /// The byte position of the first `part`, if there is one.
    pub fun find(self, part: str) -> ?usize
    /// Without the white space at both ends (Unicode `White_Space`).
    pub fun trim(self) -> str
    /// Without the white space at the start.
    pub fun trim_start(self) -> str
    /// Without the white space at the end.
    pub fun trim_end(self) -> str
    /// In upper case, letter by letter (`ß` becomes `SS`).
    pub fun to_upper(self) -> String
    /// In lower case, letter by letter.
    pub fun to_lower(self) -> String
    /// Every `from` replaced with `to`. An empty `from` is found before every character and at the end: `"ab".replace("", "-")` is `-a-b-`.
    pub fun replace(self, from: str, to: str) -> String
    /// `n` copies, one after another.
    pub fun repeat(self, n: usize) -> String
    /// The parts between each `sep` (`"".split(",")` is one empty part). An empty `sep` splits into each character, with no empty parts at the ends (unlike Rust's).
    pub fun split(self, sep: str) -> List[String]
    /// The characters, one at a time.
    pub fun chars(self) -> Stream[char]
    /// The bytes of its UTF-8, one at a time.
    pub fun bytes(self) -> Stream[u8]
    /// The lines, without their line breaks (a newline, or a carriage
    /// return and a newline).
    pub fun lines(self) -> Stream[str]
    /// The words: what's between runs of white space.
    pub fun words(self) -> Stream[str]
    /// Without the ASCII white space at both ends (spaces, tabs, line breaks).
    pub fun trim_ascii(self) -> str
    /// Without the ASCII white space at the start.
    pub fun trim_ascii_start(self) -> str
    /// Without the ASCII white space at the end.
    pub fun trim_ascii_end(self) -> str
    /// With only the ASCII letters in upper case.
    pub fun to_ascii_upper(self) -> String
    /// With only the ASCII letters in lower case.
    pub fun to_ascii_lower(self) -> String
    /// The text as a `String` of its own.
    pub fun to_string(self) -> String
    fun char_before(self, end: usize) -> (char, usize)
    /// A `String` of its own, in the spool the call is given (the heap, when
    /// there is none): text in an arena goes when the arena does.
    pub fun copy(self) -> String@sp given sp: Spool
    /// The number the text spells: `"42".parse[u8]()`. Decimal, with an
    /// optional sign; floats also take a fraction, an exponent, `inf`, `NaN`.
    pub fun parse[T: Parse](self) -> T ! NumError
    /// The text before and after the first `sep`.
    pub fun split_once(self, sep: str) -> ?(str, str) {
        match self.find(sep) {
            some(i) => some((self[..i], self[i + sep.len()..]))
            none => none
        }
    }
    /// The pieces between `sep`s, at most `n` of them: the last holds the rest.
    /// Unravels if `sep` is empty.
    pub fun splitn(self, n: usize, sep: str) -> List[String] {
        assert(not sep.is_empty(), "splitn: sep is empty")
        var out: List[String] = []
        var rest = self
        while out.len() + 1 < n {
            match rest.find(sep) {
                some(i) => {
                    out.push(rest[..i].to_string())
                    rest = rest[i + sep.len()..]
                }
                none => break
            }
        }
        if n > 0 { out.push(rest.to_string()) }
        out
    }
    /// The pieces between `sep`s, from the last to the first.
    pub fun rsplit(self, sep: str) -> List[String] {
        var out = self.split(sep)
        out.reverse()
        out
    }
    /// The pieces between the characters `f` says yes to.
    pub fun split_by(self, f: char => bool) -> List[String] {
        var out: List[String] = []
        var from = 0
        var at = 0
        for c in self.chars() {
            if f(c) {
                out.push(self[from..at].to_string())
                from = at + c.len_utf8()
            }
            at += c.len_utf8()
        }
        out.push(self[from..].to_string())
        out
    }
    /// The text before and after the last `sep`.
    pub fun rsplit_once(self, sep: str) -> ?(str, str) {
        match self.rfind(sep) {
            some(i) => some((self[..i], self[i + sep.len()..]))
            none => none
        }
    }
    /// The index of the last `part`.
    pub fun rfind(self, part: str) -> ?usize {
        var found: ?usize = none
        var at = 0
        while at <= self.len() {
            match self[at..].find(part) {
                some(i) => {
                    found = some(at + i)
                    // On to the next character, never into the middle of one.
                    match self[at + i..].chars().next() {
                        some(c) => at += i + c.len_utf8()
                        none => break
                    }
                }
                none => break
            }
        }
        found
    }
    /// The text after `prefix`, if it starts with it.
    pub fun strip_prefix(self, prefix: str) -> ?str {
        if self.starts_with(prefix) { some(self[prefix.len()..]) } else { none }
    }
    /// The text before `suffix`, if it ends with it.
    pub fun strip_suffix(self, suffix: str) -> ?str {
        if self.ends_with(suffix) { some(self[..self.len() - suffix.len()]) } else { none }
    }
    /// How many times `part` comes up, not overlapping. Unravels if `part`
    /// is empty.
    pub fun count_of(self, part: str) -> usize {
        assert(not part.is_empty(), "count_of: part is empty")
        var n = 0
        var at = 0
        while at <= self.len() {
            match self[at..].find(part) {
                some(i) => {
                    n += 1
                    at += i + part.len()
                }
                none => break
            }
        }
        n
    }
    /// Each character with the byte index it starts at.
    pub fun char_indices(self) -> Stream[(usize, char)] {
        var out: List[(usize, char)] = []
        var at = 0
        for c in self.chars() {
            out.push((at, c))
            at += c.len_utf8()
        }
        Owned(items: out, at: 0)
    }
    /// The `i`th character (counting characters, so it takes `O(i)`).
    pub fun char_at(self, i: usize) -> ?char = self.chars().nth(i)
    /// Without the characters at both ends that `f` says yes to.
    pub fun trim_matches(self, f: char => bool) -> str = self.trim_start_matches(f).trim_end_matches(f)
    /// Without the characters at the start that `f` says yes to.
    pub fun trim_start_matches(self, f: char => bool) -> str {
        var at = 0
        for c in self.chars() {
            if not f(c) { break }
            at += c.len_utf8()
        }
        self[at..]
    }
    /// Without the characters at the end that `f` says yes to.
    pub fun trim_end_matches(self, f: char => bool) -> str {
        var end = self.len()
        while end > 0 {
            let (c, start) = self.char_before(end)
            if not f(c) { break }
            end = start
        }
        self[..end]
    }
    /// Whether the two are equal when upper and lower case don't count.
    pub fun eq_ignore_case(self, other: str) -> bool = self.to_lower() == other.to_lower()
    /// Whether every character is ASCII.
    pub fun is_ascii(self) -> bool = self.chars().all(c => c.is_ascii())
    /// With the first letter in upper case.
    pub fun capitalize(self) -> String {
        var out: String = ""
        var first = true
        for c in self.chars() {
            if first {
                out.push(c.to_upper())
                first = false
            } else {
                out.push(c)
            }
        }
        out
    }
    /// At least `width` characters, with `fill` added at the start.
    pub fun pad_left(self, width: usize, fill: char = ' ') -> String {
        var out: String = ""
        var n = self.char_count()
        while n < width {
            out.push(fill)
            n += 1
        }
        out.push_str(self)
        out
    }
    /// At least `width` characters, with `fill` added at the end.
    pub fun pad_right(self, width: usize, fill: char = ' ') -> String {
        var out = self.to_string()
        var n = self.char_count()
        while n < width {
            out.push(fill)
            n += 1
        }
        out
    }
}

/// The methods of `char`. The tests and the case changes follow Unicode;
/// the `_ascii` ones look at the ASCII letters only.
#builtin
pub warp Char {
    /// `0` through `9`.
    pub fun is_digit(self) -> bool
    /// A letter in any alphabet: `'é'` is.
    pub fun is_alphabetic(self) -> bool
    /// A digit in any script, or another number sign (`'½'`).
    pub fun is_numeric(self) -> bool
    /// A letter or a number.
    pub fun is_alphanumeric(self) -> bool
    /// White space: a space, a tab, a line break, a no-break space...
    pub fun is_whitespace(self) -> bool
    /// An upper case letter in any alphabet.
    pub fun is_upper(self) -> bool
    /// A lower case letter in any alphabet.
    pub fun is_lower(self) -> bool
    /// `a` through `z`, or `A` through `Z`.
    pub fun is_ascii_alphabetic(self) -> bool
    /// ASCII letters and `0` through `9`.
    pub fun is_ascii_alphanumeric(self) -> bool
    /// A space, tab, newline, carriage return, vertical tab or form feed.
    pub fun is_ascii_whitespace(self) -> bool
    /// `A` through `Z`.
    pub fun is_ascii_upper(self) -> bool
    /// `a` through `z`.
    pub fun is_ascii_lower(self) -> bool
    /// Upper case; a letter with no single upper case character (`ß`)
    /// stays as it is.
    pub fun to_upper(self) -> char
    /// Lower case; a letter with no single lower case character stays as it is.
    pub fun to_lower(self) -> char
    /// Upper case for an ASCII letter; any other character stays as it is.
    pub fun to_ascii_upper(self) -> char
    /// Lower case for an ASCII letter; any other character stays as it is.
    pub fun to_ascii_lower(self) -> char
    /// Its value as a digit in `radix`: `'f'.to_digit(16)` is `15`.
    pub fun to_digit(self, radix: u32 = 10) -> ?u32
    /// The value of a decimal digit: `'7'.digit()` is `7`. Unravels for
    /// anything but `0` through `9`.
    pub fun digit(self) -> u8
    /// How many bytes it takes in UTF-8.
    pub fun len_utf8(self) -> usize
    /// Whether it is one of the 128 ASCII characters.
    pub fun is_ascii(self) -> bool {
        self < '\u{80}'
    }
}

weave FromStream into String {
    type Item = char
    fun from_stream(take items: Stream[char]) -> String {
        var out: String = ""
        for c in items {
            out.push(c)
        }
        out
    }
}
