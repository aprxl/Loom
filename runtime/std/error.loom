// Errors and giving up. A function that can fail returns `T ! E`; the `?`
// operator passes an error up, `mend` handles it, and `fail` produces one. Any
// warp that weaves `Error` can be an error, and `unravel` gives up on the whole
// thread (as a panic does elsewhere), running `defer`s on the way out.
//
// ```loom
// use std.io.print
//
// warp ConfigError: Error {
//     case Missing(key: String)
//     case Bad(key: String, value: String)
// }
//
// fun port(text: str) -> u16 ! ConfigError {
//     let (key, value) = text.split_once("=") mend fail .Missing(key: text.to_string())
//     value.trim().parse[u16]() mend fail .Bad(key: key.to_string(), value: value.to_string())
// }
//
// fun main() {
//     print("{port("port=8080"):?}")
//     print("{port("port=lots"):?}")
//     print("{port("nothing"):?}")
//     let p = port("port=99") mend e => {
//         print("gave up: {e.message()}")
//         0
//     }
//     print(p)
// }
// ```

/// Something that went wrong. The default `message` is built from the case
/// name and payload.
pub weft Error: Show {
    /// What went wrong, in words. Derived: the value's `Show` form.
    #builtin
    fun message(self) -> String
}

/// The methods of every result type, `T ! E`.
#builtin
pub warp Fallible[T, E] {
    /// `f` of the value, or the error as it was.
    pub fun map[U](take self, f: T => U) -> U ! E {
        match self {
            ok(x) => ok(f(x))
            err(e) => err(e)
        }
    }
    /// The value as it was, or `f` of the error.
    pub fun map_err[F](take self, f: E => F) -> T ! F {
        match self {
            ok(x) => ok(x)
            err(e) => err(f(e))
        }
    }
    /// The value, if it worked.
    pub fun value(take self) -> ?T {
        match self {
            ok(x) => some(x)
            err(_) => none
        }
    }
    /// The error, if it failed.
    pub fun error(take self) -> ?E {
        match self {
            ok(_) => none
            err(e) => some(e)
        }
    }
    /// Whether it worked.
    pub fun is_ok(self) -> bool {
        match self {
            ok(_) => true
            err(_) => false
        }
    }
}

/// The error a `?` on an empty optional produces.
pub warp Missing: Error

extern "host" {
    /// Gives up: unwinds the current thread, running `defer`s on the way out.
    pub fun unravel(message: str) -> never
    /// Unravels with `message` unless `condition` holds. In a `const`
    /// context, a failed assertion is a compile error.
    pub fun assert(condition: bool, message: str = "assertion failed")
}
