// File paths, as text. The separator is `/` on every system (Windows takes it
// too), so a program and its tests read the same everywhere. Nothing here
// touches the file system: see `std.fs` for that.
//
// ```loom
// use std.io.print
// use std.path
//
// fun main() {
//     let p = path.join("docs/lang", "start.html")
//     print(p)
//     print("{path.file_name(p):?} {path.stem(p):?} {path.extension(p):?}")
//     print(path.with_extension(p, "md"))
//     print(path.normalize("a/./b/../c"))
// }
// ```

/// `a` and `b` as one path: `join("src", "main.loom")` is `src/main.loom`;
/// an absolute `b` replaces `a`.
pub fun join(a: str, b: str) -> String {
    if b.starts_with("/") or a.is_empty() { return b.to_string() }
    if a.ends_with("/") { return "{a}{b}" }
    "{a}/{b}"
}

/// Whether the path starts at the root.
pub fun is_absolute(p: str) -> bool = p.starts_with("/") or (p.len() > 2 and p.chars().nth(1) == some(':'))

/// The last part: `file_name("a/b.txt")` is `b.txt`. None for `""` and `/`.
pub fun file_name(p: str) -> ?str {
    let t = trim_end_slashes(p)
    if t.is_empty() { return none }
    match t.rfind("/") {
        some(i) => some(t[i + 1..])
        none => some(t)
    }
}

/// Everything before the last part: `parent("a/b.txt")` is `a`. None for
/// a path with one part and for the root.
pub fun parent(p: str) -> ?str {
    let t = trim_end_slashes(p)
    if t.is_empty() { return none }
    match t.rfind("/") {
        some(0) => some(t[..1])
        some(i) => some(t[..i])
        none => none
    }
}

/// The last part without its extension: `stem("a/b.tar.gz")` is `b.tar`.
pub fun stem(p: str) -> ?str {
    match file_name(p) {
        some(name) => match name.rfind(".") {
            some(0) => some(name)
            some(i) => some(name[..i])
            none => some(name)
        }
        none => none
    }
}

/// The part after the last dot of the last part: `extension("a/b.txt")` is
/// `txt`. None when there is no dot, or the dot starts the name.
pub fun extension(p: str) -> ?str {
    match file_name(p) {
        some(name) => match name.rfind(".") {
            some(0) => none
            some(i) => some(name[i + 1..])
            none => none
        }
        none => none
    }
}

/// The path with a different extension: `with_extension("a/b.txt", "md")`
/// is `a/b.md`.
pub fun with_extension(p: str, ext: str) -> String {
    let t = trim_end_slashes(p)
    // Where the last part starts, and where its extension does.
    var start = 0
    match t.rfind("/") {
        some(i) => start = i + 1
        none => {}
    }
    var end = t.len()
    match t[start..].rfind(".") {
        some(i) => if i > 0 { end = start + i }
        none => {}
    }
    if ext.is_empty() { t[..end].to_string() } else { "{t[..end]}.{ext}" }
}

/// The path without `.` parts, empty parts, and `x/..` pairs:
/// `normalize("a/./b/../c")` is `a/c`.
pub fun normalize(p: str) -> String {
    var parts: List[String] = []
    for part in p.split("/") {
        if part.is_empty() or part == "." { continue }
        if part == ".." {
            if not parts.is_empty() and parts[parts.len() - 1] != ".." {
                let _ = parts.pop()
            } else if not p.starts_with("/") {
                parts.push(part)
            }
            continue
        }
        parts.push(part)
    }
    let body = parts.join("/")
    if p.starts_with("/") { "/{body}" } else if body.is_empty() { ".".to_string() } else { body }
}

fun trim_end_slashes(p: str) -> str {
    var end = p.len()
    while end > 0 and p[end - 1..end] == "/" {
        end -= 1
    }
    p[..end]
}
