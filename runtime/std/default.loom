// Values with a default.

/// Types that have a value to start from: `0`, `false`, empty text, an empty
/// list. A warp that lists `Default` in its header and doesn't write
/// `default` gets one: each field takes its own default if it has one, and
/// its type's otherwise. A warp with cases takes its first, if it carries
/// nothing.
///
/// ```loom
/// warp Config: Default {
///     host: String = "localhost"
///     port: u16
/// }
/// // Config.default() is Config(host: "localhost", port: 0)
/// ```
pub weft Default {
    /// The default value.
    fun default() -> Self
}

/// The default value of `T`: `of[u16]()`.
pub fun of[T: Default]() -> T = T.default()

weave[T: Integer] Default into T {
    fun default() -> T = 0
}
weave Default into f32 {
    fun default() -> f32 = 0.0
}
weave Default into f64 {
    fun default() -> f64 = 0.0
}
weave Default into bool {
    fun default() -> bool = false
}
weave Default into char {
    fun default() -> char = '\0'
}
weave Default into String {
    fun default() -> String = String()
}
weave[T] Default into ?T {
    fun default() -> ?T = none
}
weave[T] Default into List[T] {
    fun default() -> List[T] = List()
}
weave[T: Hash] Default into Set[T] {
    fun default() -> Set[T] = Set()
}
weave[K: Hash, V] Default into Map[K, V] {
    fun default() -> Map[K, V] = Map()
}
weave Default into str {
    fun default() -> str = ""
}
weave Default into () {
    fun default() -> () = ()
}
weave[A: Default, B: Default] Default into (A, B) {
    fun default() -> (A, B) = (A.default(), B.default())
}
weave[A: Default, B: Default, C: Default] Default into (A, B, C) {
    fun default() -> (A, B, C) = (A.default(), B.default(), C.default())
}
weave[A: Default, B: Default, C: Default, D: Default] Default into (A, B, C, D) {
    fun default() -> (A, B, C, D) = (A.default(), B.default(), C.default(), D.default())
}
weave[A: Default, B: Default, C: Default, D: Default, E: Default] Default into (A, B, C, D, E) {
    fun default() -> (A, B, C, D, E) = (A.default(), B.default(), C.default(), D.default(), E.default())
}
weave[T: Default, const N: usize] Default into [T; N] {
    fun default() -> [T; N] = [T.default(); N]
}
