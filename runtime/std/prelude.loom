// The prelude: the names every module can use without a `use`. It's small on
// purpose: the collections (`List`, `Map`, `Set`), `String`, the wefts behind
// operators and printing (`Eq`, `Ord`, `Hash`, `Copy`, `Show`), the error
// basics (`Error`, `Missing`, `assert`, `unravel`), streams and ranges, and a
// few helpers like `min`, `max` and `then`.
//
// A module's own items and imports shadow these, so a program can always use a
// name of its own.

pub use std.string.String
pub use std.list.List
pub use std.map.Map
pub use std.set.Set
pub use std.error.{Error, Missing, assert, unravel}
pub use std.fmt.{Show, Fmt}
pub use std.ops.{Copy, Eq, Ord, Hash, Integer}
pub use std.iter.{Iter, Stream, Shuttle, Burst, Range}
pub use std.num.Num
pub use std.default.Default
pub use std.option.{then, then_some}
pub use std.cmp.{Ordering, cmp, min, max, clamp}

/// The unsigned integer type with `bits` bits: `uint(12)` is `u12`.
#builtin
pub const fun uint(bits: u8) -> type

/// The signed integer type with `bits` bits: `int(24)` is `i24`.
#builtin
pub const fun int(bits: u8) -> type
