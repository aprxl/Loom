// Console input and output: `print` and its relatives, reading standard input,
// and the `Writer` weft. `print` writes to the `Writer` that a `given` names,
// so code that prints can be pointed at a `Buffer` without changing it.
//
// ```loom
// use std.io.{print, Buffer}
//
// fun report(n: i32) given out: std.io.Writer {
//     print("report {n}")
// }
//
// fun main() {
//     report(1)                      // to standard output
//     let kept = {
//         given out = Buffer()       // from here on, print writes into a Buffer
//         report(2)
//         report(3)
//         out.text
//     }
//     print("kept: {kept:?}")
// }
// ```

#given_default(Stdout)
/// Where `print` writes: standard output, unless a `given` says otherwise
/// (`given out = Buffer()` keeps what is printed).
pub weft Writer {
    /// Writes `s`, as is.
    fun write_str(mut self, s: str)
}

/// Standard output.
pub warp Stdout: Writer, Default {
    /// Writes `s` to standard output.
    pub fun write_str(mut self, s: str) = write_out(s)
}

/// Keeps what is written to it, in `text`.
pub warp Buffer: Writer, Default {
    /// Everything written so far.
    pub text: String = ""
    /// Adds `s` to `text`.
    pub fun write_str(mut self, s: str) = .text.push_str(s)
}

extern "host" {
    /// Writes `x` and a newline to the `Writer` in scope: standard output,
    /// unless a `given out = ...` says otherwise.
    pub fun print(x: any Show) given out: Writer
    /// Standard output, as is: no newline.
    pub fun write_out(text: str)
    /// Standard error, as is: no newline.
    pub fun write_err(text: str)
    /// The next line of standard input, without its line ending; `none`
    /// once the input has ended.
    pub fun read_line() -> ?String
    /// Everything left on standard input.
    pub fun read_all() -> String
}

/// Writes `x` to standard output, with no newline after it.
pub fun write(x: any Show) {
    write_out("{x}")
}

/// Writes `x` and a newline to standard error.
pub fun eprint(x: any Show) {
    write_err("{x}\n")
}

/// Writes `x` to standard error, with no newline after it.
pub fun ewrite(x: any Show) {
    write_err("{x}")
}

/// The lines of standard input, one at a time, as they are read.
pub fun lines() -> Stream[String] = StdinLines()

/// The lines of standard input.
warp StdinLines: Iter {
    type Item = String

    fun next(mut self) -> ?String = read_line()
}
