// Hash maps.

use std.iter.FromStream

/// A map from `K` to `V` that remembers insertion order: going through it,
/// and showing it, follow the order keys were first added. Build one with
/// `Map()`, or a literal where a map is expected:
/// `let ages: Map[str, u8] = ["ada": 36, "alan": 41]` (`[:]` is empty).
///
/// `m[k]` is the value for `k`, and unravels when there's none (`m.get(k)`
/// gives an optional); `m[k] = v` adds or replaces it. `for (k, v) in m`
/// goes through the pairs, and a map has the methods of `Stream` too, over
/// its pairs. Keys must be `Hash`.
#builtin
pub warp Map[K, V] {
    /// How many keys there are.
    pub fun len(self) -> usize
    pub fun is_empty(self) -> bool
    /// A copy of the value for `key` (`m[key]` is the value itself).
    pub fun get(self, key: K) -> ?V where K: Hash
    /// Whether there's a value for `key`.
    pub fun has(self, key: K) -> bool where K: Hash
    /// Adds `value` for `key`, and gives back the value it replaces.
    pub fun insert(mut self, take key: K, take value: V) -> ?V where K: Hash
    /// The value for `key` as a place to change, for the statement it's in:
    /// `counts.entry(word, default: 0) += 1`. When there's none, `default`
    /// is added first (and `key` kept); when there is, both are dropped.
    pub fun entry(mut self, take key: K, take default: V) ~> mut V where K: Hash
    /// Takes out the value for `key`; later keys keep their order.
    pub fun remove(mut self, key: K) -> ?V where K: Hash
    /// Removes every key.
    pub fun clear(mut self)
    /// The keys, in order.
    pub fun keys(self) -> Stream[K]
    /// The values, in the order of their keys.
    pub fun values(self) -> Stream[V]
    /// The pairs, in order.
    pub fun pairs(self) -> Stream[(K, V)]
    /// A list of the pairs, sorted by key.
    pub fun sorted(self) -> List[(K, V)] where K: Ord
    /// A deep copy.
    pub fun copy(self) -> Map[K, V]
    /// The oldest entry.
    pub fun first(self) -> ?(K, V)
    /// The newest entry.
    pub fun last(self) -> ?(K, V)
    /// A map of `pairs`; a key that comes up again keeps the last value.
    pub fun of(pairs: [(K, V)]) -> Map[K, V] where K: Hash {
        var m: Map[K, V] = Map()
        for (k, v) in pairs {
            m.insert(k, v)
        }
        m
    }
    /// The value for `key`, or `default` when there is none.
    pub fun get_or(self, key: K, default: V) -> V where K: Hash {
        match self.get(key) {
            some(v) => v
            none => default
        }
    }
    /// Keeps the entries `keep` says yes to.
    pub fun retain(mut self, keep: (K, V) => bool) where K: Hash {
        var dead: List[K] = []
        for (k, v) in self.pairs() {
            if not keep(k, v) { dead.push(k) }
        }
        for k in dead {
            self.remove(k)
        }
    }
    /// Adds each pair; a key already there gets the new value.
    pub fun extend(mut self, take pairs: Stream[(K, V)]) where K: Hash {
        for (k, v) in pairs {
            self.insert(k, v)
        }
    }
    /// Takes out the entry for `key` and gives it back with the key you gave.
    pub fun remove_entry(mut self, take key: K) -> ?(K, V) where K: Hash {
        match self.remove(key) {
            some(v) => some((key, v))
            none => none
        }
    }
    /// Replaces the value for `key` with `f` of it, if there is one.
    pub fun update(mut self, take key: K, f: V => V) where K: Hash {
        match self.get(key) {
            some(v) => self.insert(key, f(v))
            none => none
        }
    }
    /// Adds the entries of `other`; for a key in both, `f(mine, theirs)`.
    pub fun merge(mut self, take other: Map[K, V], f: (V, V) => V) where K: Hash {
        for (k, v) in other.pairs() {
            match self.get(k) {
                some(mine) => self.insert(k, f(mine, v))
                none => self.insert(k, v)
            }
        }
    }
}

weave[K: Hash, V] FromStream into Map[K, V] {
    type Item = (K, V)
    fun from_stream(take items: Stream[(K, V)]) -> Map[K, V] {
        var out: Map[K, V] = Map()
        out.extend(items)
        out
    }
}
