// The running program: how to end it with an exit code, and which process it
// is.

extern "host" {
    /// Ends the program with exit code `code`: it unwinds first, as for
    /// an unravel, so its `defer`s run and what it owns is dropped.
    pub fun exit(code: u8) -> never
    /// The number the system gave this program.
    pub fun id() -> u32
}
