// Priority queues.

use std.iter.FromStream

/// A queue that gives the largest item first. For the smallest first, put
/// `Reverse` around the items (`std.cmp.Reverse`). A binary heap in a list:
/// `push` and `pop` take `O(log n)`, `peek` takes constant time.
pub warp PriorityQueue[T: Ord] {
    items: List[T]

    /// An empty queue.
    pub fn new() -> PriorityQueue[T] = PriorityQueue(items: [])

    /// A queue of `items`, made in `O(n)`.
    pub fn from_list(take items: List[T]) -> PriorityQueue[T] {
        var q = PriorityQueue(items: items)
        var i = q.items.len() / 2
        while i > 0 {
            i -= 1
            q.sift_down(i)
        }
        q
    }

    /// How many items there are.
    pub fn len(self) -> usize = .items.len()

    pub fn is_empty(self) -> bool = .items.is_empty()

    /// A copy of the largest item.
    pub fn peek(self) -> ?T = .items.get(0)

    /// Adds `x`.
    pub fn push(mut self, take x: T) {
        .items.push(x)
        var i = .items.len() - 1
        while i > 0 {
            let parent = (i - 1) / 2
            if not (.items[parent] < .items[i]) { break }
            .items.swap(parent, i)
            i = parent
        }
    }

    /// Takes off the largest item.
    pub fn pop(mut self) -> ?T {
        if .items.is_empty() { return none }
        .items.swap(0, .items.len() - 1)
        let top = .items.pop()
        .sift_down(0)
        top
    }

    /// Removes every item.
    pub fn clear(mut self) {
        .items.clear()
    }

    /// The items from the largest to the smallest, in a new list; this
    /// queue is used up.
    pub fn into_sorted(take self) -> List[T] {
        var q = self
        var out: List[T] = []
        while true {
            match q.pop() {
                some(x) => out.push(x)
                none => break
            }
        }
        out
    }

    fn sift_down(mut self, from: usize) {
        let n = .items.len()
        var i = from
        while true {
            let left = 2 * i + 1
            if left >= n { break }
            var big = left
            if left + 1 < n and .items[left] < .items[left + 1] { big = left + 1 }
            if not (.items[i] < .items[big]) { break }
            .items.swap(i, big)
            i = big
        }
    }
}

weave[T: Ord] FromStream into PriorityQueue[T] {
    type Item = T
    fn from_stream(take items: Stream[T]) -> PriorityQueue[T] = PriorityQueue.from_list(items.collect())
}
