// Iteration: the `Iter` weft (what `for` loops over), `Stream` (a lazy sequence
// and its many methods), `Range` (`a..b`), and `Shuttle` (generators and
// coroutines). Lists, arrays, slices, maps, sets and ranges all have the
// methods of `Stream`, and nothing is computed until something asks for the
// next item.
//
// ```loom
// use std.io.print
//
// fun main() {
//     // Nothing runs until `collect` asks for items.
//     let squares = (1..=10).filter(_ % 2 == 0).map(n => n * n)
//     print(squares.collect())
//     let words = ["warp", "weft", "weave", "loom"]
//     print(words.indexed().map(p => "{p.0}:{p.1}").join(" "))
//     print(words.map(_.len()).sum())
// }
// ```

use std.num.Num

/// Something `for` can loop over, one item at a time.
///
/// ```loom
/// warp Countdown(u32): Iter {
///     type Item = u32
///     fun next(mut self) -> ?u32 {
///         if .0 == 0 { return none }
///         .0 -= 1
///         .0 + 1
///     }
/// }
/// ```
pub weft Iter {
    /// What it gives.
    type Item
    /// The next item, or `none` once there are no more.
    fun next(mut self) -> ?Item
}

/// Collections a stream can be gathered into: see `Stream.collect_as`.
/// `Item` is what the collection is made of.
///
/// ```loom
/// let unique = words.collect_as[Set[String]]()
/// let text: String = letters.collect_as()
/// ```
pub weft FromStream {
    /// What the stream's items must be.
    type Item
    /// A collection of the items.
    fun from_stream(take items: Stream[Item]) -> Self
}

/// The type of `a..b`, `a..=b` and `a..`: the values from `a` up to `b`.
/// It has the methods of `Stream` (over its values), and these.
#builtin
pub warp Range[T] {
    /// Ranges of `n` values at a time, one after another: `(0..10).chunks(4)`
    /// is `0..4`, `4..8` and `8..10`. Each one is a range too, with all the
    /// methods of one, so it can be given to a thread. Unravels if `n` is 0
    /// or the range has no end.
    pub fun chunks(self, n: usize) -> Stream[Range[T]]
    /// The values from the last to the first. Needs room for all of them, and
    /// unravels for a range with no end.
    pub fun rev(self) -> Stream[T] {
        // Unravels for a range with no end, which has no last value.
        let _ = self.chunks(1)
        Reversed(items: self.collect())
    }
}

/// A lazy stream of `T`s: `s.chars()`, `xs.indexed()` and `stream.map(f)`
/// are streams. Nothing is computed until something asks for the next item.
///
/// Everything else with items has these methods too: arrays, lists and
/// slices, ranges, and types that weave `Iter`. `(1..=10).filter(_ % 2 == 0)`
/// is a stream of the range's items.
///
/// The methods that make a new stream use up this one: a stream is read
/// once.
#builtin
pub warp Stream[T] {
    /// The next item, or `none` once there are no more.
    pub fun next(mut self) -> ?T

    /// Each item turned into `f` of it: `(1..4).map(_ * 10)` gives 10, 20, 30.
    pub fun map[U](take self, f: T => U) -> Stream[U]
    /// The items `f` says yes to, in order: `xs.filter(_ > 0)`.
    pub fun filter(take self, f: T => bool) -> Stream[T]
    /// The first `n` items.
    pub fun take(take self, n: usize) -> Stream[T]
    /// The items after the first `n`.
    pub fun skip(take self, n: usize) -> Stream[T]
    /// The items before the first one `f` says no to.
    pub fun take_while(take self, f: T => bool) -> Stream[T]
    /// The items from the first one `f` says no to.
    pub fun skip_while(take self, f: T => bool) -> Stream[T]
    /// Each item with its index: `(0, a), (1, b), …`.
    pub fun indexed(take self) -> Stream[(usize, T)]
    /// Pairs of items, one from each, until either runs out.
    pub fun zip[U](take self, other: Stream[U]) -> Stream[(T, U)]
    /// These items, then `other`'s.
    pub fun chain(take self, other: Stream[T]) -> Stream[T]

    /// Every `n`th item, starting with the first. Unravels if `n` is 0.
    pub fun step_by(take self, n: usize) -> Stream[T]

    /// `f` of each item, leaving out the ones it gives `none` for.
    pub fun filter_map[U](take self, f: T => ?U) -> Stream[U]
    /// The items, calling `f` with each as it goes by.
    pub fun inspect(take self, f: T => ()) -> Stream[T]

    /// The items of the streams `f` makes from each item, one after another.
    pub fun flat_map[U](take self, f: T => Stream[U]) -> Stream[U] {
        Flatten(src: self.map(f), cur: [])
    }
    /// A stream that lets you look at the next item before taking it.
    pub fun peekable(take self) -> Peekable[T] {
        Peekable(src: self, buf: [], peeked: false)
    }
    /// Items made from a running state: `f(state, item)` gives the new state
    /// and the next item, or `none` to stop. `f` can't capture anything; what
    /// it needs travels in the state.
    pub fun scan[S, U](take self, take init: S, take f: (S, T) => ?(S, U)) -> Stream[U] {
        Scan(src: self, state: some(init), f: f)
    }
    /// The items again and again, for ever. Nothing if there are none.
    pub fun cycle(take self) -> Stream[T] {
        Cycle(items: self.collect(), at: 0)
    }
    /// Lists of `n` items at a time; the last may be shorter. Unravels if
    /// `n` is 0.
    pub fun chunks(take self, n: usize) -> Stream[List[T]] {
        assert(n > 0, "chunks: n is 0")
        Chunks(src: self, n: n)
    }
    /// The item at index `n` (counting from 0), or `none` if there are fewer.
    pub fun nth(take self, n: usize) -> ?T {
        var rest = self.skip(n)
        rest.next()
    }
    /// Whether there are no items.
    pub fun is_empty(take self) -> bool {
        var rest = self
        match rest.next() {
            some(_) => false
            none => true
        }
    }
    /// Whether both streams have equal items in the same order.
    pub fun eq(take self, take other: Stream[T]) -> bool where T: Eq {
        var a = self
        var b = other
        while true {
            match a.next() {
                some(x) => match b.next() {
                    some(y) => if x != y { return false }
                    none => return false
                }
                none => return b.next().is_none()
            }
        }
        true
    }
    /// The item with the smallest `key` (the first, among equals).
    pub fun min_by_key[K: Ord](take self, key: T => K) -> ?T {
        var best: List[T] = []
        var best_key: List[K] = []
        for x in self {
            let k = key(x)
            if best.is_empty() or k < best_key[0] {
                best.clear()
                best_key.clear()
                best.push(x)
                best_key.push(k)
            }
        }
        best.pop()
    }
    /// The item with the largest `key` (the last, among equals).
    pub fun max_by_key[K: Ord](take self, key: T => K) -> ?T {
        var best: List[T] = []
        var best_key: List[K] = []
        for x in self {
            let k = key(x)
            if best.is_empty() or not (k < best_key[0]) {
                best.clear()
                best_key.clear()
                best.push(x)
                best_key.push(k)
            }
        }
        best.pop()
    }
    /// The item no other goes before, by `before` (the first, among equals).
    pub fun min_by(take self, before: (T, T) => bool) -> ?T {
        var best: List[T] = []
        for x in self {
            if best.is_empty() or before(x, best[0]) {
                best.clear()
                best.push(x)
            }
        }
        best.pop()
    }
    /// The item that goes before no other, by `before` (the last, among
    /// equals).
    pub fun max_by(take self, before: (T, T) => bool) -> ?T {
        var best: List[T] = []
        for x in self {
            if best.is_empty() or not before(x, best[0]) {
                best.clear()
                best.push(x)
            }
        }
        best.pop()
    }
    /// The items `f` says yes to, and the ones it says no to.
    pub fun partition(take self, f: T => bool) -> (List[T], List[T]) {
        var yes: List[T] = []
        var no: List[T] = []
        for x in self {
            if f(x) { yes.push(x) } else { no.push(x) }
        }
        (yes, no)
    }
    /// How many times each item comes up.
    pub fun counts(take self) -> Map[T, usize] where T: Hash {
        var m: Map[T, usize] = Map()
        for x in self {
            m.entry(x, default: 0) += 1
        }
        m
    }
    /// The items in lists by `key`, in the order the keys first came up.
    pub fun group_by[K: Hash](take self, key: T => K) -> Map[K, List[T]] {
        var m: Map[K, List[T]] = Map()
        for x in self {
            m.entry(key(x), default: []).push(x)
        }
        m
    }

    /// The items gathered into a `C`: `words.collect_as[Set[String]]()`, or
    /// `let text: String = chars.collect_as()` when the type is known from
    /// where the result goes. The collections that can be made are the ones
    /// that weave `FromStream`: `List`, `Set`, `Map` (of pairs), `String` (of
    /// characters), `Deque` and `PriorityQueue`.
    pub fun collect_as[C: FromStream](take self) -> C where T: C.Item {
        C.from_stream(self)
    }
    /// A list of the items.
    pub fun collect(take self) -> List[T]
    /// How many items there are.
    pub fun count(take self) -> usize
    /// The last item.
    pub fun last(take self) -> ?T
    /// Calls `f` with each item.
    pub fun each(take self, f: T => ())
    /// Combines the items, starting with `init`: `f(f(init, a), b)`…
    pub fun fold[A](take self, take init: A, f: (A, T) => A) -> A
    /// Combines the items, starting with the first; `none` if there are none.
    pub fun reduce(take self, f: (T, T) => T) -> ?T
    /// Whether `f` says yes to every item (`true` when there are none).
    pub fun all(take self, f: T => bool) -> bool
    /// Whether `f` says yes to some item. (`any` is a keyword.)
    pub fun exists(take self, f: T => bool) -> bool
    /// The first item `f` says yes to.
    pub fun find(take self, f: T => bool) -> ?T
    /// The index of the first item `f` says yes to.
    pub fun position(take self, f: T => bool) -> ?usize
    /// The sum of the items (0 when there are none). Unravels when it
    /// doesn't fit.
    pub fun sum(take self) -> T where T: Num
    /// The product of the items (1 when there are none). Unravels when it
    /// doesn't fit.
    pub fun product(take self) -> T where T: Num
    /// The smallest item (the first, among equals).
    pub fun min(take self) -> ?T where T: Ord
    /// The largest item (the last, among equals).
    pub fun max(take self) -> ?T where T: Ord
    /// The items as text, with `sep` between them.
    pub fun join(take self, sep: str) -> String where T: Show
    /// The items in a new list, sorted by `before`: `before(a, b)` says
    /// whether `a` goes before `b`. A stable sort: items that neither goes
    /// before the other keep the order they came in.
    /// `words.pairs().sorted_by(_.1 > _.1)` is the most frequent first.
    pub fun sorted_by(take self, before: (T, T) => bool) -> List[T] {
        var out = self.collect()
        out.sort_by(before)
        out
    }
    /// The items in a new list, sorted by `key` of each. Stable.
    pub fun sorted_by_key[K: Ord](take self, key: T => K) -> List[T] {
        var out = self.collect()
        out.sort_by_key(key)
        out
    }
    /// The items in a new list, in order. Stable.
    pub fun sorted(take self) -> List[T] where T: Ord {
        var out = self.collect()
        out.sort()
        out
    }
}

/// A shuttle: a function paused between the `T`s it yields and the `U`s it
/// pulls. Calling `fun f() ~> T <~ U` makes one without running any of it.
///
/// A generator (`~> T`, which pulls nothing) is a stream of what it yields:
/// `for x in fib()`, `fib().take(10)`.
#builtin
pub warp Shuttle[T, U] {
    /// Resumes it with `input` as the value of its pending `pull` (the first
    /// push starts it), once what's left of the last burst has run. The
    /// burst is what it yields before its next `pull`.
    pub fun push(mut self, take input: U) -> Burst[T]
    /// Makes its pending and later `pull`s give `none`, once what's left of
    /// the last burst has run. The burst is what it yields from here on.
    pub fun close(mut self) -> Burst[T]
}

/// What a shuttle yields between one input and its next `pull`. It's lazy:
/// going through it is what runs the shuttle. It's `once`, so outputs can't
/// be dropped by accident: go through it with `for` (or a `Stream` method),
/// or `drain()` it.
#builtin
pub once warp Burst[T] {
    /// Runs the shuttle to its next `pull`, throwing away what it yields.
    pub fun drain(take self)
}

/// The items of `flat_map`.
warp Flatten[U]: Iter {
    src: Stream[Stream[U]]
    cur: List[Stream[U]]

    type Item = U

    fun next(mut self) -> ?U {
        while true {
            if .cur.is_empty() {
                match .src.next() {
                    some(inner) => .cur.push(inner)
                    none => return none
                }
            }
            match .cur[0].next() {
                some(x) => return some(x)
                none => .cur.clear()
            }
        }
        none
    }
}

/// What `Stream.peekable` makes: a stream that can show its next item without
/// taking it.
pub warp Peekable[T]: Iter {
    src: Stream[T]
    buf: List[T]
    peeked: bool

    /// The items are the stream's.
    type Item = T

    fun next(mut self) -> ?T {
        if .peeked {
            .peeked = false
            return .buf.pop()
        }
        .src.next()
    }

    /// A copy of the next item, without taking it.
    pub fun peek(mut self) -> ?T {
        if not .peeked {
            match .src.next() {
                some(x) => {
                    .buf.push(x)
                    .peeked = true
                }
                none => return none
            }
        }
        .buf.get(0)
    }

    /// The next item, if `f` says yes to it.
    pub fun next_if(mut self, f: T => bool) -> ?T {
        match .peek() {
            some(x) => if f(x) { .next() } else { none }
            none => none
        }
    }
}

/// The items of `scan`.
warp Scan[T, S, U]: Iter {
    src: Stream[T]
    state: ?S
    f: (S, T) => ?(S, U)

    type Item = U

    fun next(mut self) -> ?U {
        let s = .state.take() mend return none
        let x = .src.next() mend return none
        let g = self.f
        let (s2, u) = g(s, x) mend return none
        .state = some(s2)
        some(u)
    }
}

/// The items of `from_fn`.
warp FromFn[S, T]: Iter {
    state: ?S
    f: S => ?(S, T)

    type Item = T

    fun next(mut self) -> ?T {
        let s = .state.take() mend return none
        let g = self.f
        let (s2, x) = g(s) mend return none
        .state = some(s2)
        some(x)
    }
}

/// The items of `successors`.
warp Successors[T: Copy]: Iter {
    next_item: ?T
    f: T => ?T

    type Item = T

    fun next(mut self) -> ?T {
        let cur = .next_item.take() mend return none
        let g = self.f
        .next_item = g(cur)
        some(cur)
    }
}

/// Items made from a state: `f(state)` gives the new state and the next
/// item, or `none` to stop. `f` can't capture anything; what it needs
/// travels in the state.
pub fun from_fn[S, T](take init: S, take f: S => ?(S, T)) -> Stream[T] = FromFn(state: some(init), f: f)

/// `first`, then `f` of it, and so on until `f` gives `none`.
pub fun successors[T: Copy](take first: ?T, take f: T => ?T) -> Stream[T] = Successors(next_item: first, f: f)

/// The items of `cycle`.
warp Cycle[T]: Iter {
    items: List[T]
    at: usize

    type Item = T

    fun next(mut self) -> ?T {
        if .items.is_empty() { return none }
        let x = .items.get(.at)
        .at = (.at + 1) % .items.len()
        x
    }
}

/// The items of `chunks`.
warp Chunks[T]: Iter {
    src: Stream[T]
    n: usize

    type Item = List[T]

    fun next(mut self) -> ?List[T] {
        var out: List[T] = []
        while out.len() < .n {
            match .src.next() {
                some(x) => out.push(x)
                none => break
            }
        }
        if out.is_empty() { none } else { some(out) }
    }
}

/// The items of `rev`: the list, emptied from the end.
pub warp Reversed[T]: Iter {
    /// What's left, the last item first.
    pub items: List[T]

    /// The list's items.
    type Item = T

    fun next(mut self) -> ?T = .items.pop()
}

/// The items of a list this owns, from the first: what a method that builds
/// its items in a list gives as a stream.
pub warp Owned[T]: Iter {
    /// The list it gives the items of.
    pub items: List[T]
    /// The index of the next item.
    pub at: usize

    /// The list's items.
    type Item = T

    fun next(mut self) -> ?T {
        let x = .items.get(.at)
        .at += 1
        x
    }
}
