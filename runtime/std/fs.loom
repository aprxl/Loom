// Files.

pub warp IoError: Error {
    case NotFound(path: String)
    case Denied(path: String)
    case Other(message: String)
}

/// An open file.
#builtin
pub warp File {
    /// Opens `path` for appending, creating it if needed.
    pub fn append(path: str) -> File ! IoError
    pub fn write_line(mut self, line: str) ! IoError
}

extern "lua" {
    pub fn read(path: str) -> List[u8] ! IoError
    pub fn read_text(path: str) -> String ! IoError
    /// Makes the file `path` hold `text`, replacing what was there.
    pub fn write_text(path: str, text: str) ! IoError
    /// Whether there is a file or a directory at `path`.
    pub fn exists(path: str) -> bool
    /// Deletes the file at `path`.
    pub fn remove_file(path: str) ! IoError
}
