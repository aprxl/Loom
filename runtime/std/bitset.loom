// Sets of small numbers.

/// A set of the numbers `0..len`, one bit each. Constant-time `set`, `clear`,
/// `test` and `toggle`; `count` and the bulk operations work a word of 64
/// bits at a time.
pub warp BitSet {
    words: List[u64]
    size: usize

    /// A set of `len` numbers, none in it.
    pub fun new(len: usize) -> BitSet = BitSet(words: List.filled(0, (len + 63) / 64), size: len)

    /// How many numbers it can hold: they are `0` up to this.
    pub fun len(self) -> usize = .size

    /// Puts `i` in. Unravels if `i >= len`.
    pub fun set(mut self, i: usize) {
        assert(i < .size, "BitSet.set: index out of bounds")
        .words[i / 64] |= 1u64 << (i % 64) as u64
    }

    /// Takes `i` out. Unravels if `i >= len`.
    pub fun clear(mut self, i: usize) {
        assert(i < .size, "BitSet.clear: index out of bounds")
        .words[i / 64] &= ~(1u64 << (i % 64) as u64)
    }

    /// Puts `i` in if it is out, and out if it is in.
    pub fun toggle(mut self, i: usize) {
        assert(i < .size, "BitSet.toggle: index out of bounds")
        .words[i / 64] ~= 1u64 << (i % 64) as u64
    }

    /// Whether `i` is in. Unravels if `i >= len`.
    pub fun test(self, i: usize) -> bool {
        assert(i < .size, "BitSet.test: index out of bounds")
        (.words[i / 64] >> (i % 64) as u64) & 1 == 1
    }

    /// How many numbers are in.
    pub fun count(self) -> usize {
        var n = 0usize
        for w in .words {
            n += w.count_ones() as usize
        }
        n
    }

    /// The numbers that are in, from the smallest.
    pub fun items(self) -> List[usize] {
        var out: List[usize] = []
        for k in 0..self.words.len() {
            var w = .words[k]
            while w != 0 {
                out.push(k * 64 + w.trailing_zeros() as usize)
                w &= w - 1
            }
        }
        out
    }

    /// Keeps the numbers that are also in `other`. The sets must be the
    /// same size.
    pub fun intersect_with(mut self, other: BitSet) {
        assert(.size == other.size, "BitSet: the sets are different sizes")
        for k in 0..self.words.len() {
            .words[k] &= other.words[k]
        }
    }

    /// Adds the numbers in `other`. The sets must be the same size.
    pub fun union_with(mut self, other: BitSet) {
        assert(.size == other.size, "BitSet: the sets are different sizes")
        for k in 0..self.words.len() {
            .words[k] |= other.words[k]
        }
    }

    /// Takes out the numbers that are in `other`. The sets must be the same
    /// size.
    pub fun subtract(mut self, other: BitSet) {
        assert(.size == other.size, "BitSet: the sets are different sizes")
        for k in 0..self.words.len() {
            .words[k] &= ~other.words[k]
        }
    }
}
