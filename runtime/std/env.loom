// The process environment: environment variables, the command-line arguments
// and a few well-known directories. In a sandboxed run (the docs' playground,
// the test fixtures) there are no variables and no directories.

extern "host" {
    /// The environment variable `name`, if it's set.
    pub fun get(name: str) -> ?String
    /// The command-line arguments, starting with the program name.
    pub fun args() -> List[String]
    /// The directory the program runs in, if it can be found out.
    pub fun current_dir() -> ?String
}

/// The user's home directory, if the environment says where it is.
pub fun home_dir() -> ?String {
    match get("HOME") {
        some(h) => some(h)
        none => get("USERPROFILE")
    }
}

/// The directory for temporary files.
pub fun temp_dir() -> String {
    for name in ["TMPDIR", "TEMP", "TMP"] {
        match get(name) {
            some(d) => return d
            none => {}
        }
    }
    "/tmp".to_string()
}
