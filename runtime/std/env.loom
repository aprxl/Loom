// The process environment.

extern "host" {
    /// The environment variable `name`, if it's set.
    pub fn get(name: str) -> ?String
    /// The command-line arguments, starting with the program name.
    pub fn args() -> List[String]
    /// The directory the program runs in, if it can be found out.
    pub fn current_dir() -> ?String
}

/// The user's home directory, if the environment says where it is.
pub fn home_dir() -> ?String {
    match get("HOME") {
        some(h) => some(h)
        none => get("USERPROFILE")
    }
}

/// The directory for temporary files.
pub fn temp_dir() -> String {
    for name in ["TMPDIR", "TEMP", "TMP"] {
        match get(name) {
            some(d) => return d
            none => {}
        }
    }
    "/tmp".to_string()
}
