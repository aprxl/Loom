// Numbers: the methods of every integer and float type (`n.pow(2)`, `x.sqrt()`,
// `a.gcd(b)`...), parsing text into numbers, and the `Num` weft for code that
// works on any number. Integers come in every width from 1 to 64 bits (`u12`,
// `i24`), and each operator says what happens on overflow.
//
// ```loom
// use std.io.print
//
// fun main() {
//     let n: u32 = 40
//     print("{n.pow(2)} {n.count_ones()} {n.trailing_zeros()} {n.to_string_radix(2)}")
//     print("{(-7).rem_euclid(3)} {12.gcd(18)} {255.to_string_radix(16)}")
//     let x = 2.0
//     print("{x.sqrt():.4} {x.pow(10.0)} {(1.0).atan2(1.0) * 4.0}")
//     print("{"300".parse[u8]():?} {"-12".parse[i8]():?} {"2.5e3".parse[f64]():?}")
// }
// ```

/// Why text didn't parse as a number.
pub warp NumError: Error {
    /// There was no text to parse.
    case Empty
    /// The text isn't a number of that type: a stray character, a sign an
    /// unsigned type can't take.
    case Invalid
    /// The number is too big (or too small) for the type.
    case Overflow
}

/// Types `str.parse` can make: every integer and float type.
#builtin
pub weft Parse {}

/// Every number type: the integers and the floats.
#builtin
pub weft Num: Ord, Copy, Show {}

/// The methods of every integer type, `T`.
#builtin
pub warp Int[T] {
    /// The value without its sign. Unravels for the smallest signed value.
    pub fun abs(self) -> T
    /// The smaller of the two.
    pub fun min(self, other: T) -> T
    /// The larger of the two.
    pub fun max(self, other: T) -> T
    /// `self` to the power `exp`. Unravels when it doesn't fit.
    pub fun pow(self, exp: u32) -> T
    /// How many zero bits come after the lowest one bit (all of them for 0).
    pub fun trailing_zeros(self) -> u32
    /// How many zero bits come before the highest one bit.
    pub fun leading_zeros(self) -> u32
    /// How many bits are one.
    pub fun count_ones(self) -> u32
    /// Whether it's 2 to the power of something: one bit is one, and it's
    /// above zero.
    pub fun is_power_of_two(self) -> bool
    /// The base-2 logarithm, rounded down: the position of the highest one
    /// bit. Unravels for zero and below.
    pub fun log2(self) -> u32
    /// The bits moved `n` places towards the top; those pushed out come back
    /// in at the bottom. `n` counts modulo the type's width.
    pub fun rotate_left(self, n: u32) -> T
    /// The bits moved `n` places towards the bottom; those pushed out come
    /// back in at the top. `n` counts modulo the type's width.
    pub fun rotate_right(self, n: u32) -> T
    /// The number as decimal text: what `{n}` prints.
    pub fun to_string(self) -> String
    /// The digits of `self` in base `radix`, lowercase, with a leading `-` when negative. Unravels unless `radix` is 2 to 36.
    pub fun to_string_radix(self, radix: u32) -> String {
        assert(radix >= 2 and radix <= 36, "to_string_radix: the radix is 2 to 36")
        let r = radix as T
        var v = self
        var digits: List[char] = List()
        loop {
            let rem = v % r
            let d = if rem < 0 { 0 - rem } else { rem }
            digits.push(match "0123456789abcdefghijklmnopqrstuvwxyz".char_at(d as usize) {
                some(c) => c
                none => unravel("to_string_radix: digit out of range")
            })
            v = v / r
            if v == 0 { break }
        }
        var out = String()
        if self < 0 { out.push('-') }
        var i = digits.len()
        while i > 0 {
            i -= 1
            out.push(digits[i])
        }
        out
    }
    /// `-1`, `0` or `1`.
    pub fun signum(self) -> T
    /// The remainder that is never below zero: `(-7).rem_euclid(3)` is `2`.
    /// Unravels if `m` is 0.
    pub fun rem_euclid(self, m: T) -> T
    /// The quotient that goes with `rem_euclid`. Unravels if `m` is 0.
    pub fun div_euclid(self, m: T) -> T
    /// The quotient rounded down. Unravels if `m` is 0.
    pub fun div_floor(self, m: T) -> T
    /// The quotient rounded up. Unravels if `m` is 0.
    pub fun div_ceil(self, m: T) -> T
    /// The greatest number that divides both.
    pub fun gcd(self, other: T) -> T
    /// The smallest number both divide. Unravels when it doesn't fit.
    pub fun lcm(self, other: T) -> T
    /// The distance between `self` and `other`. Unravels when it doesn't fit.
    pub fun abs_diff(self, other: T) -> T = if self > other { self - other } else { other - self }
    /// The square root, rounded down. Unravels below zero.
    pub fun isqrt(self) -> T
    /// The base-10 logarithm, rounded down. Unravels for zero and below.
    pub fun ilog10(self) -> u32
    /// The smallest power of two that is not below it. Unravels when it
    /// doesn't fit.
    pub fun next_power_of_two(self) -> T
    /// How many bits are zero.
    pub fun count_zeros(self) -> u32
    /// `self` to the power `exp`, with the bits that don't fit dropped.
    pub fun pow_wrap(self, exp: u32) -> T
    /// `self` to the power `exp`, or the nearest number that fits.
    pub fun pow_sat(self, exp: u32) -> T
    /// `self` to the power `exp`, or `none` when it doesn't fit.
    pub fun pow_checked(self, exp: u32) -> ?T {
        var acc: T = 1
        var base = self
        var e = exp
        while e > 0 {
            if e & 1 == 1 { acc = (acc *? base)? }
            e = e >> 1
            if e > 0 { base = (base *? base)? }
        }
        some(acc)
    }
    /// The bytes of `self`, most significant first.
    pub fun to_be_bytes(self) -> [u8; T.size] {
        var out: [u8; T.size] = [0; T.size]
        for i in 0..T.size {
            out[i] = ((self >> ((T.size - 1 - i) * 8)) & 0xFF) as u8
        }
        out
    }
    /// The integer whose bytes, most significant first, are `bytes`.
    pub fun from_be_bytes(bytes: [u8; T.size]) -> T {
        var v: T = 0
        for i in 0..T.size {
            v = v | ((bytes[i] as T) << ((T.size - 1 - i) * 8))
        }
        v
    }
}

/// The methods of every float type, `T`.
#builtin
pub warp Float[T] {
    /// The value without its sign.
    pub fun abs(self) -> T
    /// The smaller one; a NaN loses to a number.
    pub fun min(self, other: T) -> T
    /// The larger one; a NaN loses to a number.
    pub fun max(self, other: T) -> T
    /// The square root; NaN below zero.
    pub fun sqrt(self) -> T
    /// The nearest whole number at or below it.
    pub fun floor(self) -> T
    /// The nearest whole number at or above it.
    pub fun ceil(self) -> T
    /// Halfway rounds away from zero.
    pub fun round(self) -> T
    /// The whole-number part: the fraction dropped, towards zero.
    pub fun trunc(self) -> T
    /// `self` to the power `exp`.
    pub fun pow(self, exp: T) -> T
    /// Whether it is NaN, not a number (the only value not equal to itself).
    pub fun is_nan(self) -> bool
    /// The number as text: what `{x}` prints.
    pub fun to_string(self) -> String
    /// The sine of an angle in radians.
    pub fun sin(self) -> T
    /// The cosine of an angle in radians.
    pub fun cos(self) -> T
    /// The tangent of an angle in radians.
    pub fun tan(self) -> T
    /// The angle, in radians, whose sine this is; NaN outside -1 to 1.
    pub fun asin(self) -> T
    /// The angle, in radians, whose cosine this is; NaN outside -1 to 1.
    pub fun acos(self) -> T
    /// The angle, in radians, whose tangent this is.
    pub fun atan(self) -> T
    /// The angle of the point (`other`, `self`), from the x axis.
    pub fun atan2(self, other: T) -> T
    /// The hyperbolic sine.
    pub fun sinh(self) -> T
    /// The hyperbolic cosine.
    pub fun cosh(self) -> T
    /// The hyperbolic tangent.
    pub fun tanh(self) -> T
    /// `e` to the power `self`.
    pub fun exp(self) -> T
    /// 2 to the power `self`.
    pub fun exp2(self) -> T
    /// The natural logarithm.
    pub fun ln(self) -> T
    /// The base-2 logarithm.
    pub fun log2(self) -> T
    /// The base-10 logarithm.
    pub fun log10(self) -> T
    /// The logarithm in `base`.
    pub fun log(self, base: T) -> T
    /// The length of the hypotenuse of a triangle with sides `self` and `other`.
    pub fun hypot(self, other: T) -> T
    /// What is left after `trunc`.
    pub fun fract(self) -> T
    /// `-1.0` or `1.0`, by the sign (so `-0.0` gives `-1.0`); NaN stays NaN.
    pub fun signum(self) -> T
    /// `self` with the sign of `sign`.
    pub fun copysign(self, sign: T) -> T
    /// An angle in radians, in degrees.
    pub fun to_degrees(self) -> T
    /// An angle in degrees, in radians.
    pub fun to_radians(self) -> T
    /// Whether it is neither infinite nor NaN.
    pub fun is_finite(self) -> bool
    /// Whether it is `inf` or `-inf`.
    pub fun is_infinite(self) -> bool
    /// Whether its sign bit is set: true for `-0.0` and negative NaNs too.
    pub fun is_sign_negative(self) -> bool
    /// The IEEE 754 bit pattern.
    pub fun to_bits(self) -> uint(T.size * 8)
    /// The float with IEEE 754 bit pattern `bits`.
    pub fun from_bits(bits: uint(T.size * 8)) -> T
    /// Orders every value, NaNs included: -NaN < -inf < … < -0 < +0 < … < inf < NaN.
    pub fun total_cmp(self, other: T) -> Ordering {
        let top: uint(T.size * 8) = 1 << (T.size * 8 - 1)
        let a = self.to_bits()
        let b = other.to_bits()
        let ka = if a & top != 0 { ~a } else { a | top }
        let kb = if b & top != 0 { ~b } else { b | top }
        ka.cmp(kb)
    }
}
