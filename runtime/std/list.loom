// Growable arrays: `List[T]` owns its elements and grows as you push. It has
// every method of a slice (`std.slice`) and of `Stream` too, so `xs.sort()`,
// `xs.contains(x)` and `xs.filter(f)` all work on a list.
//
// ```loom
// use std.io.print
//
// fun main() {
//     var xs: List[i32] = [5, 3, 8]
//     xs.push(1)
//     xs.insert(0, 9)
//     xs.sort()
//     print("{xs} has {xs.len()} items, the largest is {xs.last():?}")
//     xs.retain(_ % 2 == 1)
//     print("odd ones: {xs}")
// }
// ```

use std.iter.FromStream

/// A growable array of `T`. Build one with `List()`, `List.filled(x, n)`,
/// or a literal where a list is expected: `let xs: List[i32] = [1, 2, 3]`.
/// It has every method of a slice (`[T]`), too.
#builtin
pub warp List[T] {
    /// `n` copies of `x`.
    pub fun filled(x: T, n: usize) -> List[T]
    /// Adds `x` at the end.
    pub fun push(mut self, take x: T)
    /// Takes the last element off, if there is one.
    pub fun pop(mut self) -> ?T
    /// Puts `x` at index `i`, moving the rest up. Unravels if `i > len`.
    pub fun insert(mut self, i: usize, take x: T)
    /// Takes out the element at `i`, moving the rest down. Unravels if
    /// `i >= len`.
    pub fun remove(mut self, i: usize) -> T
    /// Removes every element.
    pub fun clear(mut self)
    /// Keeps the first `n` elements.
    pub fun truncate(mut self, n: usize)
    /// Adds each of the items at the end.
    pub fun extend(mut self, take items: Stream[T]) {
        for x in items {
            self.push(x)
        }
    }
    /// A deep copy: a new list with a copy of every element.
    pub fun copy(self) -> List[T]
    /// Keeps the elements `keep` says yes to, in their order.
    pub fun retain(mut self, keep: T => bool) {
        var w = 0
        for i in 0..self.len() {
            if keep(self[i]) {
                if w != i { self.swap(w, i) }
                w += 1
            }
        }
        self.truncate(w)
    }
    /// Removes each element whose `key` equals the `key` of the one before it:
    /// `words.dedup_by_key(_.len())` keeps the first word of each run of equal
    /// lengths.
    pub fun dedup_by_key[K: Eq](mut self, key: T => K) {
        if self.len() < 2 { return }
        var w = 1
        for i in 1..self.len() {
            if key(self[i]) != key(self[w - 1]) {
                if w != i { self.swap(w, i) }
                w += 1
            }
        }
        self.truncate(w)
    }
    /// Removes each element that equals the one before it.
    pub fun dedup(mut self) where T: Eq {
        if self.len() < 2 { return }
        var w = 1
        for i in 1..self.len() {
            if self[i] != self[w - 1] {
                if w != i { self.swap(w, i) }
                w += 1
            }
        }
        self.truncate(w)
    }
    /// Takes out the element at `i` by moving the last one into its place:
    /// quick, but it changes the order. Unravels if `i >= len`.
    pub fun swap_remove(mut self, i: usize) -> T {
        assert(i < self.len(), "swap_remove: index out of bounds")
        self.swap(i, self.len() - 1)
        match self.pop() {
            some(x) => x
            none => unravel("swap_remove: empty")
        }
    }
    /// Grows with copies of `x`, or shrinks, to `n` elements.
    pub fun resize(mut self, n: usize, x: T) {
        if n < self.len() {
            self.truncate(n)
        } else if n > self.len() {
            var extra = List.filled(x, n - self.len())
            self.append(mut extra)
        }
    }
    /// Cuts the list at `at`: this keeps the first `at` elements, and the
    /// rest are returned. Unravels if `at > len`.
    pub fun split_off(mut self, at: usize) -> List[T] {
        assert(at <= self.len(), "split_off: index out of bounds")
        var tail: List[T] = List()
        while self.len() > at {
            match self.pop() {
                some(x) => tail.push(x)
                none => break
            }
        }
        tail.reverse()
        tail
    }
    /// Moves every element of `other` to the end of this list.
    pub fun append(mut self, mut other: List[T]) {
        other.reverse()
        while true {
            match other.pop() {
                some(x) => self.push(x)
                none => break
            }
        }
    }
    /// Takes out the elements in `from..to` and returns them. Unravels if
    /// the range is outside the list.
    pub fun drain(mut self, from: usize, to: usize) -> List[T] {
        assert(from <= to and to <= self.len(), "drain: range out of bounds")
        var tail = self.split_off(to)
        let taken = self.split_off(from)
        self.append(mut tail)
        taken
    }
}

weave[T] FromStream into List[T] {
    type Item = T
    fun from_stream(take items: Stream[T]) -> List[T] = items.collect()
}
