// Memory: spools (the places values are allocated in), sizes, and moving values
// around. `heap` is the global spool, where `^e` boxes a value. An `Arena`
// hands out memory by bumping a pointer and frees it all at once; a `Pool[T]`
// recycles slots of one type. A pointer into a spool can't outlive it: the
// region checker sees to that.
//
// ```loom
// use std.io.print
// use std.mem.Arena
//
// warp Tree {
//     case Leaf(i64)
//     case Node(^Tree, ^Tree)
// }
//
// fun sum(t: ^Tree) -> i64 = match t^ {
//     .Leaf(n) => n
//     .Node(l, r) => sum(l) + sum(r)
// }
//
// fun main() {
//     spool frame = Arena(4096)
//     // Each `put` is a bump of a pointer; the whole arena is freed at once.
//     let leaf = (n: i64) => frame.put(Tree.Leaf(n))
//     let t = frame.put(Tree.Node(leaf(1), frame.put(Tree.Node(leaf(2), leaf(3)))))
//     print("sum {sum(t)}")
// }
// ```

/// A region to allocate in. `heap` is the global one.
pub weft Spool {}

/// The global spool: each allocation is freed when its owner is dropped.
#builtin
pub warp Heap: Spool {}

/// A spool that allocates by bumping a pointer and frees everything at once.
#builtin
pub warp Arena: Spool {
    capacity: usize

    #spool_reset
    /// Frees everything allocated so far.
    pub fun reset(mut self)

    #spool_put
    /// Moves `value` into the arena and gives a pointer to it. The pointer
    /// is `Copy` and owns nothing: it lasts until the arena is reset or
    /// ends.
    pub fun put[T](self, take value: T) -> ^T@self
}

/// An `Arena` that threads may allocate in: its pointers can cross threads,
/// and allocating takes the VM's lock.
#builtin
pub warp SharedArena: Spool {
    #spool_reset
    /// Frees everything allocated so far.
    pub fun reset(mut self)

    #spool_put
    /// Moves `value` into the arena and gives a pointer to it.
    pub fun put[T](self, take value: T) -> ^T@self
}

/// A spool of `n` slots, each one `T`: allocating and freeing a slot is a
/// few instructions, and a freed slot is the next one given out. It holds
/// plain data (no text, lists or boxes), because dropping the pool does not
/// drop what is still in it.
#builtin
pub warp Pool[T]: Spool {
    #spool_put
    /// Moves `value` into a free slot and gives a pointer to it. The pool
    /// being full unravels.
    pub fun put(self, take value: T) -> ^T@self

    /// Gives the slot back. The pointer, and any copy of it, must not be used
    /// again.
    pub fun free(self, p: ^T@self)

    #spool_reset
    /// Frees every slot.
    pub fun reset(mut self)
}

/// `n` kibibytes, in bytes: `Arena(kib(64))`.
pub fun kib(n: usize) -> usize = n * 1024
/// `n` mebibytes, in bytes.
pub fun mib(n: usize) -> usize = n * 1024 * 1024

/// Exchanges the values of `a` and `b`.
#builtin
pub fun swap[T](mut a: T, mut b: T)

/// Puts `value` in `dest` and gives the value that was there.
#builtin
pub fun replace[T](mut dest: T, take value: T) -> T

/// Gives the value in `dest`, leaving its default behind.
pub fun take[T: Default](mut dest: T) -> T = replace(mut dest, T.default())
