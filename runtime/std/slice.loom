// Slices: views of contiguous elements.

use std.iter.Reversed

/// `[T]`: a view of contiguous `T`s, in an array or a list. Arrays and lists
/// have these methods too.
#builtin
pub warp Slice[T] {
    /// How many elements there are.
    pub fn len(self) -> usize
    pub fn is_empty(self) -> bool
    /// A copy of the element at `i`, or `none` past the end. (An element
    /// can't be moved out of a slice: it gives a value of its own, a deep
    /// copy for a type that isn't `Copy`.)
    pub fn get(self, i: usize) -> ?T
    /// A copy of the first element.
    pub fn first(self) -> ?T
    /// A copy of the last element.
    pub fn last(self) -> ?T
    /// Whether some element equals `x`.
    pub fn contains(self, x: T) -> bool where T: Eq
    /// The index of the first element equal to `x`.
    pub fn index_of(self, x: T) -> ?usize where T: Eq
    /// Copies `src` over the start of this slice. Unravels if `src` is longer.
    pub fn copy_from(mut self, src: [T])
    /// Sets every element to a copy of `x`.
    pub fn fill(mut self, x: T)
    pub fn swap(mut self, i: usize, j: usize)
    pub fn reverse(mut self)
    /// Sorts in order, keeping equal elements in the order they were in.
    pub fn sort(mut self) where T: Ord
    /// A new list with a copy of every element.
    pub fn to_list(self) -> List[T]
    /// A new list of `f` of each element. (`xs.indexed()` and the other
    /// methods of `Stream` work on slices too, lazily.)
    pub fn map[U](self, f: T => U) -> List[U]
    /// A new list with a copy of each element `f` says yes to.
    pub fn filter(self, f: T => bool) -> List[T]
    /// Views of `n` elements at a time, one after another; the last may be
    /// shorter. Unravels if `n` is 0.
    pub fn chunks(self, n: usize) -> Stream[[T]]
    #disjoint
    /// Views of `n` elements at a time, one after another, which can be
    /// changed (`line[i] = x`). They don't overlap, so in a `loom for` each
    /// thread may change its own piece. The last may be shorter. Unravels
    /// if `n` is 0.
    pub fn chunks_mut(mut self, n: usize) -> Stream[[T]]
    /// Views of every run of `n` elements in a row: `[a, b]`, `[b, c]`, …
    /// Unravels if `n` is 0.
    pub fn windows(self, n: usize) -> Stream[[T]]
    /// Whether the slice starts with `prefix`.
    pub fn starts_with(self, prefix: [T]) -> bool where T: Eq {
        if prefix.len() > self.len() { return false }
        for i in 0..prefix.len() {
            if self[i] != prefix[i] { return false }
        }
        true
    }
    /// The inner slices, one after another.
    pub fn concat[U](self) -> List[U] where T: [U] {
        let mut out = List()
        for i in 0..self.len() {
            let s = self[i]
            for j in 0..s.len() { out.push(s[j]) }
        }
        out
    }
    /// Whether the slice ends with `suffix`.
    pub fn ends_with(self, suffix: [T]) -> bool where T: Eq {
        if suffix.len() > self.len() { return false }
        let skip = self.len() - suffix.len()
        for i in 0..suffix.len() {
            if self[skip + i] != suffix[i] { return false }
        }
        true
    }
    /// How many elements equal `x`.
    pub fn count_of(self, x: T) -> usize where T: Eq {
        var n = 0
        for i in 0..self.len() {
            if self[i] == x { n += 1 }
        }
        n
    }
    /// Moves the elements `n` places towards the start; those pushed out
    /// come back at the end. `n` counts modulo the length.
    pub fn rotate_left(mut self, n: usize) {
        let len = self.len()
        if len < 2 { return }
        let k = n % len
        if k == 0 { return }
        self[..k].reverse()
        self[k..].reverse()
        self.reverse()
    }
    /// Moves the elements `n` places towards the end; those pushed out come
    /// back at the start. `n` counts modulo the length.
    pub fn rotate_right(mut self, n: usize) {
        let len = self.len()
        if len < 2 { return }
        self.rotate_left(len - n % len)
    }
    /// The elements from the last to the first.
    pub fn rev(self) -> Stream[T] {
        Reversed(items: self.to_list())
    }
    /// Sorts so that `less(a, b)` says whether `a` goes before `b`. Stable:
    /// elements neither goes before the other keep their order.
    pub fn sort_by(mut self, less: (T, T) => bool) {
        var order = sorted_order(self.len(), (i, j) => less(self[i], self[j]))
        apply_order(mut self, mut order)
    }
    /// Sorts by `key` of each element, which is computed once per element.
    /// Stable.
    pub fn sort_by_key[K: Ord](mut self, key: T => K) {
        let keys = self.map(key)
        var order = sorted_order(self.len(), (i, j) => keys[i] < keys[j])
        apply_order(mut self, mut order)
    }
    /// Whether every element is at or after the one before it.
    pub fn is_sorted(self) -> bool where T: Ord {
        for i in 1..self.len() {
            if self[i] < self[i - 1] { return false }
        }
        true
    }
    /// The index of the first element that is not before `x` in a sorted
    /// slice: where `x` would go.
    pub fn lower_bound(self, x: T) -> usize where T: Ord {
        self.partition_point(e => e < x)
    }
    /// The index of the first element after `x` in a sorted slice.
    pub fn upper_bound(self, x: T) -> usize where T: Ord {
        self.partition_point(e => not (x < e))
    }
    /// The index of an element equal to `x` in a sorted slice.
    pub fn binary_search(self, x: T) -> ?usize where T: Ord {
        let i = self.lower_bound(x)
        if i < self.len() and not (x < self[i]) { some(i) } else { none }
    }
    /// In a slice where `pred` says yes to a run of elements and then no to
    /// the rest, the index of the first no.
    pub fn partition_point(self, pred: T => bool) -> usize {
        var lo = 0
        var hi = self.len()
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if pred(self[mid]) { lo = mid + 1 } else { hi = mid }
        }
        lo
    }
}

const RUN: usize = 8

/// The indices `0..n` in an order that stably sorts them by `before`.
fn sorted_order(n: usize, before: (usize, usize) => bool) -> List[usize] {
    var a: List[usize] = List.filled(0, n)
    for i in 0..n { a[i] = i }
    var sorted = true
    for i in 1..n {
        if before(i, i - 1) {
            sorted = false
            break
        }
    }
    if sorted { return a }
    var lo = 0
    while lo < n {
        let hi = min(lo + RUN, n)
        for i in lo + 1..hi {
            let v = a[i]
            var j = i
            while j > lo and before(v, a[j - 1]) {
                a[j] = a[j - 1]
                j -= 1
            }
            a[j] = v
        }
        lo = hi
    }
    var b: List[usize] = List.filled(0, n)
    var width = RUN
    while width < n {
        var start = 0
        while start < n {
            let mid = min(start + width, n)
            let end = min(start + 2 * width, n)
            var i = start
            var j = mid
            var k = start
            while i < mid and j < end {
                if before(a[j], a[i]) {
                    b[k] = a[j]
                    j += 1
                } else {
                    b[k] = a[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                b[k] = a[i]
                i += 1
                k += 1
            }
            while j < end {
                b[k] = a[j]
                j += 1
                k += 1
            }
            start = end
        }
        a.copy_from(b)
        width *= 2
    }
    a
}

/// Puts `xs[order[k]]` at `k` for every `k`, by swaps.
fn apply_order[T](mut xs: [T], mut order: List[usize]) {
    for i in 0..order.len() {
        var cur = i
        while order[cur] != i {
            let next = order[cur]
            xs.swap(cur, next)
            order[cur] = cur
            cur = next
        }
        order[cur] = cur
    }
}
